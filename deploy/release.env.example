# 复制为 deploy/release.env 后填写（release.env 已 gitignore，勿提交）
#   cp deploy/release.env.example deploy/release.env

# ---------- SSH（不配则只本地构建，不上传）----------
# 例：root@192.168.1.10
SSH_HOST=
# 默认 22
SSH_PORT=22
# 私钥路径，空则用 ssh 默认配置 / ssh-agent
SSH_KEY=
# 额外 ssh 参数，如：-o StrictHostKeyChecking=accept-new
SSH_OPTS=

# ---------- 远程路径（与 deploy/README、systemd 约定一致）----------
# 与 zola 的 /opt/xingyue 不同目录，可共存于同一台服务器
REMOTE_ROOT=/opt/zoek
# 后端二进制在服务器上的文件名（WorkingDirectory 下的 ExecStart）
REMOTE_API_NAME=api
# systemd 服务名（与 zola 的 xingyue-api 不同名，可共存）；空则上传后不重启
REMOTE_API_SERVICE=zoek-api
# 后端监听端口（须与服务器上 /opt/zoek/config.yaml 的 server.port 一致）
# zola 已占用 8080/8089，zoek 默认用 8090
REMOTE_API_PORT=8090
# 完整健康检查 URL（默认 http://127.0.0.1:${REMOTE_API_PORT}/health）
# REMOTE_API_HEALTH_URL=http://127.0.0.1:8090/health
# 上传后是否 reload caddy（1=是 0=否）
# 站点配置在服务器 /etc/caddy/conf.d/zoek.caddy，主 Caddyfile 仅 import
REMOTE_RELOAD_CADDY=0
# 上传本地 backend/config.yaml 覆盖服务器配置（1=是 0=否；注意本地是开发配置）
UPLOAD_CONFIG=0

# ---------- 构建 ----------
# linux amd64 | arm64
BACKEND_ARCH=amd64
