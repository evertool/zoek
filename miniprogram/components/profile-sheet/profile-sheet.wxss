/* components/profile-sheet/profile-sheet.wxss */
.ps-mask { position: fixed; inset: 0; background: rgba(15, 23, 20, 0.55); z-index: 999; opacity: 0; transition: opacity 0.25s ease; display: flex; align-items: flex-end; }
.ps-mask.ps-on { opacity: 1; }

.ps-sheet { width: 100%; background: #fffdf6; border-radius: 32rpx 32rpx 0 0; padding: 16rpx 40rpx calc(40rpx + env(safe-area-inset-bottom)); box-shadow: 0 -12rpx 40rpx rgba(0, 0, 0, 0.18); animation: psRise 0.3s ease-out; }
@keyframes psRise { from { transform: translateY(40%); } to { transform: translateY(0); } }

.ps-grab { width: 72rpx; height: 8rpx; border-radius: 999rpx; background: #e2ddcf; margin: 0 auto 20rpx; }

.ps-head { display: flex; align-items: center; justify-content: space-between; }
.ps-title { font-size: 36rpx; font-weight: 800; color: #26322c; }
.ps-close { width: 52rpx; height: 52rpx; border-radius: 50%; background: #f1ede1; color: #6b7a72; font-size: 26rpx; display: flex; align-items: center; justify-content: center; }

.ps-sub { margin-top: 8rpx; font-size: 24rpx; color: #8a968f; }

.ps-avatar-wrap { display: flex; justify-content: center; align-items: center; width: 100%; text-align: center; margin: 36rpx 0 28rpx; }
/* 与个人中心编辑头像同款：144rpx 正方形 + 32rpx 圆角，真机渲染正常 */
.ps-avatar-btn { display: block; width: 144rpx; height: 144rpx; min-width: 0; max-width: 144rpx; border-radius: 32rpx; padding: 0; margin: 0; background: transparent; border: none; overflow: hidden; line-height: 1; box-sizing: border-box; flex: 0 0 auto; }
.ps-avatar-btn::after { border: none; transform: scale(1); }
.ps-avatar-img { display: block; width: 144rpx; height: 144rpx; margin: 0 auto; border-radius: 32rpx; border: 5rpx solid rgba(52, 150, 102, 0.3); box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08); box-sizing: border-box; background: #fff; }
.ps-avatar-empty { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 2rpx; width: 144rpx; height: 144rpx; margin: 0 auto; border-radius: 32rpx; border: 5rpx solid rgba(52, 150, 102, 0.3); box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08); box-sizing: border-box; background: #fff; }
.ps-avatar-plus { font-size: 48rpx; color: #14603e; font-weight: 700; line-height: 1; }
.ps-avatar-hint { font-size: 20rpx; color: #8a968f; }

.ps-input { display: block; width: 240rpx; margin: 0 auto; height: 92rpx; border-radius: 20rpx; background: #ffffff; border: 2rpx solid #e7e0cc; padding: 0 20rpx; font-size: 30rpx; color: #26322c; text-align: center; box-sizing: border-box; }
.ps-input-ph { color: #b8b2a0; }

.ps-save { margin-top: 32rpx; height: 92rpx; border-radius: 999rpx; background: #1b6b4a; color: #ffffff; font-size: 32rpx; font-weight: 700; display: flex; align-items: center; justify-content: center; }
.ps-save::after { border: none; }
.ps-save-disabled { opacity: 0.45; }

.ps-later { margin-top: 20rpx; height: 88rpx; border-radius: 999rpx; background: transparent; color: #8a968f; font-size: 28rpx; display: flex; align-items: center; justify-content: center; }
.ps-later::after { border: none; }

.ps-foot { margin-top: 16rpx; text-align: center; font-size: 20rpx; color: #b0aa97; }
