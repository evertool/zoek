/* pages/adjustment/adjustment.wxss */
.type-selector {
  display: flex;
  gap: 16rpx;
}

.type-item {
  flex: 1;
  border: 2rpx solid var(--color-border);
  border-radius: var(--radius-md);
  padding: 20rpx;
  text-align: center;
  font-size: 26rpx;
  color: var(--color-text-secondary);
}

.type-item.active {
  border-color: var(--color-accent);
  background: #FFFCF5;
  color: var(--color-accent);
  font-weight: 600;
}

.player-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.player-item {
  display: flex;
  align-items: center;
  gap: 12rpx;
  border: 2rpx solid var(--color-border);
  border-radius: var(--radius-md);
  padding: 12rpx 20rpx;
}

.player-item.selected {
  border-color: var(--color-accent);
  background: #FFFCF5;
}

.player-avatar-text {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 600;
  color: #FFFFFF;
  background: var(--color-accent);
}

.player-name {
  font-size: 28rpx;
}
