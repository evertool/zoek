/* pages/adjustment/adjustment.wxss — 补分/退分页 v4 白底卡通版
 * 补分红 / 退分绿对称选择块 + 麻将牌选择块
 */

.page {
  padding: 32rpx;
  padding-top: 0;
  min-height: 100vh;
  box-sizing: border-box;
}

/* ===== 类型选择：对称两大块 ===== */
.type-selector {
  display: flex;
  gap: 20rpx;
}

.type-item {
  flex: 1;
  border: 3rpx solid var(--color-border);
  border-radius: 24rpx;
  padding: 28rpx 24rpx;
  text-align: center;
  background: var(--color-card-warm);
  transition: all 0.2s ease;
}

.type-item.active.type-supplement {
  border-color: var(--color-red);
  background: var(--color-red-soft);
}

.type-item.active.type-refund {
  border-color: var(--color-green);
  background: var(--color-green-light);
}

.type-tile {
  width: 72rpx;
  height: 94rpx;
  font-size: 36rpx;
  margin: 0 auto 16rpx;
}

.type-label {
  font-size: 32rpx;
  font-weight: 800;
  margin-bottom: 6rpx;
  color: var(--color-text);
}

.type-item.active.type-supplement .type-label {
  color: var(--color-red);
}

.type-item.active.type-refund .type-label {
  color: var(--color-green);
}

.type-desc {
  font-size: 22rpx;
  color: var(--color-text-secondary);
}

/* ===== 选择雀友 ===== */
.player-list {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.player-pick {
  display: flex;
  align-items: center;
  border: 3rpx solid var(--color-border);
  border-radius: 48rpx;
  padding: 12rpx 28rpx 12rpx 14rpx;
  background: var(--color-card-warm);
  transition: all 0.2s ease;
}

.player-pick.selected {
  border-color: var(--color-green);
  background: var(--color-green-light);
}

.player-avatar {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: var(--color-green);
  color: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 600;
  margin-right: 14rpx;
}

.player-name {
  font-size: 26rpx;
}

.pick-check {
  margin-left: 12rpx;
  width: 34rpx;
  height: 34rpx;
  border-radius: 50%;
  background: var(--color-green);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
}
.pick-check image { width: 22rpx; height: 22rpx; }

/* ===== 分数和原因 ===== */
.score-input {
  border: 3rpx solid var(--color-red);
  border-radius: 24rpx;
  padding: 30rpx;
  font-size: 48rpx;
  font-weight: 800;
  text-align: center;
  background: var(--color-card-warm);
  width: 100%;
  box-sizing: border-box;
  color: var(--color-red);
}

.reason-title {
  margin-top: 36rpx;
}

.text-input {
  border: 2rpx solid var(--color-border);
  border-radius: 20rpx;
  padding: 24rpx;
  font-size: 28rpx;
  background: var(--color-card-warm);
  width: 100%;
  box-sizing: border-box;
}

.input-placeholder {
  color: var(--color-text-tertiary);
}

/* ===== 底部操作 ===== */
.action-bar {
  padding: 32rpx 0 12rpx;
}
