<!--pages/leaderboard/leaderboard.wxml — 雀友榜（queyou-mingxi 设计稿还原）-->
<view class="page">
  <!-- 未登录 -->
  <view class="empty-state" style="padding-top: {{navPadding}}px;" wx:if="{{!isLoggedIn}}">
    <view class="empty-tile mj-tile mj-tile-gold anim-float">榜</view>
    <view class="empty-text">未登入</view>
    <view class="text-secondary" style="margin-top: 8rpx;">登入后睇雀友榜同自己嘅战绩</view>
    <button class="btn-primary login-btn anim-fade-up delay-2" bindtap="doLogin">微信登入</button>
  </view>

  <block wx:if="{{isLoggedIn}}">
    <view class="main-content" style="padding-top: {{navPadding}}px;">

      <!-- 标题区 -->
      <view class="lb-head anim-fade-up">
        <view class="lb-title-row">
          <text class="lb-title">雀友榜</text>
        </view>
        <text class="lb-subtitle">{{days === 0 ? '全部' : '近' + days + '日'}}雀叙 · 同台切磋</text>
      </view>

      <!-- 周期时间切片 -->
      <view class="lb-period-bar anim-fade-up delay-1">
        <view class="lb-period-tabs">
          <view class="lb-period-tab {{currentPeriod === 30 ? 'active' : ''}}" bindtap="switchPeriod" data-period="30">
            <text>近 30 天</text>
            <view class="lb-period-dot" wx:if="{{currentPeriod === 30}}"></view>
          </view>
          <view class="lb-period-tab {{currentPeriod === 7 ? 'active' : ''}}" bindtap="switchPeriod" data-period="7">
            <text>近 7 天</text>
            <view class="lb-period-dot" wx:if="{{currentPeriod === 7}}"></view>
          </view>
          <view class="lb-period-tab {{currentPeriod === 0 ? 'active' : ''}}" bindtap="switchPeriod" data-period="0">
            <text>全部</text>
            <view class="lb-period-dot" wx:if="{{currentPeriod === 0}}"></view>
          </view>
        </view>
      </view>

      <!-- 上榜准则说明 -->
      <view class="lb-rules anim-fade-up delay-1">
        <view class="lb-rules-left">
          <image class="lb-rules-icon" src="/assets/icons/sys-info-circle.svg" mode="aspectFit" />
          <text>同台切磋 1 场就可以上榜</text>
        </view>
        <text class="lb-rules-right">纯积分统计 · 不涉及金钱</text>
      </view>

      <!-- 榜单模式筛选：挪到「雀友排名」标题旁，checkbox 式按钮（单选） -->

      <!-- 核心卡片：我的战绩 -->
      <view class="my-card anim-fade-up delay-2" wx:if="{{stats}}">
        <view class="my-card-glow"></view>
        <view class="my-card-head">
          <view class="my-card-user">
            <view class="my-avatar-wrap">
              <image class="my-avatar" src="{{avatarURL}}" mode="aspectFill" wx:if="{{avatarURL}}" />
              <view class="my-avatar my-avatar-ph" wx:else><text>{{nickname[0]}}</text></view>
              <view class="my-avatar-badge"><text>#{{stats.my_rank || 0}}</text></view>
            </view>
            <view class="my-info">
              <view class="my-name-row">
                <text class="my-name">{{nickname}}</text>
                <view class="tier-chip tier-chip-self" wx:if="{{stats.tier_short}}"><text>{{stats.tier_short}} {{stats.stars || 0}}★</text></view>
              </view>
              <text class="my-sub">{{stats.active_text || '本周期活跃 · 雀艺渐入佳境'}}</text>
            </view>
          </view>
          <view class="my-score-col">
            <text class="my-score-label">净胜分</text>
            <text class="my-score-val">{{stats.total_score >= 0 ? '+' : ''}}{{stats.total_score}}</text>
          </view>
        </view>

        <!-- 四维核心数据矩阵 -->
        <view class="my-stats">
          <view class="my-stat">
            <text class="my-stat-label">场次</text>
            <text class="my-stat-val">{{stats.games}}</text>
          </view>
          <view class="my-stat">
            <text class="my-stat-label">胜场 (胜率)</text>
            <view class="my-stat-inline">
              <text class="my-stat-val text-positive">{{stats.wins}}</text>
              <text class="my-stat-sub">{{stats.win_rate}}%</text>
            </view>
          </view>
          <view class="my-stat">
            <text class="my-stat-label">连胜</text>
            <text class="my-stat-val">{{stats.best_streak || 0}}</text>
          </view>
          <view class="my-stat">
            <text class="my-stat-label">单场最高</text>
            <text class="my-stat-val {{stats.best_score >= 0 ? 'text-positive' : 'text-negative'}}">{{stats.best_score >= 0 ? '+' : ''}}{{stats.best_score}}</text>
          </view>
        </view>

        <!-- 个人勋章（有数据才显示） -->
        <view class="my-badges" wx:if="{{stats.badges && stats.badges.length > 0}}">
          <view class="my-badge-pill" wx:for="{{stats.badges}}" wx:key="id">
            <text class="my-badge-icon">{{item.icon}}</text>
            <text class="my-badge-text">{{item.name}}</text>
          </view>
        </view>
      </view>

      <!-- 雀友排名列表 -->
      <view class="rank-section anim-fade-up delay-3">
        <view class="rank-head">
          <!-- 榜单分段器：选了哪个就是哪份排名，不再另起「雀友排名」标题 -->
          <view class="lb-period-tabs rank-board-seg">
            <view class="lb-period-tab {{boardTab === 'score' ? 'active' : ''}}" bindtap="switchBoard" data-tab="score">
              <text>积分榜</text>
              <view class="lb-period-dot" wx:if="{{boardTab === 'score'}}"></view>
            </view>
            <view class="lb-period-tab {{boardTab === 'rank' ? 'active' : ''}}" bindtap="switchBoard" data-tab="rank">
              <text>段位榜</text>
              <view class="lb-period-dot" wx:if="{{boardTab === 'rank'}}"></view>
            </view>
          </view>
          <!-- <view class="rank-head-right">
            <view class="rank-live-dot anim-ping"></view>
            <text>实时自动结算更新</text>
          </view> -->
        </view>

        <view class="rank-item {{item.is_self ? 'rank-item-self' : ''}} {{item.displayRank === 1 ? 'rank-item-top' : ''}}" wx:for="{{entries}}" wx:key="user_id">
          <view class="rank-item-main">
            <!-- 名次 -->
            <view class="rank-num">
              <image class="rank-crown" src="/assets/icons/rank-1-god-crown.svg" mode="aspectFit" wx:if="{{item.displayRank === 1}}" />
              <text class="rank-num-text rank-num-text-{{item.displayRank <= 3 ? item.displayRank : 'rest'}}" wx:else>{{item.displayRank}}</text>
            </view>

            <!-- 头像 -->
            <image class="rank-avatar" src="{{item.avatar_url}}" mode="aspectFill" wx:if="{{item.avatar_url}}" />
            <view class="rank-avatar rank-avatar-ph" style="background:{{item.avatarColor}};" wx:else><text>{{item.nickname[0]}}</text></view>

            <!-- 数据 -->
            <view class="rank-info">
              <view class="rank-name-row">
                <text class="rank-name">{{item.nickname}}</text>
                <view class="tier-chip {{item.displayRank === 1 ? 'tier-chip-gold' : ''}}" wx:if="{{item.tier_short}}"><text>{{item.tier_short}} {{item.stars || 0}}★</text></view>
              </view>
              <text class="rank-line">{{item.games}} 场 · {{item.wins}} 胜 · {{item.draws || 0}} 平</text>
              <text class="rank-line rank-line-sub">连胜 {{item.best_streak || 0}} · 单场最高 {{item.best_score || 0}}</text>
            </view>

            <!-- 分数与互动 -->
            <view class="rank-right">
              <text class="rank-score {{item.total_score >= 0 ? 'text-positive' : 'text-negative'}}">{{item.total_score >= 0 ? '+' : ''}}{{item.total_score}}</text>
              <!-- 已在位：当前已在 forming/active 牌局落座；否则可约台 -->
              <view class="rank-in-game" wx:if="{{item.in_game}}"><text>已在位</text></view>
              <view class="rank-action" wx:else>
                <image class="rank-action-icon" src="/assets/icons/share-wechat.svg" mode="aspectFit" />
                <text class="rank-action-text">可约台</text>
                <button class="rank-action-hit" open-type="share" bindtap="onInviteTap"></button>
              </view>
            </view>
          </view>

          <!-- 规则标签（有数据才显示） -->
          <view class="rank-tags" wx:if="{{item.tags && item.tags.length > 0}}">
            <text class="rank-tag" wx:for="{{item.tags}}" wx:for-item="tag" wx:key="*this">{{tag}}</text>
          </view>
        </view>

        <!-- 到底提示 -->
        <view class="lb-end" wx:if="{{entries.length > 0}}">
          <view class="lb-end-line"></view>
          <view class="lb-end-center">
            <image class="lb-end-icon" src="/assets/icons/status-check-success.svg" mode="aspectFit" />
            <text>已载入全部 {{entries.length}} 位雀友 · 到底了</text>
          </view>
          <view class="lb-end-line"></view>
        </view>

        <view class="empty-state" wx:if="{{entries.length === 0}}" style="padding: 80rpx 40rpx;">
          <view class="empty-tile mj-tile mj-tile-gold anim-float">空</view>
          <view class="empty-text">近{{days}}天仲未开过台</view>
          <view class="text-secondary" style="margin-top: 8rpx;">同雀友打完一场就会上榜</view>
        </view>
      </view>

      <!-- 文化与温情落款 -->
      <view class="lb-footer">
        <text class="lb-footer-text">以雀会友 · 排位论高下</text>
      </view>
    </view>
  </block>

  <!-- Toast -->
  <view class="toast {{showToast ? 'toast-show' : ''}}">
    <image class="toast-icon" src="/assets/icons/status-check-success.svg" mode="aspectFit" />
    <text>{{toastMsg}}</text>
  </view>
</view>
