/* pages/leaderboard/leaderboard.wxss — 雀友榜（queyou-mingxi 设计稿还原） */
.page { min-height: 100vh; background: var(--background); padding-bottom: 160rpx; }
.main-content { display: flex; flex-direction: column; gap: var(--space-sm); }

/* ========== 标题区 ========== */
.lb-head { padding: 0 var(--margin-screen); display: flex; flex-direction: column; gap: 4rpx; margin-top: var(--space-xs); }
.lb-title-row { display: flex; align-items: center; gap: 12rpx; }
.lb-title { font-size: 48rpx; font-weight: 600; color: var(--on-surface); letter-spacing: -1rpx; }
.lb-subtitle { font-size: 24rpx; color: var(--on-surface-variant); }

/* ========== 周期时间切片 ========== */
.lb-period-bar { padding: 0 var(--margin-screen); }
.lb-period-tabs { display: flex; align-items: center; gap: 8rpx; background: var(--surface-container-low); padding: 8rpx; border-radius: var(--radius-xl); }
.lb-period-tab { flex: 1; padding: 20rpx 0; border-radius: var(--radius-lg); display: flex; align-items: center; justify-content: center; gap: 8rpx; font-size: 24rpx; font-weight: 500; color: var(--on-surface-variant); transition: all 0.2s ease; }
.lb-period-tab.active { background: var(--primary); color: var(--on-primary); box-shadow: var(--shadow-card); }
.lb-period-dot { width: 12rpx; height: 12rpx; border-radius: 50%; background: var(--secondary-container); }

/* ========== 上榜准则说明 ========== */
.lb-rules { display: flex; align-items: center; justify-content: space-between; padding: 0 var(--margin-screen); }
.lb-rules-left { display: flex; align-items: center; gap: 8rpx; font-size: 20rpx; color: var(--on-surface-variant); }
.lb-rules-icon { width: 26rpx; height: 26rpx; }
.lb-rules-right { font-size: 20rpx; color: var(--outline); letter-spacing: 0.5rpx; }

/* ========== 榜单分段器 ==========
 * 结构复用顶部「近30天/近7天/全部」那套分段（.lb-period-tabs/.lb-period-tab），
 * 但这一颗要更紧凑、方一点：覆盖容器圆角/内边距与分段字号/高度，
 * 选中填主色、小圆点这些仍沿用同一套，两颗分段器语义上永远一致。 */
.rank-board-seg { min-width: 0; margin: 0; padding: 4rpx; border-radius: 16rpx; }
/* 不再 flex:1 撑满整行：让分段器按内容收窄，靠左放 */
.rank-board-seg .lb-period-tab { flex: 0 0 auto; padding: 12rpx 36rpx; font-size: 22rpx; border-radius: 12rpx; }
.rank-board-seg .lb-period-dot { width: 8rpx; height: 8rpx; }

/* ========== 我的战绩卡 ========== */
.my-card { position: relative; overflow: hidden; border-radius: var(--radius-lg); background: var(--surface-container-lowest); padding: var(--space-md); box-shadow: var(--shadow-card); margin: 0 var(--margin-screen); }
.my-card-glow { position: absolute; right: -48rpx; bottom: -48rpx; width: 224rpx; height: 224rpx; border-radius: 50%; background: rgba(166, 243, 201, 0.2); filter: blur(40rpx); pointer-events: none; }
.my-card-head { display: flex; align-items: center; justify-content: space-between; gap: var(--space-sm); position: relative; padding-bottom: var(--space-xs); }
.my-card-user { display: flex; align-items: center; gap: var(--space-sm); min-width: 0; flex: 1; }
.my-avatar-wrap { position: relative; flex-shrink: 0; }
.my-avatar { width: 96rpx; height: 96rpx; border-radius: 50%; box-shadow: var(--shadow-card); border: 4rpx solid var(--primary-fixed); box-sizing: border-box; }
.my-avatar-ph { display: flex; align-items: center; justify-content: center; font-size: 36rpx; font-weight: 600; color: var(--on-primary); background: var(--primary-container); }
.my-avatar-badge { position: absolute; bottom: -4rpx; right: -4rpx; padding: 2rpx 14rpx; border-radius: var(--radius-full); background: var(--surface-container-highest); color: var(--primary); font-size: 20rpx; font-weight: 700; box-shadow: var(--shadow-card); }
.my-info { display: flex; flex-direction: column; gap: 6rpx; min-width: 0; }
.my-name-row { display: flex; align-items: center; gap: 10rpx; }
.my-name { font-size: 36rpx; font-weight: 600; color: var(--on-surface); }
.my-sub { font-size: 24rpx; color: var(--on-surface-variant); }
.my-score-col { text-align: right; flex-shrink: 0; }
.my-score-label { font-size: 20rpx; color: var(--on-surface-variant); display: block; }
.my-score-val { font-size: 56rpx; font-weight: 700; color: var(--primary); letter-spacing: -1rpx; line-height: 1.15; }

/* 段位 chip */
.tier-chip { display: inline-flex; align-items: center; padding: 2rpx 12rpx; border-radius: var(--radius-sm); font-size: 20rpx; font-weight: 600; background: rgba(166, 243, 201, 0.6); color: var(--primary); white-space: nowrap; flex-shrink: 0; }
.tier-chip-self { background: var(--primary-fixed); color: var(--on-primary-fixed-variant); }
.tier-chip-gold { background: rgba(255, 220, 195, 0.5); color: var(--secondary); }

/* 四维数据矩阵 */
.my-stats { display: grid; grid-template-columns: repeat(4, 1fr); gap: 12rpx; padding: 20rpx 8rpx; background: var(--surface-container-low); border-radius: var(--radius-xl); text-align: center; position: relative; margin-top: var(--space-xs); }
.my-stat { display: flex; flex-direction: column; align-items: center; gap: 4rpx; }
.my-stat-label { font-size: 20rpx; color: var(--on-surface-variant); }
.my-stat-val { font-size: 36rpx; font-weight: 700; color: var(--on-surface); line-height: 1.2; }
.my-stat-inline { display: flex; align-items: baseline; gap: 4rpx; }
.my-stat-sub { font-size: 20rpx; font-weight: 500; color: var(--on-surface-variant); }
.text-positive { color: var(--primary); }

/* 个人勋章 */
.my-badges { display: flex; align-items: center; gap: 8rpx; padding-top: var(--space-xs); overflow-x: auto; white-space: nowrap; }
.my-badge-pill { display: flex; align-items: center; gap: 8rpx; padding: 6rpx 16rpx; border-radius: var(--radius-full); background: rgba(255, 220, 195, 0.5); color: var(--on-secondary-fixed); font-size: 20rpx; flex-shrink: 0; }
.my-badge-icon { font-size: 24rpx; }
.my-badge-text { font-size: 20rpx; }

/* ========== 雀友排名列表 ========== */
.rank-section { padding: 0 var(--margin-screen); display: flex; flex-direction: column; gap: var(--space-xs); }
.rank-head { display: flex; align-items: center; justify-content: space-between; padding: 0 8rpx; }
.rank-head-right { display: flex; align-items: center; gap: 8rpx; font-size: 20rpx; color: var(--on-surface-variant); flex-shrink: 0; white-space: nowrap; }
.rank-live-dot { width: 12rpx; height: 12rpx; border-radius: 50%; background: var(--primary); }

.rank-item { background: var(--surface-container-lowest); padding: var(--space-md); border-radius: var(--radius-lg); box-shadow: var(--shadow-card); display: flex; flex-direction: column; gap: 12rpx; position: relative; overflow: hidden; }
.rank-item-main { display: flex; align-items: center; gap: var(--space-sm); }
.rank-item-top { background: linear-gradient(90deg, var(--surface-container-lowest) 0%, rgba(255, 220, 195, 0.1) 50%, var(--surface-container-lowest) 100%); box-shadow: 0 4rpx 24rpx rgba(254, 147, 44, 0.12); }
.rank-item-self { background: rgba(166, 243, 201, 0.2); }

.rank-num { width: 48rpx; flex-shrink: 0; display: flex; align-items: center; justify-content: center; }
.rank-crown { width: 52rpx; height: 52rpx; }
.rank-num-text { font-size: 40rpx; font-weight: 700; line-height: 1; }
.rank-num-text-1 { color: var(--secondary); }
.rank-num-text-2 { color: var(--outline); }
.rank-num-text-3 { color: var(--tertiary); }
.rank-num-text-rest { color: var(--outline-variant); }

.rank-avatar { width: 88rpx; height: 88rpx; border-radius: 50%; box-shadow: var(--shadow-card); flex-shrink: 0; }
.rank-avatar-ph { display: flex; align-items: center; justify-content: center; font-size: 32rpx; font-weight: 600; color: var(--on-primary); }

.rank-info { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 2rpx; }
.rank-name-row { display: flex; align-items: center; gap: 10rpx; min-width: 0; }
.rank-name { font-size: 36rpx; font-weight: 600; color: var(--on-surface); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.rank-line { font-size: 24rpx; color: var(--on-surface-variant); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.rank-line-sub { font-size: 20rpx; color: rgba(63, 73, 67, 0.7); }

.rank-right { flex-shrink: 0; display: flex; flex-direction: column; align-items: flex-end; gap: 10rpx; }
.rank-score { font-size: 48rpx; font-weight: 700; line-height: 1.05; letter-spacing: -1rpx; }
.rank-action { position: relative; display: flex; align-items: center; gap: 6rpx; background: var(--primary); color: var(--on-primary); padding: 8rpx 24rpx; border-radius: var(--radius-full); font-size: 20rpx; font-weight: 500; box-shadow: var(--shadow-card); overflow: hidden; }
.rank-action-icon { width: 26rpx; height: 26rpx; }
.rank-action-text { font-size: 20rpx; }
.rank-action-hit { position: absolute; top: 0; left: 0; width: 100%; height: 100%; opacity: 0; margin: 0; padding: 0; border: none; background: transparent; }
.rank-action-hit::after { border: none; }
.rank-in-game { padding: 8rpx 24rpx; border-radius: var(--radius-full); background: var(--surface-container-lowest); color: var(--primary-container); font-size: 20rpx; font-weight: 500; box-shadow: var(--shadow-card); }

/* 榜单条目规则标签（有数据才渲染） */
.rank-tags { display: flex; flex-wrap: wrap; gap: 8rpx; }
.rank-tag { padding: 2rpx 14rpx; border-radius: var(--radius-full); background: var(--surface-container-high); color: var(--on-surface-variant); font-size: 18rpx; white-space: nowrap; }

/* 到底提示 */
.lb-end { display: flex; align-items: center; justify-content: center; gap: 16rpx; padding: 24rpx 0 8rpx; }
.lb-end-line { height: 2rpx; width: 48rpx; background: rgba(191, 201, 192, 0.4); flex-shrink: 0; }
.lb-end-center { display: flex; align-items: center; gap: 8rpx; font-size: 20rpx; font-weight: 500; color: rgba(63, 73, 67, 0.5); }
.lb-end-icon { width: 24rpx; height: 24rpx; opacity: 0.7; }

/* ========== 落款 ========== */
.lb-footer { display: flex; align-items: center; justify-content: center; gap: 8rpx; padding: var(--space-sm) 0 var(--space-lg); }
.lb-footer-text { font-size: 24rpx; color: rgba(63, 73, 67, 0.6); letter-spacing: 1rpx; }

/* ========== Toast ========== */
.toast { position: fixed; top: 128rpx; left: 50%; transform: translateX(-50%); z-index: 200; padding: 16rpx 32rpx; border-radius: var(--radius-full); background: rgba(33, 49, 69, 0.9); color: var(--inverse-on-surface); font-size: 24rpx; box-shadow: var(--shadow-modal); opacity: 0; transition: opacity 0.3s ease; pointer-events: none; display: flex; align-items: center; gap: 8rpx; }
.toast.toast-show { opacity: 1; }
.toast-icon { width: 28rpx; height: 28rpx; }

/* ========== 未登录 ========== */
.login-btn { width: 100%; }
.empty-tile { display: flex; width: 160rpx; height: 160rpx; font-size: 72rpx; margin: 0 auto 32rpx; }
.anim-float { animation: floatY 3s ease-in-out infinite; }
@keyframes floatY { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-16rpx); } }
@keyframes ping { 0% { transform: scale(1); opacity: 0.9; } 75%, 100% { transform: scale(2.2); opacity: 0; } }
.anim-ping { animation: ping 1.6s cubic-bezier(0, 0, 0.2, 1) infinite; }
