/* pages/leaderboard/leaderboard.wxss — 雀友榜 v6 Stitch 100% 还原 */
.page { min-height: 100vh; background: var(--background); padding-bottom: 160rpx; }
.main-content { display: flex; flex-direction: column; gap: var(--space-md); }

/* 标题区 */
.lb-title-section { padding: 0 var(--margin-screen); }
.lb-title-row { display: flex; align-items: baseline; justify-content: space-between; }
.lb-title-left { display: flex; align-items: baseline; gap: 16rpx; }
.lb-title { font-size: 48rpx; font-weight: 600; color: var(--primary); letter-spacing: -1rpx; }
.lb-subtitle { font-size: 24rpx; color: var(--on-surface-variant); }
.lb-eco-tag { display: flex; align-items: center; gap: 8rpx; background: rgba(166, 243, 201, 0.4); padding: 8rpx 16rpx; border-radius: var(--radius-full); }
.lb-eco-icon { width: 28rpx; height: 28rpx; }
.lb-eco-text { font-size: 20rpx; color: var(--primary); font-weight: 500; }

/* 时间段切换 */
.lb-period-bar { padding: 0 var(--margin-screen); }
.lb-period-tabs { display: flex; gap: 8rpx; background: var(--surface-container-low); padding: 8rpx; border-radius: var(--radius-md); }
.lb-period-tab { flex: 1; padding: 24rpx 0; border-radius: var(--radius-default); display: flex; align-items: center; justify-content: center; gap: 8rpx; font-size: 24rpx; color: var(--on-surface-variant); }
.lb-period-tab.active { background: var(--primary); color: var(--on-primary); box-shadow: var(--shadow-card); }
.lb-period-dot { width: 12rpx; height: 12rpx; border-radius: 50%; background: var(--secondary-container); }
.lb-period-footer { display: flex; align-items: center; justify-content: space-between; margin-top: 16rpx; padding: 0 8rpx; }
.lb-period-info { display: flex; align-items: center; gap: 8rpx; }
.lb-info-text { font-size: 20rpx; color: var(--on-surface-variant); }
.lb-disclaimer { font-size: 20rpx; color: var(--outline); }

/* 我的排名卡 */
.my-rank-card { position: relative; overflow: hidden; border-radius: var(--radius-lg); background: var(--surface-container-lowest); padding: var(--space-md); box-shadow: var(--shadow-card); margin: 0 var(--margin-screen); }
.my-rank-glow { position: absolute; right: -48rpx; bottom: -48rpx; width: 224rpx; height: 224rpx; border-radius: 50%; background: rgba(166, 243, 201, 0.2); filter: blur(40rpx); pointer-events: none; }
.my-rank-header { display: flex; align-items: center; justify-content: space-between; padding-bottom: var(--space-xs); margin-bottom: var(--space-xs); position: relative; }
.my-rank-user { display: flex; align-items: center; gap: var(--space-sm); }
.my-rank-avatar-wrap { position: relative; }
.my-rank-avatar { width: 96rpx; height: 96rpx; border-radius: 50%; box-shadow: var(--shadow-card); }
.my-rank-placeholder { display: flex; align-items: center; justify-content: center; font-size: 36rpx; font-weight: 600; color: var(--on-primary); }
.my-rank-badge { position: absolute; bottom: -4rpx; right: -4rpx; padding: 4rpx 12rpx; border-radius: var(--radius-full); background: var(--surface-container-high); color: var(--on-surface); font-size: 20rpx; font-weight: 700; box-shadow: var(--shadow-card); }
.my-rank-info { display: flex; flex-direction: column; gap: 8rpx; }
.my-rank-name { font-size: 36rpx; font-weight: 600; color: var(--on-surface); }
.my-rank-sub { font-size: 24rpx; color: var(--on-surface-variant); }
.my-rank-score-col { text-align: right; }
.my-rank-score-label { font-size: 20rpx; color: var(--on-surface-variant); display: block; }
.my-rank-score-val { font-size: 44rpx; font-weight: 700; color: var(--primary); }
.my-rank-stats { display: grid; grid-template-columns: repeat(4, 1fr); gap: var(--space-xs); padding: var(--space-xs) 0; background: rgba(239, 244, 255, 0.7); border-radius: var(--radius-default); text-align: center; margin: 8rpx 0; }
.my-rank-stat { display: flex; flex-direction: column; }
.my-stat-label { font-size: 20rpx; color: var(--on-surface-variant); }
.my-stat-val { font-size: 32rpx; font-weight: 600; color: var(--on-surface); margin-top: 4rpx; }
.my-stat-sub { font-size: 20rpx; color: var(--primary); font-weight: 400; }
.text-primary { color: var(--primary); }
.my-rank-badges { display: flex; align-items: center; gap: 8rpx; padding-top: var(--space-xs); overflow-x: auto; white-space: nowrap; }
.my-badge-label { font-size: 22rpx; color: var(--on-surface-variant); flex-shrink: 0; }
.my-badge-pill { display: flex; align-items: center; gap: 8rpx; padding: 8rpx 16rpx; border-radius: var(--radius-full); background: rgba(255, 220, 195, 0.5); color: var(--on-secondary-fixed); flex-shrink: 0; }
.my-badge-icon { font-size: 26rpx; }
.my-badge-text { font-size: 22rpx; }

/* 排名列表 */
.rank-list-section { padding: 0 var(--margin-screen); display: flex; flex-direction: column; gap: var(--space-xs); }
.rank-list-header { display: flex; align-items: center; justify-content: space-between; padding: 0 8rpx; margin-bottom: 8rpx; }
.rank-list-title { font-size: 28rpx; font-weight: 600; color: var(--on-surface); }
.rank-list-sub { font-size: 20rpx; color: var(--outline); }
.rank-item { background: var(--surface-container-lowest); padding: var(--space-sm); border-radius: var(--radius-lg); box-shadow: var(--shadow-card); display: flex; flex-direction: column; gap: 16rpx; position: relative; overflow: hidden; }
.rank-item-top { border: 2rpx solid var(--secondary-fixed); }
.rank-item-self { background: rgba(166, 243, 201, 0.2); }
.rank-item-main { display: flex; align-items: center; justify-content: space-between; }
.rank-item-left { display: flex; align-items: center; gap: var(--space-sm); min-width: 0; flex: 1; }
.rank-item-num-wrap { width: 64rpx; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
.rank-item-trophy { width: 52rpx; height: 52rpx; }
.rank-item-num { font-size: 44rpx; font-weight: 700; }
.rank-item-num-1 { color: var(--secondary); }
.rank-item-num-2 { color: var(--outline); }
.rank-item-num-3 { color: var(--tertiary); }
.rank-item-num-rest { color: var(--outline-variant); }
.rank-item-avatar { width: 80rpx; height: 80rpx; border-radius: 50%; box-shadow: var(--shadow-card); flex-shrink: 0; }
.rank-item-placeholder { display: flex; align-items: center; justify-content: center; font-size: 32rpx; font-weight: 600; color: var(--on-primary); }
.rank-item-info { flex: 1; min-width: 0; }
.rank-item-name-row { display: flex; align-items: center; gap: 12rpx; }
.rank-item-name { font-size: 32rpx; font-weight: 600; color: var(--on-surface); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.rank-item-tag { padding: 4rpx 12rpx; border-radius: var(--radius-full); font-size: 20rpx; font-weight: 700; display: flex; align-items: center; gap: 4rpx; white-space: nowrap; flex-shrink: 0; }
.rank-item-tag-gold { background: var(--secondary-fixed); color: var(--on-secondary-fixed); }
.rank-item-tag-self { background: rgba(0, 82, 53, 0.15); color: var(--primary); font-weight: 500; }
.rank-item-tag-tier { background: var(--primary-fixed); color: var(--on-primary-fixed); font-weight: 600; }
.rank-item-detail { display: flex; align-items: center; gap: 16rpx; font-size: 24rpx; color: var(--on-surface-variant); margin-top: 8rpx; }
.rank-detail-dot { width: 8rpx; height: 8rpx; border-radius: 50%; background: var(--outline-variant); }
.rank-item-right { width: 170rpx; box-sizing: border-box; flex-shrink: 0; display: flex; flex-direction: column; align-items: flex-end; padding-left: 12rpx; }
.rank-item-score { font-size: 44rpx; font-weight: 700; text-align: right; }
.rank-item-action { position: relative; margin-top: 8rpx; display: flex; align-items: center; gap: 8rpx; background: var(--primary); color: var(--on-primary); padding: 10rpx 24rpx; border-radius: var(--radius-full); font-size: 20rpx; box-shadow: var(--shadow-card); overflow: hidden; }
.rank-action-icon { width: 26rpx; height: 26rpx; }
.rank-item-action-self { background: var(--surface-container-lowest); color: var(--primary); box-shadow: var(--shadow-card); }
.rank-action-text-self { font-size: 22rpx; padding: 8rpx 20rpx; }
.rank-item-badges { display: flex; align-items: center; gap: 8rpx; padding-top: 8rpx; overflow-x: auto; white-space: nowrap; }
.rank-badge-pill { display: flex; align-items: center; gap: 8rpx; padding: 8rpx 16rpx; border-radius: var(--radius-full); font-size: 20rpx; font-weight: 500; flex-shrink: 0; background: var(--surface-container); color: var(--on-surface-variant); }
.rank-badge-icon { font-size: 22rpx; }

/* 底部签名 */
.lb-footer { display: flex; align-items: center; justify-content: center; gap: 16rpx; padding: var(--space-md) 0; }
.lb-footer-line { width: 48rpx; height: 2rpx; background: rgba(191, 201, 192, 0.6); }
.lb-footer-icon { width: 28rpx; height: 28rpx; }
.lb-footer-text { text-align: center; font-size: 20rpx; color: var(--outline); letter-spacing: 2rpx; display: block; }
.lb-footer-sub { text-align: center; font-size: 20rpx; color: var(--outline-variant); margin-top: 4rpx; display: block; padding-bottom: var(--space-sm); }

/* Toast */
.toast { position: fixed; top: 128rpx; left: 50%; transform: translateX(-50%); z-index: 200; padding: 16rpx 32rpx; border-radius: var(--radius-full); background: rgba(33, 49, 69, 0.9); color: var(--inverse-on-surface); font-size: 24rpx; box-shadow: var(--shadow-modal); opacity: 0; transition: opacity 0.3s ease; pointer-events: none; display: flex; align-items: center; gap: 8rpx; }
.toast.toast-show { opacity: 1; }
.toast-icon { width: 28rpx; height: 28rpx; }

/* 榜单切换（积分榜/排位榜） */
.lb-board-tabs { display: flex; gap: 16rpx; margin-top: 16rpx; }
.lb-board-tab { flex: 1; text-align: center; padding: 16rpx 0; border-radius: var(--radius-full); background: var(--surface-container-low); color: var(--on-surface-variant); font-size: 26rpx; font-weight: 500; }
.lb-board-tab.active { background: var(--primary); color: var(--on-primary); box-shadow: var(--shadow-card); }

/* 约开台分享按钮（重置 button 默认样式） */
/* 约开台分享按钮：重置微信 button 默认样式（默认宽度会撑爆右栏导致左栏竖排） */
/* 微信 button 只做透明命中层（open-type=share），绝对定位不影响布局 */
.rank-action-hit { position: absolute; top: 0; left: 0; width: 100%; height: 100%; opacity: 0; padding: 0; margin: 0; border: none; background: transparent; }
.rank-action-hit::after { border: none; }

/* 行内文本单行，防挤压竖排 */
.rank-item-detail { flex-wrap: nowrap; overflow: hidden; }
.rank-item-detail text { white-space: nowrap; flex-shrink: 0; }
.rank-item-detail text:last-child { overflow: hidden; text-overflow: ellipsis; flex-shrink: 1; min-width: 0; }
.rank-item-tags { display: flex; flex-wrap: wrap; gap: 8rpx; margin-top: 8rpx; }
.rank-item-tag-cell { padding: 2rpx 12rpx; border-radius: var(--radius-full); background: var(--surface-container-high); color: var(--on-surface-variant); font-size: 18rpx; white-space: nowrap; }
.rank-item-detail-sub { margin-top: 4rpx; color: var(--outline); }
