<!--pages/profile/profile.wxml — 我的页-->
<view class="page">
  <!-- 未登录 -->
  <view class="empty-state" wx:if="{{!isLoggedIn}}">
    <view class="empty-tile mj-tile">我</view>
    <view class="empty-text">未登入</view>
    <view class="text-secondary" style="margin-top: 8rpx;">登入后可以开台记分</view>
    <button class="btn-primary login-btn" bindtap="doLogin">微信登入</button>
  </view>

  <!-- 已登录 -->
  <block wx:if="{{isLoggedIn}}">
    <!-- 深绿个人卡 -->
    <view class="profile-hero card-green">
      <view class="profile-deco mj-tile profile-deco-tile">發</view>
      <view class="profile-avatar avatar-frame" style="{{avatarColor && !avatarURL ? 'background:' + avatarColor : ''}}">
        <image class="profile-avatar-img" src="{{avatarURL}}" mode="aspectFill" wx:if="{{avatarURL}}" />
        <text wx:else>{{nickname[0] || '?'}}</text>
      </view>
      <view class="profile-name" wx:if="{{!editing}}">{{nickname}}</view>

      <!-- 编辑昵称 -->
      <view class="edit-area" wx:if="{{editing}}">
        <input
          class="nickname-input"
          value="{{tempNickname}}"
          bindinput="onNicknameInput"
          maxlength="16"
          placeholder="输入新昵称"
          placeholder-class="input-placeholder"
        />
        <view class="edit-actions">
          <view class="mini-btn mini-save" bindtap="saveProfile">保存</view>
          <view class="mini-btn mini-cancel" bindtap="cancelEdit">取消</view>
        </view>
      </view>
      <view class="edit-link" wx:if="{{!editing}}" bindtap="goEditProfile">修改昵称 ›</view>
    </view>

    <!-- 设置分组 -->
    <view class="card menu-card">
      <view class="menu-item" bindtap="doLogout">
        <view class="menu-item-left">
          <view class="menu-icon mj-tile mj-tile-green">出</view>
          <text>退出登入</text>
        </view>
        <text class="menu-arrow">›</text>
      </view>
    </view>

    <!-- 关于 -->
    <view class="card about-card">
      <view class="section-title">关于得闲开台</view>
      <view class="about-text">
        得闲开台系专为粤语朋友打造嘅麻将牌局积分记录工具。
        唔使纸笔，唔使脑记，每位玩家自己提交本局分数，系统自动校验零和。
      </view>
      <view class="about-slogan">得闲开台，得闲一齐打！</view>
    </view>
  </block>
</view>
