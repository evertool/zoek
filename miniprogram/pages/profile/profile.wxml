<!--pages/profile/profile.wxml — 我的页 v6 Stitch 100% 还原-->
<view class="page">
  <!-- 未登录 -->
  <view class="empty-state" style="padding-top: {{navPadding}}px;" wx:if="{{!isLoggedIn}}">
    <view class="empty-tile mj-tile anim-float">我</view>
    <view class="empty-text">未登入</view>
    <view class="text-secondary" style="margin-top: 8rpx;">登入后可以开台记分</view>
    <button class="btn-primary login-btn anim-fade-up delay-2" bindtap="doLogin">微信登入</button>
  </view>

  <!-- 已登录 -->
  <block wx:if="{{isLoggedIn}}">
    <view class="main-content" style="padding-top: {{navPadding}}px;">
      <!-- Toast -->
      <view class="pf-toast {{showToast ? 'pf-toast-show' : ''}}">
        <image class="pf-toast-icon" src="/assets/icons/status-check-success.svg" mode="aspectFit" />
        <text>{{toastMsg}}</text>
      </view>

      <!-- 个人资料卡 -->
      <view class="pf-profile-card anim-fade-up" wx:if="{{!editing}}">
        <view class="pf-profile-glow"></view>
        <view class="pf-profile-row">
          <view class="pf-avatar-wrap">
            <image class="pf-avatar" src="{{avatarURL}}" mode="aspectFill" wx:if="{{avatarURL}}" />
            <view class="pf-avatar pf-avatar-placeholder" style="background:{{avatarColor}};" wx:else><text>{{nickname[0]}}</text></view>
          </view>
          <view class="pf-profile-info">
            <view class="pf-name-row">
              <text class="pf-name">{{nickname}}</text>
              <view class="pf-rank-tag" bindtap="goRank"><image class="pf-rank-icon" src="/assets/icons/rank-1-god-crown.svg" mode="aspectFit" /><text>{{rankTier || '九品 · 初'}}</text></view>
            </view>
            <view class="pf-mahjong-id-row">
              <text class="pf-mahjong-id" id="mahjong-id">雀友号: {{userId}}</text>
              <view class="pf-copy-btn" bindtap="copyUserId"><image src="/assets/icons/action-copy.svg" mode="aspectFit" /></view>
            </view>
            <text class="pf-motto" wx:if="{{motto}}">{{motto}}</text>
          </view>
        </view>
        <view class="pf-edit-link" bindtap="goEditProfile"><text>修改资料 ›</text></view>
      </view>

      <!-- 编辑模式 -->
      <view class="pf-profile-card anim-fade-up" wx:if="{{editing}}">
        <view class="pf-profile-glow"></view>
        <view class="pf-profile-row">
          <button class="pf-avatar-edit" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">
            <image class="pf-avatar" src="{{tempAvatar}}" mode="aspectFill" wx:if="{{tempAvatar}}" />
            <view class="pf-avatar pf-avatar-placeholder" wx:else><text class="pf-avatar-add">+</text></view>
          </button>
          <view class="pf-profile-info">
            <input class="pf-nickname-input" type="nickname" value="{{tempNickname}}" bindinput="onNicknameInput" maxlength="16" placeholder="点此填入微信昵称" placeholder-class="input-placeholder" />
            <text class="pf-edit-tip">点击左侧授权微信头像</text>
          </view>
        </view>
        <view class="pf-edit-actions">
          <view class="pf-btn-save" bindtap="saveProfile"><text>保存</text></view>
          <view class="pf-btn-cancel" bindtap="cancelEdit"><text>取消</text></view>
        </view>
      </view>

      <!-- 核心数据仪表板 -->
      <view class="pf-stats-card anim-fade-up delay-1" wx:if="{{stats}}">
        <view class="pf-stats-grid">
          <view class="pf-stat-cell">
            <text class="pf-stat-label">累计开台</text>
            <view class="pf-stat-val-row">
              <text class="pf-stat-val">{{stats.games}}</text>
              <text class="pf-stat-unit">场</text>
            </view>
            <view class="pf-stat-badge" wx:if="{{stats.loyalty_text}}"><text>{{stats.loyalty_text}}</text></view>
          </view>
          <view class="pf-stat-cell">
            <text class="pf-stat-label">总净积分</text>
            <view class="pf-stat-val-row">
              <text class="pf-stat-val text-positive">{{stats.total_score >= 0 ? '+' : ''}}{{stats.total_score}}</text>
              <text class="pf-stat-unit text-positive">分</text>
            </view>
            <text class="pf-stat-sub">均场 {{stats.avg_score >= 0 ? '+' : ''}}{{stats.avg_score}}</text>
          </view>
          <view class="pf-stat-cell">
            <text class="pf-stat-label">胜率</text>
            <view class="pf-stat-val-row">
              <text class="pf-stat-val">{{stats.win_rate}}</text>
              <text class="pf-stat-unit">%</text>
            </view>
            <view class="pf-stat-badge pf-stat-badge-amber"><text>近7场 {{stats.recent_wins}}胜</text></view>
          </view>
        </view>
      </view>

      <!-- 徽章展架 -->
      <view class="pf-badge-section">
        <view class="pf-section-header">
          <view class="pf-section-left">
            <view class="pf-section-bar"></view>
            <text class="pf-section-title">成就徽章</text>
          </view>
          <view class="pf-badge-more" bindtap="openBadgePanel">
            <text wx:if="{{badgeTotal > 0}}">累计点亮 {{unlockedCount}}/{{badgeTotal}} 个</text>
            <text wx:else>徽章一览</text>
            <text class="pf-more-arrow">›</text>
          </view>
        </view>
        <scroll-view class="pf-badge-scroll" scroll-x="true" wx:if="{{unlockedCount > 0}}">
          <view class="pf-badge-track">
            <view class="pf-badge-card pf-badge-card-lit" wx:for="{{badges}}" wx:for-item="badge" wx:key="code" wx:if="{{!badge.locked}}" data-code="{{badge.code}}" bindtap="openBadgePanel">
              <view class="pf-badge-icon-wrap" style="{{badge.iconStyle}}">
                <image wx:if="{{badge.iconURL}}" class="pf-badge-icon-img" src="{{badge.iconURL}}" mode="aspectFit" />
                <text wx:else class="pf-badge-icon">{{badge.icon}}</text>
              </view>
              <text class="pf-badge-name">{{badge.name}}</text>
              <text class="pf-badge-desc">{{badge.desc}}</text>
              <view class="pf-badge-status">
                <view class="pf-badge-dot"></view>
                <text class="pf-badge-status-text">已点亮</text>
              </view>
            </view>
          </view>
        </scroll-view>
        <view class="pf-badge-empty" wx:elif="{{badgeLoading}}">
          <text class="pf-badge-empty-text">正在读取徽章战绩…</text>
        </view>
        <view class="pf-badge-empty" wx:elif="{{badgeError}}" bindtap="loadBadges">
          <text class="pf-badge-empty-text">徽章战绩读取失败 · 点此重试</text>
        </view>
        <view class="pf-badge-empty" wx:else bindtap="openBadgePanel">
          <text class="pf-badge-empty-text">仲未点亮任何徽章</text>
          <text class="pf-badge-empty-sub" wx:if="{{nextBadge}}">最接近：{{nextBadge.name}}　进度 {{nextBadge.current}}/{{nextBadge.target}}</text>
          <text class="pf-badge-empty-sub" wx:else>点此查看全部徽章同达成条件</text>
        </view>
      </view>

      <!-- 个性化与体验 -->
      <view class="pf-menu-group">
        <text class="pf-menu-group-title">个性化与体验</text>
        <view class="pf-menu-card">
          <view class="pf-menu-item" bindtap="openPrefsPanel">
            <view class="pf-menu-left">
              <view class="pf-menu-icon pf-menu-icon-primary"><image src="/assets/icons/sys-preferences-slider.svg" mode="aspectFit" /></view>
              <view class="pf-menu-info">
                <text class="pf-menu-label">牌局偏好设置</text>
                <text class="pf-menu-sub">得分语音播报 · 配音音色 · 震动提醒</text>
              </view>
            </view>
            <view class="pf-menu-right">
              <text class="pf-menu-right-text">{{voiceEnabled ? '语音开' : '语音关'}} · {{vibrateEnabled ? '震动开' : '震动关'}}</text>
              <text class="pf-menu-arrow">›</text>
            </view>
          </view>
          <view class="pf-menu-divider"></view>
          <view class="pf-menu-item" bindtap="showBlacklist">
            <view class="pf-menu-left">
              <view class="pf-menu-icon pf-menu-icon-secondary"><image src="/assets/icons/sys-blacklist-slash.svg" mode="aspectFit" /></view>
              <view class="pf-menu-info">
                <text class="pf-menu-label">雀友黑名单与隐藏</text>
                <text class="pf-menu-sub">管理不想同台或隐藏战绩的牌友</text>
              </view>
            </view>
            <view class="pf-menu-right">
              <text class="pf-menu-right-text">无限制</text>
              <text class="pf-menu-arrow">›</text>
            </view>
          </view>
        </view>
      </view>

      <!-- 平台守则与关于 -->
      <view class="pf-menu-group">
        <text class="pf-menu-group-title">平台守则与关于</text>
        <view class="pf-menu-card">
          <view class="pf-menu-item" bindtap="openSafety">
            <view class="pf-menu-left">
              <view class="pf-menu-icon pf-menu-icon-tertiary"><image src="/assets/icons/sys-shield-security.svg" mode="aspectFit" /></view>
              <view class="pf-menu-info">
                <text class="pf-menu-label">安全与隐私守则</text>
                <text class="pf-menu-sub">绿色健康娱乐 · 纯积分免责声明</text>
              </view>
            </view>
            <text class="pf-menu-arrow">›</text>
          </view>
          <view class="pf-menu-divider"></view>
          <view class="pf-menu-item" bindtap="showAbout">
            <view class="pf-menu-left">
              <view class="pf-menu-icon pf-menu-icon-neutral"><image src="/assets/icons/score-statement-history.svg" mode="aspectFit" /></view>
              <view class="pf-menu-info">
                <text class="pf-menu-label">关于得闲开台</text>
                <text class="pf-menu-sub">传承岭南茶台闲趣，无争无扰</text>
              </view>
            </view>
            <view class="pf-menu-right">
              <text class="pf-menu-right-text">v1.2 (正式版)</text>
              <text class="pf-menu-arrow">›</text>
            </view>
          </view>
        </view>
      </view>

      <!-- 底部操作 -->
      <view class="pf-bottom-actions">
        <view class="pf-logout-btn" bindtap="doLogout"><text>退出登入</text></view>
      </view>

      <!-- 底部签名 -->
      <view class="pf-footer">
        <image class="pf-footer-icon" src="/assets/icons/status-check-success.svg" mode="aspectFit" />
        <text class="pf-footer-text">佛山数匠科技·得闲饮茶·开台大吉</text>
      </view>
    </view>
  </block>

  <!-- 牌局偏好设置面板（点「牌局偏好设置」打开） -->
  <view class="pf-pref-overlay {{showPrefsPanel ? 'pf-pref-show' : ''}}" bindtap="closePrefsPanel">
    <view class="pf-pref-panel" catchtap="stopPropagation">
      <view class="pf-pref-grabber"></view>
      <view class="pf-pref-header">
        <view class="pf-pref-header-main">
          <text class="pf-pref-title">牌局偏好设置</text>
          <text class="pf-pref-sub">只存喺呢部手机，换机唔会跟过去</text>
        </view>
        <view class="pf-pref-close" bindtap="closePrefsPanel"><text>✕</text></view>
      </view>

      <view class="pf-pref-row" bindtap="toggleVoice">
        <view class="pf-pref-row-icon"><image src="/assets/icons/sys-speaker-voice.svg" mode="aspectFit" /></view>
        <view class="pf-pref-row-main">
          <text class="pf-pref-row-label">得分语音播报</text>
          <text class="pf-pref-row-desc">有人转分畀你嗰阵，用粤语读出嚟</text>
        </view>
        <view class="pf-switch {{voiceEnabled ? 'pf-switch-on' : ''}}">
          <view class="pf-switch-knob"></view>
        </view>
      </view>

      <view class="pf-pref-row pf-pref-row-block">
        <view class="pf-pref-row-icon"><image src="/assets/icons/sys-speaker-voice.svg" mode="aspectFit" /></view>
        <view class="pf-pref-row-main">
          <text class="pf-pref-row-label">配音音色</text>
          <text class="pf-pref-row-desc">只有女声粤语係粤语，另外两个系普通话</text>
          <view class="pf-pref-seg">
            <view class="pf-pref-seg-item {{voiceTone === tone.key ? 'pf-pref-seg-on' : ''}}"
                  wx:for="{{voiceTones}}" wx:for-item="tone" wx:key="key"
                  data-key="{{tone.key}}" bindtap="selectVoiceTone">
              <text>{{tone.label}}</text>
            </view>
          </view>
        </view>
      </view>

      <view class="pf-pref-row" bindtap="toggleVibrate">
        <view class="pf-pref-row-icon"><image src="/assets/icons/sys-preferences-slider.svg" mode="aspectFit" /></view>
        <view class="pf-pref-row-main">
          <text class="pf-pref-row-label">震动提醒</text>
          <text class="pf-pref-row-desc">收到分同动画效果都会有轻触感反馈</text>
        </view>
        <view class="pf-switch {{vibrateEnabled ? 'pf-switch-on' : ''}}">
          <view class="pf-switch-knob"></view>
        </view>
      </view>

      <text class="pf-pref-note">得分语音播报要联网攞音频，默认关闭；音色选咗即刻试听。女声粤语係真粤语，女声/男声普语係普通话；震动只喺本机，默认开启。</text>
    </view>
  </view>

  <!-- 徽章总览面板 -->
  <view class="pf-bp-overlay {{showBadgePanel ? 'pf-bp-show' : ''}}" bindtap="closeBadgePanel">
    <view class="pf-bp-panel" catchtap="stopPropagation">
      <view class="pf-bp-grabber"></view>
      <view class="pf-bp-header">
        <view class="pf-bp-header-main">
          <text class="pf-bp-title">成就徽章</text>
          <text class="pf-bp-sub">已点亮 {{unlockedCount}}/{{badgeTotal}} · 由真实战绩自动计算</text>
        </view>
        <view class="pf-bp-info-btn" catchtap="toggleBadgeRules">
          <text class="pf-bp-info-icon">ⓘ</text>
        </view>
        <view class="pf-bp-close" bindtap="closeBadgePanel"><text>✕</text></view>
      </view>
      <view class="pf-bp-rules" wx:if="{{badgeRules}}">
        <text class="pf-bp-rules-title">规则说明</text>
        <text class="pf-bp-rules-text">徽章由真实对局数据自动计算，规则透明可解释：胜场、连胜、逐局流水时间线、期间峰值积分、终局记分、参与场次。数据不足时不会点亮，亦不会随机生成；同一场牌局可获多个徽章。</text>
      </view>
      <view class="pf-bp-state" wx:if="{{badgeLoading}}">
        <text class="pf-bp-state-text">正在读取徽章战绩…</text>
      </view>
      <view class="pf-bp-state" wx:elif="{{badgeError}}">
        <text class="pf-bp-state-text">徽章战绩读取失败，请检查网络后重试</text>
        <view class="pf-bp-state-btn" bindtap="loadBadges"><text>重新读取</text></view>
      </view>
      <scroll-view class="pf-bp-scroll" scroll-y="true" scroll-into-view="{{bpScrollInto}}" scroll-with-animation="true" wx:else>
        <view class="pf-bp-grid">
          <view id="bp-{{badge.code}}" class="pf-bp-card {{badge.locked ? 'pf-bp-card-locked' : 'pf-bp-card-lit'}} {{bpFocusCode === badge.code ? 'pf-bp-card-focus' : ''}}" wx:for="{{badges}}" wx:for-item="badge" wx:key="code">
            <view class="pf-bp-card-top">
              <view class="pf-badge-icon-wrap {{badge.locked ? 'pf-badge-icon-dim' : 'pf-badge-icon-on'}}" style="{{badge.iconStyle}}">
                <image wx:if="{{badge.iconURL}}" class="pf-badge-icon-img" src="{{badge.iconURL}}" mode="aspectFit" />
                <text wx:else class="pf-badge-icon">{{badge.icon}}</text>
              </view>
              <view class="pf-bp-lit-chip" wx:if="{{!badge.locked}}"><text>✓ 已点亮</text></view>
              <view class="pf-bp-unlit-chip" wx:else><text>未点亮</text></view>
            </view>
            <text class="pf-bp-name">{{badge.name}}</text>
            <text class="pf-bp-desc">{{badge.desc}}</text>
            <view class="pf-bp-progress-wrap" wx:if="{{badge.locked}}">
              <view class="pf-bp-progress-track">
                <view class="pf-bp-progress-fill" style="width: {{badge.progress}}%;"></view>
              </view>
              <text class="pf-bp-progress-val" wx:if="{{badge.target > 1}}">进度 {{badge.current}}/{{badge.target}} · 仲差 {{badge.target - badge.current}}</text>
              <text class="pf-bp-progress-val" wx:else>仲未达成 · 静候你嘅高光一局</text>
            </view>
            <view class="pf-bp-unlock-line" wx:else><text>已点亮 · 战绩为证</text></view>
          </view>
        </view>
      </scroll-view>
      <view class="pf-bp-footer" wx:if="{{badgeTotal > 0}}">
        <text>点亮状态实时同步战绩 · 数据不足不会点亮</text>
      </view>
    </view>
  </view>

  <!-- 安全与隐私守则（点「安全与隐私守则」展开查看） -->
  <view class="pf-bp-overlay {{showSafetyPanel ? 'pf-bp-show' : ''}}" bindtap="closeSafety">
    <view class="pf-bp-panel pf-sp-panel" catchtap="stopPropagation">
      <view class="pf-bp-grabber"></view>
      <view class="pf-bp-header">
        <view class="pf-bp-header-main">
          <text class="pf-bp-title">安全与隐私守则</text>
          <text class="pf-bp-sub">纯积分娱乐 · 绿色健康 · 不涉金钱</text>
        </view>
        <view class="pf-bp-close" bindtap="closeSafety"><text>✕</text></view>
      </view>
      <scroll-view class="pf-sp-scroll" scroll-y="true">
        <view class="pf-sp-lead">
          <text class="pf-sp-lead-text">得闲开台是一只纯积分记分工具，唔涉及任何金钱往来。下面讲清楚我们收集什么、点样用，同埋希望大家点样好好用。</text>
        </view>
        <view class="pf-sp-section" wx:for="{{safetySections}}" wx:for-item="sec" wx:key="title">
          <view class="pf-sp-h"><view class="pf-sp-bar"></view><text>{{sec.title}}</text></view>
          <text class="pf-sp-p" wx:for="{{sec.items}}" wx:for-item="line" wx:key="*this">{{line}}</text>
        </view>
        <text class="pf-sp-updated">本守则更新于 2026年9月15日 · 得闲开台</text>
      </scroll-view>
    </view>
  </view>
</view>
