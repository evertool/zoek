/* pages/profile/profile.wxss */

/* 授权页 */
.auth-page {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 160rpx 48rpx 0;
}

.auth-logo {
  font-size: 120rpx;
  margin-bottom: 24rpx;
}

.auth-title {
  font-size: 48rpx;
  font-weight: 700;
}

.auth-desc {
  font-size: 28rpx;
  color: var(--color-text-secondary);
  margin-top: 12rpx;
}

/* 用户信息卡片 */
.profile-hero {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 48rpx 32rpx;
}

.profile-avatar {
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  overflow: hidden;
  margin-bottom: 24rpx;
  background: var(--color-divider);
}

.profile-avatar image {
  width: 100%;
  height: 100%;
}

.profile-avatar-text {
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 56rpx;
  font-weight: 700;
  color: #FFFFFF;
  margin-bottom: 24rpx;
}

.profile-name {
  font-size: 36rpx;
  font-weight: 600;
}

/* 功能菜单 */
.menu-item {
  display: flex;
  align-items: center;
  padding: 28rpx 0;
  border-bottom: 1rpx solid var(--color-divider);
  font-size: 30rpx;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-icon {
  width: 48rpx;
  font-size: 32rpx;
  text-align: center;
  margin-right: 20rpx;
}

.menu-label {
  flex: 1;
}

.menu-arrow {
  color: var(--color-text-tertiary);
  font-size: 36rpx;
}

/* 编辑弹层 */
.edit-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0,0,0,0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;
}

.edit-modal {
  background: var(--color-card);
  border-radius: var(--radius-lg);
  padding: 40rpx 32rpx;
  width: 88%;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.edit-title {
  font-size: 36rpx;
  font-weight: 600;
  margin-bottom: 32rpx;
}

.avatar-picker {
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  padding: 0;
  overflow: hidden;
  background: var(--color-divider);
  border: 2rpx solid var(--color-border);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 32rpx;
}

.avatar-picker::after { border: none; }

.avatar-picker image {
  width: 100%;
  height: 100%;
}

.avatar-placeholder {
  font-size: 24rpx;
  color: var(--color-text-secondary);
}

.edit-actions {
  display: flex;
  gap: 16rpx;
  width: 100%;
}

.edit-actions button {
  flex: 1;
}
