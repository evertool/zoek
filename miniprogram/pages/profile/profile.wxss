/* pages/profile/profile.wxss — 我的页 v4 白底卡通版
 * 深绿个人卡 + 金边头像 + 麻将牌图标设置项
 */

.page {
  padding: 32rpx;
  min-height: 100vh;
  box-sizing: border-box;
}

/* ===== 未登录 ===== */
.empty-tile {
  width: 120rpx;
  height: 160rpx;
  font-size: 56rpx;
  margin-bottom: 28rpx;
}

.login-btn {
  margin: 48rpx auto 0;
  width: 100% !important;
}

/* ===== 深绿个人卡 ===== */
.profile-hero {
  border-radius: 28rpx;
  padding: 60rpx 36rpx 48rpx;
  margin-bottom: 32rpx;
  text-align: center;
  position: relative;
  overflow: hidden;
}

.profile-deco-tile {
  position: absolute;
  right: -16rpx;
  top: -12rpx;
  width: 100rpx;
  height: 132rpx;
  font-size: 46rpx;
  transform: rotate(16deg);
  opacity: 0.85;
  background: rgba(255, 248, 239, 0.92);
}

.avatar-frame {
  border: 6rpx solid var(--color-gold);
  box-shadow: 0 8rpx 20rpx rgba(0, 0, 0, 0.2);
}

.profile-avatar {
  width: 132rpx;
  height: 132rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #2E8A5E, #1E6B47);
  color: #FFF8EF;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 56rpx;
  font-weight: 800;
  margin: 0 auto 24rpx;
  overflow: hidden;
  box-sizing: border-box;
}

.profile-avatar-img {
  width: 100%;
  height: 100%;
}

.profile-name {
  color: #FFF8EF;
  font-size: 38rpx;
  font-weight: 800;
  letter-spacing: 2rpx;
}

/* ===== 编辑昵称 ===== */
.edit-area {
  margin-top: 20rpx;
}

.nickname-input {
  border: 2rpx solid rgba(255, 248, 239, 0.5);
  border-radius: 20rpx;
  padding: 18rpx 24rpx;
  font-size: 30rpx;
  text-align: center;
  color: #FFF8EF;
  background: rgba(255, 248, 239, 0.12);
  margin-bottom: 20rpx;
}

.input-placeholder {
  color: rgba(255, 248, 239, 0.4);
}

.edit-actions {
  display: flex;
  gap: 16rpx;
  justify-content: center;
}

.mini-btn {
  font-size: 24rpx;
  padding: 10rpx 36rpx;
  border-radius: 28rpx;
  line-height: 1.5;
}

.mini-save {
  background: var(--color-red);
  color: #FFF;
  box-shadow: 0 4rpx 10rpx rgba(232, 68, 46, 0.3);
}

.mini-cancel {
  background: rgba(255, 248, 239, 0.16);
  color: rgba(255, 248, 239, 0.75);
}

.edit-link {
  color: rgba(255, 248, 239, 0.6);
  font-size: 24rpx;
  margin-top: 12rpx;
}

/* ===== 设置分组 ===== */
.menu-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 10rpx 0;
  font-size: 30rpx;
  color: var(--color-text);
}

.menu-item-left {
  display: flex;
  align-items: center;
}

.menu-icon {
  width: 48rpx;
  height: 62rpx;
  font-size: 22rpx;
  margin-right: 20rpx;
}

.menu-arrow {
  color: var(--color-text-tertiary);
  font-size: 40rpx;
  font-weight: 300;
}

/* ===== 关于 ===== */
.about-text {
  font-size: 26rpx;
  color: var(--color-text-secondary);
  line-height: 1.8;
}

.about-slogan {
  margin-top: 20rpx;
  font-size: 24rpx;
  color: var(--color-gold-dark);
  letter-spacing: 2rpx;
}

/* ===== 编辑态头像按钮（圆形，去除微信 button 默认样式） ===== */
.profile-avatar-edit {
  display: block;
  width: 148rpx;
  height: 148rpx;
  padding: 0;
  margin: 0 auto 14rpx;
  background: rgba(255, 248, 239, 0.12);
  border: 3rpx dashed rgba(255, 248, 239, 0.6);
  border-radius: 50%;
  overflow: hidden;
  line-height: 1;
  box-sizing: border-box;
  position: relative;
}

.profile-avatar-edit::after {
  border: none;
  transform: scale(1);
}

.profile-avatar-edit .profile-avatar-img {
  width: 148rpx;
  height: 148rpx;
  border-radius: 50%;
  border: 4rpx solid var(--color-gold);
  box-sizing: border-box;
}

.profile-avatar-add {
  font-size: 52rpx;
  color: rgba(255, 248, 239, 0.8);
  line-height: 148rpx;
}

.avatar-edit-tip {
  font-size: 22rpx;
  color: rgba(255, 248, 239, 0.6);
  margin-bottom: 24rpx;
  letter-spacing: 1rpx;
}
