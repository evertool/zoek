/* pages/profile/profile.wxss — 我的页（设计 v2：深绿个人卡 + 金边头像） */

.page {
  padding: 32rpx;
  min-height: 100vh;
  box-sizing: border-box;
}

/* ===== 未登录 ===== */
.empty-tile {
  width: 120rpx;
  height: 160rpx;
  font-size: 56rpx;
  margin-bottom: 28rpx;
}

.login-btn {
  margin: 48rpx auto 0;
  width: 100% !important;
}

/* ===== 深绿个人卡 ===== */
.profile-hero {
  border-radius: 28rpx;
  padding: 60rpx 36rpx 48rpx;
  margin-bottom: 32rpx;
  text-align: center;
  position: relative;
  overflow: hidden;
}

.profile-deco-tile {
  position: absolute;
  right: -16rpx;
  top: -12rpx;
  width: 100rpx;
  height: 132rpx;
  font-size: 46rpx;
  transform: rotate(16deg);
  opacity: 0.85;
  background: rgba(247, 243, 232, 0.92);
}

.avatar-frame {
  border: 6rpx solid var(--color-gold);
  box-shadow: 0 8rpx 20rpx rgba(0, 0, 0, 0.2);
}

.profile-avatar {
  width: 132rpx;
  height: 132rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #237652, #1E6B47);
  color: #F7F3E8;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 56rpx;
  font-weight: 800;
  margin: 0 auto 24rpx;
  overflow: hidden;
  box-sizing: border-box;
}

.profile-avatar-img {
  width: 100%;
  height: 100%;
}

.profile-name {
  color: #F7F3E8;
  font-size: 38rpx;
  font-weight: 800;
  letter-spacing: 2rpx;
}

/* ===== 编辑昵称 ===== */
.edit-area {
  margin-top: 20rpx;
}

.nickname-input {
  border: 2rpx solid rgba(247, 243, 232, 0.5);
  border-radius: 20rpx;
  padding: 18rpx 24rpx;
  font-size: 30rpx;
  text-align: center;
  color: #F7F3E8;
  background: rgba(247, 243, 232, 0.12);
  margin-bottom: 20rpx;
}

.input-placeholder {
  color: rgba(247, 243, 232, 0.4);
}

.edit-actions {
  display: flex;
  gap: 16rpx;
  justify-content: center;
}

.mini-btn {
  font-size: 24rpx;
  padding: 10rpx 36rpx;
  border-radius: 28rpx;
  line-height: 1.5;
}

.mini-save {
  background: var(--color-cta);
  color: #FFF;
}

.mini-cancel {
  background: rgba(247, 243, 232, 0.16);
  color: rgba(247, 243, 232, 0.75);
}

.edit-link {
  color: rgba(247, 243, 232, 0.6);
  font-size: 24rpx;
  margin-top: 12rpx;
}

/* ===== 设置分组 ===== */
.menu-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 10rpx 0;
  font-size: 30rpx;
  color: var(--color-text);
}

.menu-item-left {
  display: flex;
  align-items: center;
}

.menu-icon {
  width: 48rpx;
  height: 62rpx;
  font-size: 22rpx;
  margin-right: 20rpx;
}

.menu-arrow {
  color: var(--color-text-tertiary);
  font-size: 40rpx;
  font-weight: 300;
}

/* ===== 关于 ===== */
.about-text {
  font-size: 26rpx;
  color: var(--color-text-secondary);
  line-height: 1.8;
}

.about-slogan {
  margin-top: 20rpx;
  font-size: 24rpx;
  color: #8C6B25;
  letter-spacing: 2rpx;
}
