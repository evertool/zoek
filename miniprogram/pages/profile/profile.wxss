/* pages/profile/profile.wxss — 我的页 v6 Stitch 100% 还原 */
.page { min-height: 100vh; background: var(--background); padding-bottom: 160rpx; }
.main-content { padding-bottom: 80rpx; display: flex; flex-direction: column; gap: var(--space-md); }

/* Toast */
.pf-toast { position: fixed; top: 128rpx; left: 50%; transform: translateX(-50%); z-index: 200; padding: 16rpx 32rpx; border-radius: var(--radius-full); background: rgba(33, 49, 69, 0.9); color: var(--inverse-on-surface); font-size: 24rpx; box-shadow: var(--shadow-modal); opacity: 0; transition: opacity 0.3s ease; pointer-events: none; display: flex; align-items: center; gap: 8rpx; }
.pf-toast.pf-toast-show { opacity: 1; }
.pf-toast-icon { width: 28rpx; height: 28rpx; }

/* 个人资料卡 */
.pf-profile-card { position: relative; overflow: hidden; border-radius: var(--radius-lg); background: var(--surface-container-lowest); padding: var(--space-lg); margin: 0 var(--margin-screen); box-shadow: var(--shadow-card); }
.pf-profile-glow { position: absolute; right: -64rpx; top: -64rpx; width: 288rpx; height: 288rpx; border-radius: 50%; background: rgba(166, 243, 201, 0.2); filter: blur(40rpx); pointer-events: none; }
.pf-profile-row { display: flex; align-items: flex-start; gap: var(--space-md); position: relative; }
.pf-avatar-wrap { position: relative; flex-shrink: 0; }
.pf-avatar { width: 128rpx; height: 128rpx; border-radius: 50%; overflow: hidden; box-shadow: 0 4rpx 16rpx rgba(27, 107, 74, 0.12); }
.pf-avatar-placeholder { display: flex; align-items: center; justify-content: center; font-size: 48rpx; font-weight: 600; color: var(--on-primary); }
.pf-avatar-add { font-size: 48rpx; color: var(--outline); }
.pf-avatar-edit { width: 128rpx; height: 128rpx; border-radius: 50%; padding: 0; margin: 0; background: transparent; border: none; overflow: hidden; line-height: 1; box-sizing: border-box; flex-shrink: 0; }
.pf-avatar-edit::after { border: none; transform: scale(1); }
.pf-profile-info { flex: 1; min-width: 0; }
.pf-name-row { display: flex; align-items: center; gap: 16rpx; flex-wrap: wrap; }
.pf-name { font-size: 40rpx; font-weight: 600; color: var(--on-surface); letter-spacing: -1rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.pf-rank-tag { display: flex; align-items: center; gap: 4rpx; padding: 8rpx 16rpx; border-radius: var(--radius-full); background: var(--primary-fixed); color: var(--on-primary-fixed); font-size: 20rpx; font-weight: 500; }
.pf-rank-icon { width: 24rpx; height: 24rpx; }
.pf-mahjong-id-row { display: flex; align-items: center; gap: 12rpx; margin-top: 12rpx; }
.pf-mahjong-id { font-size: 24rpx; color: var(--on-surface-variant); }
.pf-copy-btn { width: 40rpx; height: 40rpx; display: flex; align-items: center; justify-content: center; }
.pf-copy-btn image { width: 28rpx; height: 28rpx; }
.pf-motto { font-size: 24rpx; color: var(--on-surface-variant); margin-top: 8rpx; display: block; }
.pf-edit-link { margin-top: var(--space-sm); font-size: 24rpx; color: var(--primary); text-align: center; }
.pf-nickname-input { background: var(--surface-container-low); border: 2rpx solid var(--outline-variant); border-radius: var(--radius-default); padding: 16rpx 24rpx; font-size: 28rpx; color: var(--on-surface); margin-top: 8rpx; }
.input-placeholder { color: var(--outline); }
.pf-edit-tip { font-size: 20rpx; color: var(--on-surface-variant); margin-top: 8rpx; display: block; }
.pf-edit-actions { display: flex; gap: var(--space-sm); margin-top: var(--space-md); }
.pf-btn-save, .pf-btn-cancel { flex: 1; height: 80rpx; border-radius: var(--radius-md); display: flex; align-items: center; justify-content: center; font-size: 24rpx; font-weight: 600; }
.pf-btn-save { background: var(--primary); color: var(--on-primary); }
.pf-btn-cancel { background: var(--surface-container); color: var(--on-surface); }

/* 核心数据 */
.pf-stats-card { margin: 0 var(--margin-screen); border-radius: var(--radius-lg); background: var(--surface-container-lowest); padding: var(--space-md); box-shadow: var(--shadow-card); }
.pf-stats-grid { display: grid; grid-template-columns: repeat(3, 1fr); text-align: center; }
.pf-stat-cell { display: flex; flex-direction: column; align-items: center; }
.pf-stat-label { font-size: 20rpx; color: var(--outline); text-transform: uppercase; letter-spacing: 1rpx; margin-bottom: 4rpx; }
.pf-stat-val-row { display: flex; align-items: baseline; gap: 8rpx; }
.pf-stat-val { font-size: 48rpx; font-weight: 600; color: var(--on-surface); letter-spacing: -1rpx; }
.pf-stat-unit { font-size: 20rpx; color: var(--on-surface-variant); }
.pf-stat-badge { margin-top: 8rpx; padding: 4rpx 12rpx; border-radius: var(--radius-default); background: rgba(166, 243, 201, 0.4); }
.pf-stat-badge text { font-size: 20rpx; color: var(--primary); }
.pf-stat-badge-amber { background: rgba(255, 220, 195, 0.5); }
.pf-stat-badge-amber text { color: var(--secondary); }
.pf-stat-sub { font-size: 20rpx; color: var(--on-surface-variant); margin-top: 8rpx; }

/* 徽章展架 */
.pf-badge-section { margin-top: var(--space-lg); }
.pf-section-header { display: flex; align-items: center; justify-content: space-between; padding: 0 var(--margin-screen); margin-bottom: 20rpx; }
.pf-section-left { display: flex; align-items: center; gap: 12rpx; }
.pf-section-bar { width: 12rpx; height: 28rpx; border-radius: var(--radius-sm); background: var(--primary); }
.pf-section-title { font-size: 36rpx; font-weight: 600; color: var(--on-surface); }
.pf-badge-more { display: flex; align-items: center; gap: 4rpx; }
.pf-badge-more text { font-size: 24rpx; color: var(--primary); }
.pf-more-arrow { font-size: 28rpx; color: var(--primary); }
.pf-badge-scroll { white-space: nowrap; }
.pf-badge-track { display: flex; gap: 20rpx; padding: 8rpx var(--margin-screen) 16rpx; }
.pf-badge-card { flex-shrink: 0; width: 288rpx; padding: 24rpx; border-radius: var(--radius-lg); background: var(--surface-container-lowest); box-shadow: var(--shadow-card); display: flex; flex-direction: column; justify-content: space-between; position: relative; overflow: hidden; }
.pf-badge-locked { opacity: 0.6; }
.pf-badge-icon-wrap { width: 72rpx; height: 72rpx; border-radius: 50%; display: flex; align-items: center; justify-content: center; }
.pf-badge-icon-gold { background: var(--secondary-fixed); }
.pf-badge-icon-red { background: var(--tertiary-fixed); }
.pf-badge-icon-green { background: var(--primary-fixed); }
.pf-badge-icon-neutral { background: var(--surface-container-high); }
.pf-badge-icon { font-size: 40rpx; }
.pf-badge-icon-img { width: 56rpx; height: 56rpx; }
.pf-badge-name { font-size: 28rpx; font-weight: 600; color: var(--on-surface); margin-top: 20rpx; }
.pf-badge-desc { font-size: 22rpx; color: var(--on-surface-variant); margin-top: 8rpx; overflow: hidden; text-overflow: ellipsis; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; }
.pf-badge-status { display: flex; align-items: center; gap: 8rpx; margin-top: 24rpx; }
.pf-badge-dot { width: 12rpx; height: 12rpx; border-radius: 50%; background: var(--primary); }
.pf-badge-status-text { font-size: 20rpx; color: var(--primary); font-weight: 600; }
.pf-badge-progress { margin-top: 24rpx; }
.pf-progress-bar { width: 100%; height: 12rpx; border-radius: var(--radius-full); background: var(--surface-dim); overflow: hidden; }
.pf-progress-fill { height: 100%; border-radius: var(--radius-full); background: var(--primary); transition: width 0.3s ease; }
.pf-progress-row { display: flex; justify-content: space-between; align-items: center; margin-top: 8rpx; }
.pf-progress-label { font-size: 20rpx; color: var(--outline); }
.pf-progress-val { font-size: 20rpx; color: var(--outline); }

/* 菜单组 */
.pf-menu-group { margin: 0 var(--margin-screen); margin-top: 40rpx; }
.pf-menu-group-title { font-size: 20rpx; color: var(--outline); padding: 0 8rpx; margin-bottom: 16rpx; text-transform: uppercase; letter-spacing: 1rpx; }
.pf-menu-card { border-radius: var(--radius-lg); background: var(--surface-container-lowest); overflow: hidden; box-shadow: var(--shadow-card); }
.pf-menu-item { display: flex; align-items: center; justify-content: space-between; padding: 32rpx; }
.pf-menu-left { display: flex; align-items: center; gap: 24rpx; flex: 1; min-width: 0; }
.pf-menu-icon { width: 64rpx; height: 64rpx; border-radius: var(--radius-default); display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
.pf-menu-icon-primary { background: var(--surface-container); }
.pf-menu-icon image { width: 32rpx; height: 32rpx; }
.pf-menu-icon-primary image { color: var(--primary); }
.pf-menu-icon-secondary image { color: var(--secondary); }
.pf-menu-icon-tertiary image { color: var(--tertiary); }
.pf-menu-icon-neutral image { color: var(--on-surface); }
.pf-menu-info { display: flex; flex-direction: column; }
.pf-menu-label { font-size: 28rpx; font-weight: 600; color: var(--on-surface); }
.pf-menu-sub { font-size: 22rpx; color: var(--on-surface-variant); }
.pf-menu-right { display: flex; align-items: center; gap: 8rpx; }
.pf-menu-right-text { font-size: 20rpx; color: var(--on-surface-variant); }
.pf-menu-tag { padding: 4rpx 12rpx; border-radius: var(--radius-default); background: rgba(166, 243, 201, 0.5); }
.pf-menu-tag text { font-size: 20rpx; color: var(--primary); }
.pf-menu-arrow { font-size: 28rpx; color: var(--outline); }
.pf-menu-divider { height: 2rpx; background: var(--surface-container); margin: 0 32rpx; }

/* Switch */
.pf-switch { width: 88rpx; height: 48rpx; border-radius: var(--radius-full); background: var(--outline-variant); display: flex; align-items: center; padding: 4rpx; transition: background 0.2s ease; }
.pf-switch.pf-switch-on { background: var(--primary); justify-content: flex-end; }
.pf-switch-knob { width: 40rpx; height: 40rpx; border-radius: 50%; background: white; box-shadow: var(--shadow-card); transition: transform 0.2s ease; }

/* 底部操作 */
.pf-bottom-actions { margin: 0 var(--margin-screen); margin-top: 48rpx; display: flex; flex-direction: column; gap: 20rpx; }
.pf-logout-btn { height: 88rpx; border-radius: var(--radius-md); background: transparent; border: 2rpx solid var(--outline-variant); display: flex; align-items: center; justify-content: center; font-size: 24rpx; color: var(--outline); }
.pf-logout-btn:active { background: var(--surface-container-low); }

/* 底部签名 */
.pf-footer { margin-top: 64rpx; text-align: center; display: flex; align-items: center; justify-content: center; gap: 8rpx; }
.pf-footer-icon { width: 28rpx; height: 28rpx; }
.pf-footer-text { font-size: 20rpx; color: var(--outline); }

/* 徽章：横滑条空态 */
.pf-badge-empty { margin: 8rpx var(--margin-screen) 16rpx; padding: 28rpx; border-radius: var(--radius-lg); background: var(--surface-container-lowest); box-shadow: var(--shadow-card); }
.pf-badge-empty-text { font-size: 24rpx; color: var(--on-surface-variant); }

/* 徽章总览面板 */
.pf-bp-overlay { position: fixed; inset: 0; background: rgba(0, 0, 0, 0.45); opacity: 0; visibility: hidden; transition: opacity 0.25s ease, visibility 0.25s; z-index: 1000; }
.pf-bp-overlay.pf-bp-show { opacity: 1; visibility: visible; }
.pf-bp-panel { position: absolute; left: 0; right: 0; bottom: 0; max-height: 78vh; display: flex; flex-direction: column; background: var(--surface-container); border-radius: 32rpx 32rpx 0 0; padding-bottom: env(safe-area-inset-bottom); transform: translateY(100%); transition: transform 0.3s ease; }
.pf-bp-overlay.pf-bp-show .pf-bp-panel { transform: translateY(0); }
.pf-bp-grabber { width: 72rpx; height: 8rpx; border-radius: 4rpx; background: var(--outline-variant); margin: 16rpx auto 8rpx; }
.pf-bp-header { display: flex; align-items: center; padding: 8rpx 32rpx 16rpx; }
.pf-bp-header-main { flex: 1; display: flex; flex-direction: column; }
.pf-bp-title { font-size: 32rpx; font-weight: 700; color: var(--on-surface); }
.pf-bp-sub { font-size: 22rpx; color: var(--on-surface-variant); margin-top: 4rpx; }
.pf-bp-info-btn { width: 56rpx; height: 56rpx; border-radius: 50%; display: flex; align-items: center; justify-content: center; background: var(--surface-container-high); margin-right: 16rpx; }
.pf-bp-info-icon { font-size: 30rpx; color: var(--primary); font-weight: 700; }
.pf-bp-close { width: 56rpx; height: 56rpx; border-radius: 50%; display: flex; align-items: center; justify-content: center; background: var(--surface-container-high); }
.pf-bp-close text { font-size: 26rpx; color: var(--on-surface-variant); }
.pf-bp-rules { margin: 0 32rpx 16rpx; padding: 20rpx 24rpx; border-radius: var(--radius-md); background: var(--secondary-fixed); display: flex; flex-direction: column; gap: 8rpx; }
.pf-bp-rules-title { font-size: 24rpx; font-weight: 700; color: var(--on-surface); }
.pf-bp-rules-text { font-size: 22rpx; line-height: 1.6; color: var(--on-surface-variant); }
.pf-bp-scroll { flex: 1; min-height: 0; max-height: 56vh; }
.pf-bp-grid { display: flex; flex-wrap: wrap; gap: 20rpx; padding: 8rpx 32rpx 40rpx; }
.pf-bp-card { width: calc((100% - 20rpx) / 2); box-sizing: border-box; padding: 24rpx; border-radius: var(--radius-lg); background: var(--surface-container-lowest); box-shadow: var(--shadow-card); display: flex; flex-direction: column; }
.pf-bp-card-locked { opacity: 0.75; }
.pf-bp-card-top { display: flex; align-items: center; justify-content: space-between; }
.pf-bp-lit-chip { padding: 6rpx 14rpx; border-radius: 999rpx; background: var(--primary-fixed); }
.pf-bp-lit-chip text { font-size: 20rpx; font-weight: 700; color: var(--on-primary-fixed); }
.pf-bp-unlit-chip { padding: 6rpx 14rpx; border-radius: 999rpx; background: var(--surface-container-high); }
.pf-bp-unlit-chip text { font-size: 20rpx; color: var(--outline); }
.pf-bp-name { font-size: 28rpx; font-weight: 700; color: var(--on-surface); margin-top: 20rpx; }
.pf-bp-desc { font-size: 22rpx; line-height: 1.5; color: var(--on-surface-variant); margin-top: 8rpx; }
.pf-bp-progress-wrap { margin-top: 20rpx; display: flex; flex-direction: column; gap: 8rpx; }
.pf-bp-progress-track { height: 12rpx; border-radius: 6rpx; background: var(--surface-container-high); overflow: hidden; }
.pf-bp-progress-fill { height: 100%; border-radius: 6rpx; background: var(--primary); }
.pf-bp-progress-val { font-size: 20rpx; color: var(--on-surface-variant); }

/* 徽章图标底色补齐（手气王） */
.pf-badge-icon-amber { background: #f6eedc; }
