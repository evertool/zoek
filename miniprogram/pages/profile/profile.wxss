/* pages/profile/profile.wxss */
.profile-card {
  text-align: center;
  padding: 48rpx 32rpx;
}

.profile-avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--color-primary), #FF6B47);
  color: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 56rpx;
  font-weight: 700;
  margin: 0 auto 24rpx;
}

.profile-name {
  font-size: 36rpx;
  font-weight: 600;
}

.edit-area {
  margin-top: 16rpx;
}

.nickname-input {
  border: 2rpx solid var(--color-primary);
  border-radius: 12rpx;
  padding: 16rpx 24rpx;
  font-size: 30rpx;
  text-align: center;
  margin-bottom: 16rpx;
}

.edit-actions {
  display: flex;
  gap: 16rpx;
  justify-content: center;
}

.mini-btn {
  font-size: 26rpx;
  padding: 12rpx 32rpx;
  border-radius: 8rpx;
  line-height: 1.5;
  width: auto;
  display: inline-block;
}

.mini-save {
  background: var(--color-primary);
  color: #FFF;
}

.mini-cancel {
  background: #E0E0E0;
  color: var(--color-text);
}

.menu-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 0;
  font-size: 30rpx;
}

.about-card .text-secondary {
  font-size: 26rpx;
}
