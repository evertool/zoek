<!--pages/index/index.wxml — 首页 v6 Stitch 100% 还原-->
<view class="page">
  <!-- ===== 未登录：品牌开屏页 ===== -->
  <view class="login-hero" wx:if="{{!isLoggedIn}}">
    <view class="tile-rain-area">
      <view class="lottie-wrap" wx:if="{{!lottieError}}">
        <canvas id="lottie-login" type="2d" class="lottie-canvas"></canvas>
      </view>
      <view class="tile-rain-stage">
        <view class="hero-aura"></view>
        <view class="mj-tile rain-tile rain-tile-1 mj-tile-green anim-drop-1">發</view>
        <view class="mj-tile rain-tile rain-tile-2 mj-tile-red anim-drop-2">中</view>
        <view class="mj-tile rain-tile rain-tile-3 mj-tile-blank anim-drop-3"><view class="blank-inner"></view></view>
        <view class="mj-tile rain-tile rain-tile-4 mj-tile-gold anim-drop-4">南</view>
        <view class="mj-tile rain-tile rain-tile-5 mj-tile-ink anim-drop-5">北</view>
        <view class="mj-tile rain-tile rain-tile-6 mj-tile-blue anim-drop-6">東</view>
      </view>
    </view>
    <view class="hero-brand anim-fade-up delay-5">得闲开台</view>
    <view class="hero-slogan anim-fade-up delay-6">粤语麻雀记分神器</view>
    <!-- <view class="hero-sub anim-fade-up delay-7">自己记自己嘅分，零和校验唔使争拗</view> -->
    <view class="login-btn-wrap anim-fade-up delay-8">
      <button class="btn-primary login-btn" bindtap="doLogin">微信授权</button>
    </view>
    <view class="hero-footer anim-fade-up delay-8">
      <view class="footer-line"></view>
      <text class="footer-text">雀友一齐打，分数唔用争</text>
      <view class="footer-line"></view>
    </view>
  </view>

  <!-- ===== 已登录但缺头像/昵称：强制完善资料页 ===== -->
  <view class="profile-gate" style="padding-top: {{navPadding}}px;" wx:elif="{{needProfile}}">
    <view class="gate-hero">
      <view class="gate-logo"><image class="gate-logo-icon" src="/assets/icons/app-icon-hongzhong.svg" mode="aspectFit" /></view>
      <view class="gate-title">得闲开台</view>
      <view class="gate-subtitle">开台之前，先俾雀友认得你</view>
    </view>
    <view class="gate-card">
      <view class="gate-card-title">完善资料</view>

      <!-- 微信头像选择 -->
      <view class="avatar-chooser-wrap">
        <button class="avatar-chooser" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">
          <image class="avatar-img" src="{{tempAvatar}}" mode="aspectFill" wx:if="{{tempAvatar}}" />
          <view class="avatar-placeholder" wx:else>
            <text class="avatar-placeholder-icon">+</text>
            <text class="avatar-placeholder-text">选头像</text>
          </view>
        </button>
      </view>

      <!-- 微信昵称输入 -->
      <input class="text-input" type="nickname" placeholder="输入昵称" placeholder-class="input-placeholder" value="{{tempNickname}}" bindinput="onNicknameInput" maxlength="20" />

      <!-- 保存按钮 -->
      <button class="btn-primary save-profile-btn {{!tempAvatar || !tempNickname ? 'btn-disabled' : ''}}" bindtap="doSaveProfile" disabled="{{!tempAvatar || !tempNickname}}">保存资料</button>
    </view>
    <view class="gate-footer">
      <view class="footer-line"></view>
      <text class="footer-text">头像昵称仅雀友可见</text>
      <view class="footer-line"></view>
    </view>
  </view>

  <!-- ===== 已登录且资料完整：牌局页 ===== -->
  <block wx:else>
    <!-- 主内容区 -->
    <view class="main-content" style="padding-top: {{navPadding}}px;">
      <!-- 开台入口卡 -->
      <view class="create-card anim-fade-up delay-2" bindtap="goCreate">
        <view class="create-card-top">
          <view class="create-info">
            <view class="create-title">一键快速开台</view>
            <view class="create-desc">无需复杂设置 · 扫码秒速入座</view>
          </view>
          <view class="create-icon">
            <image class="create-icon-img" src="/assets/icons/table-settle.svg" mode="aspectFit" />
          </view>
        </view>
        <view class="create-btn-wrap">
          <view class="create-btn">
            <image class="create-btn-icon" src="/assets/icons/stepper-plus-on-primary.svg" mode="aspectFit" />
            <text class="create-btn-text">即刻开台</text>
          </view>
        </view>
      </view>

      <!-- 进行中牌局 -->
      <block>
        <view class="section-header anim-fade-up delay-3" wx:if="{{games.length > 0}}">
          <view class="section-left">
            <text class="section-title">当前牌局</text>
            <view class="tag tag-active"><view class="tag-dot"></view><text>进行中</text></view>
          </view>
          <!-- <text class="section-sub">东风局</text> -->
        </view>

        <view class="game-card anim-fade-up" wx:for="{{games}}" wx:key="game_id" bindtap="goRoom" data-id="{{item.game_id}}">
          <view class="game-card-inner">
            <view class="game-card-header">
              <view class="game-card-title-row">
                <view class="game-card-dot"></view>
                <text class="game-card-name">{{item.name || '未命名牌局'}}</text>
              </view>
              <text class="game-card-time">{{item.durationText}}</text>
            </view>
            <view class="seat-grid">
              <view class="seat-cell" wx:for="{{item.seatPlayers}}" wx:for-item="player" wx:key="seat">
                <block wx:if="{{!player.empty}}">
                  <view class="seat-avatar-wrap">
                    <image class="seat-avatar" src="{{player.avatar_url}}" mode="aspectFill" wx:if="{{player.avatar_url}}" />
                    <view class="seat-avatar seat-avatar-placeholder" wx:else>{{player.nickname[0]}}</view>
                    <image class="seat-wind-svg seat-wind-{{player.windClass}}" src="/assets/icons/seat-wind-{{player.windClass}}.svg" mode="aspectFit" wx:if="{{player.windClass}}" />
                  </view>
                  <text class="seat-name">{{player.nickname}}</text>
                  <view class="seat-score seat-score-{{player.scoreClass}}">{{player.scoreText}}</view>
                </block>
                <block wx:else>
                  <view class="seat-avatar-wrap">
                    <view class="seat-avatar seat-avatar-empty"><image class="seat-empty-icon" src="/assets/icons/table-seat-empty-add.svg" mode="aspectFit" /></view>
                    <image class="seat-wind-svg seat-wind-{{player.windClass}}" src="/assets/icons/seat-wind-{{player.windClass}}.svg" mode="aspectFit" wx:if="{{player.windClass}}" />
                  </view>
                  <text class="seat-name text-secondary">虚位以待</text>
                  <view class="seat-score seat-score-pending">待加入</view>
                </block>
              </view>
            </view>
            <view class="game-card-actions" wx:if="{{item.canInvite}}">
              <button class="game-action-btn game-action-secondary game-action-share" open-type="share" catchtap="onCardInvite" data-id="{{item.game_id}}">
                <image class="game-action-icon" src="/assets/icons/share-wechat.svg" mode="aspectFit" /><text>邀请雀友</text>
              </button>
            </view>
          </view>
        </view>

        <view class="empty-card anim-fade-up delay-4" wx:if="{{games.length === 0 && !loading}}">
          <view class="empty-icon-wrap"><text class="empty-icon-symbol">闲</text></view>
          <view class="empty-text">未有进行中嘅牌局</view>
          <view class="text-secondary" style="margin-top: 8rpx;">点击上方开台开始新的牌局</view>
        </view>
      </block>

      <!-- 最近战绩（真实数据） -->
      <view class="recent-section" wx:if="{{recent.length > 0}}">
        <view class="section-header">
          <text class="section-title">最近战绩</text>
          <view class="recent-more" bindtap="goHistory"><text class="recent-more-text">全部记录</text><text class="recent-more-arrow">›</text></view>
        </view>
        <view class="recent-card">
          <block wx:for="{{recent}}" wx:for-item="rec" wx:key="game_id">
            <view class="recent-divider" wx:if="{{index > 0}}"></view>
            <view class="recent-item" bindtap="goRecentDetail" data-id="{{rec.game_id}}">
              <view class="recent-item-icon {{rec.my_score >= 0 ? 'recent-item-icon-win' : 'recent-item-icon-loss'}}"><image src="{{rec.my_rank === 1 ? '/assets/icons/rank-1-god-crown.svg' : '/assets/icons/rank-4-facai.svg'}}" mode="aspectFit" /></view>
              <view class="recent-item-info">
                <text class="recent-item-name">{{rec.name}}</text>
                <text class="recent-item-sub">{{rec.timeText}} · 对局: {{rec.playersText}}</text>
              </view>
              <view class="recent-item-score">
                <text class="recent-score-val {{rec.my_score >= 0 ? 'text-positive' : 'text-negative'}}">{{rec.my_score >= 0 ? '+' : ''}}{{rec.my_score}}</text>
                <text class="recent-score-rank">第 {{rec.my_rank}} 名 · {{rec.resultText}}</text>
              </view>
            </view>
          </block>
        </view>
      </view>
    </view>
  </block>
</view>
