/* pages/index/index.wxss */

/* 登录/授权页 */
.auth-page {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 160rpx 48rpx 0;
}

.auth-logo {
  font-size: 120rpx;
  margin-bottom: 24rpx;
}

.auth-title {
  font-size: 48rpx;
  font-weight: 700;
  color: var(--color-text);
}

.auth-desc {
  font-size: 28rpx;
  color: var(--color-text-secondary);
  margin-top: 12rpx;
}

.auth-form {
  width: 100%;
  margin-top: 64rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.avatar-picker {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  padding: 0;
  overflow: hidden;
  background: var(--color-divider);
  border: 2rpx solid var(--color-border);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 40rpx;
}

.avatar-picker::after { border: none; }

.avatar-picker image {
  width: 100%;
  height: 100%;
}

.avatar-placeholder {
  font-size: 24rpx;
  color: var(--color-text-secondary);
}

.nickname-row {
  width: 100%;
  margin-bottom: 40rpx;
}

.nickname-input {
  text-align: center;
}

/* 开台按钮 */
.hero-bar {
  display: flex;
  align-items: center;
  background: var(--color-primary);
  border-radius: var(--radius-lg);
  padding: 32rpx;
  margin-bottom: 32rpx;
  box-shadow: var(--shadow-md);
}

.hero-icon {
  font-size: 48rpx;
  margin-right: 24rpx;
}

.hero-text {
  flex: 1;
}

.hero-title {
  color: #FFFFFF;
  font-size: 34rpx;
  font-weight: 600;
}

.hero-sub {
  color: rgba(255,255,255,0.6);
  font-size: 24rpx;
  margin-top: 4rpx;
}

.hero-arrow {
  color: rgba(255,255,255,0.6);
  font-size: 40rpx;
}

/* 牌局卡片 */
.game-card {
  display: flex;
  align-items: center;
  background: var(--color-card);
  border-radius: var(--radius-lg);
  padding: 28rpx 32rpx;
  margin-bottom: 16rpx;
  box-shadow: var(--shadow-sm);
}

.game-card-main {
  flex: 1;
}

.game-card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}

.game-card-name {
  font-size: 32rpx;
  font-weight: 600;
}

.game-card-info {
  display: flex;
  align-items: center;
}

.game-card-delete {
  flex-shrink: 0;
  margin-left: 16rpx;
  padding: 12rpx 24rpx;
  background: #FCE4E4;
  color: #B33A3A;
  font-size: 24rpx;
  border-radius: 100rpx;
}
