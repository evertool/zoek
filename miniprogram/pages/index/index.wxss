/* pages/index/index.wxss — 首页 v6 Stitch 100% 还原 */

.page { min-height: 100vh; background: var(--background); padding-bottom: 160rpx; }

/* ========== 未登录 ========== */
.login-hero { min-height: 90vh; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; padding: 60rpx 24rpx; }
.tile-rain-area { width: 500rpx; height: 360rpx; margin-bottom: 48rpx; position: relative; display: flex; align-items: center; justify-content: center; }
.lottie-wrap { position: absolute; top: 0; left: 50%; transform: translateX(-50%); width: 400rpx; height: 300rpx; opacity: 0.3; z-index: 0; }
.lottie-canvas { width: 400rpx; height: 300rpx; }
.tile-rain-stage { position: relative; width: 500rpx; height: 360rpx; }
.hero-aura { position: absolute; top: 50%; left: 50%; width: 320rpx; height: 320rpx; transform: translate(-50%, -50%); background: radial-gradient(circle, rgba(0,82,53,0.08) 0%, transparent 70%); border-radius: 50%; animation: pulse 3s ease-in-out infinite; }
.rain-tile { position: absolute; width: 100rpx; height: 132rpx; font-size: 48rpx; z-index: 2; }
.rain-tile-1 { left: 60rpx; top: 180rpx; }
.rain-tile-2 { left: 140rpx; top: 200rpx; }
.rain-tile-3 { left: 240rpx; top: 190rpx; }
.rain-tile-4 { left: 80rpx; top: 220rpx; }
.rain-tile-5 { left: 320rpx; top: 210rpx; }
.rain-tile-6 { left: 200rpx; top: 170rpx; }

@keyframes drop-from-top-1 { 0%{transform:translate(0,-400rpx) rotate(-180deg) scale(0.7);opacity:0} 10%{opacity:1} 35%{transform:translate(0,0) rotate(-360deg) scale(1.15,0.8)} 45%{transform:translate(0,-35rpx) rotate(-340deg) scale(0.9,1.1)} 60%{transform:translate(0,0) rotate(-350deg) scale(1.05,0.95)} 75%{transform:translate(0,-12rpx) rotate(-348deg) scale(0.97,1.03)} 90%{transform:translate(0,0) rotate(-350deg) scale(1.02,0.98)} 100%{transform:translate(0,0) rotate(-350deg) scale(1,1)} }
.anim-drop-1 { animation: drop-from-top-1 2.5s cubic-bezier(0.25,0.1,0.25,1) both; }
@keyframes fly-from-left-top { 0%{transform:translate(-300rpx,-150rpx) rotate(180deg) scale(0.7);opacity:0} 10%{opacity:1} 40%{transform:translate(0,0) rotate(360deg) scale(1.15,0.8)} 50%{transform:translate(0,-30rpx) rotate(350deg) scale(0.9,1.1)} 65%{transform:translate(0,0) rotate(355deg) scale(1.05,0.95)} 80%{transform:translate(0,-10rpx) rotate(353deg) scale(0.97,1.03)} 100%{transform:translate(0,0) rotate(353deg) scale(1,1)} }
.anim-drop-2 { animation: fly-from-left-top 2.5s cubic-bezier(0.25,0.1,0.25,1) 0.2s both; }
@keyframes fly-from-right-top { 0%{transform:translate(300rpx,-150rpx) rotate(90deg) scale(0.7);opacity:0} 10%{opacity:1} 40%{transform:translate(0,0) rotate(270deg) scale(1.15,0.8)} 50%{transform:translate(0,-30rpx) rotate(255deg) scale(0.9,1.1)} 65%{transform:translate(0,0) rotate(262deg) scale(1.05,0.95)} 80%{transform:translate(0,-10rpx) rotate(260deg) scale(0.97,1.03)} 100%{transform:translate(0,0) rotate(262deg) scale(1,1)} }
.anim-drop-3 { animation: fly-from-right-top 2.5s cubic-bezier(0.25,0.1,0.25,1) 0.4s both; }
@keyframes fly-from-left-bottom { 0%{transform:translate(-350rpx,200rpx) rotate(-90deg) scale(0.7);opacity:0} 10%{opacity:1} 40%{transform:translate(0,0) rotate(-270deg) scale(1.15,0.8)} 50%{transform:translate(0,-25rpx) rotate(-255deg) scale(0.9,1.1)} 65%{transform:translate(0,0) rotate(-262deg) scale(1.05,0.95)} 80%{transform:translate(0,-8rpx) rotate(-260deg) scale(0.97,1.03)} 100%{transform:translate(0,0) rotate(-262deg) scale(1,1)} }
.anim-drop-4 { animation: fly-from-left-bottom 2.5s cubic-bezier(0.25,0.1,0.25,1) 0.6s both; }
@keyframes fly-from-right-bottom { 0%{transform:translate(350rpx,200rpx) rotate(45deg) scale(0.7);opacity:0} 10%{opacity:1} 40%{transform:translate(0,0) rotate(225deg) scale(1.15,0.8)} 50%{transform:translate(0,-25rpx) rotate(210deg) scale(0.9,1.1)} 65%{transform:translate(0,0) rotate(217deg) scale(1.05,0.95)} 80%{transform:translate(0,-8rpx) rotate(215deg) scale(0.97,1.03)} 100%{transform:translate(0,0) rotate(215deg) scale(1,1)} }
.anim-drop-5 { animation: fly-from-right-bottom 2.5s cubic-bezier(0.25,0.1,0.25,1) 0.8s both; }
@keyframes drop-from-top-6 { 0%{transform:translate(0,-500rpx) rotate(360deg) scale(0.7);opacity:0} 10%{opacity:1} 35%{transform:translate(0,0) rotate(180deg) scale(1.15,0.8)} 45%{transform:translate(0,-40rpx) rotate(200deg) scale(0.9,1.1)} 60%{transform:translate(0,0) rotate(190deg) scale(1.05,0.95)} 75%{transform:translate(0,-15rpx) rotate(193deg) scale(0.97,1.03)} 90%{transform:translate(0,0) rotate(192deg) scale(1.02,0.98)} 100%{transform:translate(0,0) rotate(192deg) scale(1,1)} }
.anim-drop-6 { animation: drop-from-top-6 2.5s cubic-bezier(0.25,0.1,0.25,1) 1s both; }

.hero-brand { font-size: 68rpx; font-weight: 800; letter-spacing: 12rpx; color: var(--on-surface); }
.hero-slogan { margin-top: 24rpx; font-size: 34rpx; font-weight: 700; color: var(--primary); letter-spacing: 4rpx; }
.hero-sub { margin-top: 12rpx; font-size: 25rpx; color: var(--on-surface-variant); letter-spacing: 1rpx; }
.login-btn-wrap { margin-top: 80rpx; width: 100%; }
.login-btn { display: flex; align-items: center; justify-content: center; }
.hero-footer { display: flex; align-items: center; justify-content: center; margin-top: 64rpx; gap: 24rpx; }
.footer-line { width: 80rpx; height: 2rpx; background: linear-gradient(90deg, transparent, var(--outline), transparent); }
.footer-text { font-size: 22rpx; color: var(--outline); letter-spacing: 2rpx; }

/* ========== 主内容 ========== */
.main-content { padding-left: var(--margin-screen); padding-right: var(--margin-screen); display: flex; flex-direction: column; gap: var(--space-xl); }

/* ========== 强制完善资料页 ========== */
.profile-gate { min-height: 100vh; display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 0 48rpx 60rpx; text-align: center; box-sizing: border-box; }
.gate-hero { display: flex; flex-direction: column; align-items: center; margin-bottom: 48rpx; }
.gate-logo { width: 120rpx; height: 120rpx; border-radius: var(--radius-full); background: var(--primary); display: flex; align-items: center; justify-content: center; box-shadow: 0 12rpx 32rpx rgba(0, 82, 53, 0.18); }
.gate-logo-icon { width: 72rpx; height: 72rpx; }
.gate-title { margin-top: 24rpx; font-size: 56rpx; font-weight: 800; letter-spacing: 8rpx; color: var(--on-surface); }
.gate-subtitle { margin-top: 12rpx; font-size: 28rpx; font-weight: 700; color: var(--primary); letter-spacing: 2rpx; }
.gate-card { width: 100%; background: var(--surface-container-lowest); border-radius: var(--radius-lg); padding: 48rpx 40rpx; box-shadow: var(--shadow-card); }
.gate-card-title { font-size: 36rpx; font-weight: 700; color: var(--on-surface); margin-bottom: 28rpx; }
.gate-footer { margin-top: 56rpx; display: flex; align-items: center; gap: 20rpx; }
.avatar-chooser-wrap { width: 148rpx; height: 148rpx; margin: 0 auto 28rpx; padding: 0; border-radius: 50%; background: linear-gradient(145deg, var(--primary-fixed), var(--surface-container-lowest)); box-shadow: 0 8rpx 24rpx rgba(0,82,53,0.12); display: flex; align-items: center; justify-content: center; box-sizing: border-box; overflow: hidden; }
.avatar-chooser { display: flex !important; width: 148rpx !important; height: 148rpx !important; padding: 0 !important; margin: 0 !important; background: transparent !important; border: none; border-radius: 50%; overflow: hidden; line-height: 0; box-sizing: border-box; align-items: center; justify-content: center; }
.avatar-chooser::after { border: none; transform: scale(1); }
.avatar-img { width: 148rpx; height: 148rpx; border-radius: 50%; display: block; object-fit: cover; }
.avatar-placeholder { width: 148rpx; height: 148rpx; border-radius: 50%; box-sizing: border-box; display: flex; flex-direction: column; align-items: center; justify-content: center; background: var(--primary-fixed); line-height: 1; }
.avatar-placeholder-icon { font-size: 44rpx; color: var(--primary); line-height: 1; }
.avatar-placeholder-text { font-size: 22rpx; color: var(--on-primary-fixed-variant); margin-top: 4rpx; }
.text-input { background: var(--surface-container-low); border: 2rpx solid var(--outline-variant); border-radius: var(--radius-default); padding: 22rpx 26rpx; font-size: 30rpx; color: var(--on-surface); margin-bottom: 32rpx; }
.input-placeholder { color: var(--outline); }
.save-profile-btn { margin-top: 8rpx; }
.btn-disabled { opacity: 0.4; box-shadow: none; }
.nickname-preview { font-size: 32rpx; font-weight: 700; color: var(--on-surface); margin-bottom: 24rpx; text-align: center; }
.wechat-profile-btn { margin-bottom: 20rpx; background: var(--surface-container); color: var(--on-surface); box-shadow: none; border: 2rpx solid var(--outline-variant); }

/* ========== 开台卡 ========== */
.create-card { background: var(--surface-container-lowest); border-radius: var(--radius-lg); padding: var(--space-xl); box-shadow: var(--shadow-card); transition: all 0.25s cubic-bezier(0,0,0.2,1); overflow: hidden; }
.create-card:active { transform: scale(0.98); }
.create-card-top { display: flex; align-items: center; justify-content: space-between; margin-bottom: var(--space-md); }
.create-info { display: flex; flex-direction: column; gap: 8rpx; }
.create-title { font-size: 40rpx; font-weight: 700; color: var(--on-surface); letter-spacing: -1rpx; }
.create-desc { font-size: 24rpx; color: var(--on-surface-variant); }
.create-icon { width: 96rpx; height: 96rpx; border-radius: var(--radius-default); background: var(--primary-fixed); display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
.create-icon-img { width: 48rpx; height: 48rpx; }
.create-btn-wrap { display: flex; gap: var(--space-xs); }
.create-btn { flex: 1; height: 96rpx; border-radius: var(--radius-md); background: var(--primary); color: var(--on-primary); display: flex; align-items: center; justify-content: center; gap: var(--space-xs); font-size: 28rpx; font-weight: 600; box-shadow: var(--shadow-card); }
.create-btn:active { opacity: 0.9; }
.create-btn-icon { width: 32rpx; height: 32rpx; }
.create-btn-text { font-size: 28rpx; }

/* ========== 区块头 ========== */
.section-header { display: flex; align-items: center; justify-content: space-between; padding: 0 8rpx; }
.section-left { display: flex; align-items: center; gap: var(--space-xs); }
.section-title { font-size: 28rpx; font-weight: 600; color: var(--on-surface); }
.tag-dot { width: 8rpx; height: 8rpx; border-radius: 50%; background: var(--primary); animation: pulse 2s ease-in-out infinite; }
.section-sub { font-size: 24rpx; color: var(--on-surface-variant); }

/* ========== 游戏卡 ========== */
.game-card { background: var(--surface-container-lowest); border-radius: var(--radius-lg); padding: var(--space-lg); box-shadow: var(--shadow-card); transition: all 0.2s cubic-bezier(0,0,0.2,1); }
.game-card:active { transform: scale(0.98); }
.game-card-inner { display: flex; flex-direction: column; gap: var(--space-md); }
.game-card-header { display: flex; align-items: center; justify-content: space-between; }
.game-card-title-row { display: flex; align-items: center; gap: var(--space-xs); }
.game-card-dot { width: 16rpx; height: 16rpx; border-radius: 50%; background: var(--secondary-container); }
.game-card-name { font-size: 36rpx; font-weight: 600; color: var(--on-surface); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.game-card-time { font-size: 24rpx; color: var(--on-surface-variant); flex-shrink: 0; }

/* ========== 座位 ========== */
.seat-grid { display: grid; grid-template-columns: repeat(4,1fr); gap: var(--gutter-grid); }
.seat-cell { display: flex; flex-direction: column; align-items: center; gap: 8rpx; }
.seat-avatar-wrap { position: relative; width: 96rpx; height: 96rpx; }
.seat-avatar { width: 96rpx; height: 96rpx; border-radius: 50%; background: var(--surface-container); box-shadow: var(--shadow-card); }
.seat-avatar-placeholder { display: flex; align-items: center; justify-content: center; font-size: 32rpx; font-weight: 600; color: var(--on-surface); }
.seat-wind-svg { width: 32rpx; height: 32rpx; position: absolute; bottom: 0; right: 0; }
.seat-wind-east { background: var(--primary); color: var(--on-primary); }
.seat-wind-south, .seat-wind-west, .seat-wind-north { background: var(--surface-container-highest); color: var(--on-surface-variant); }
.seat-name { font-size: 24rpx; font-weight: 500; color: var(--on-surface); text-align: center; width: 100%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.seat-score { font-size: 24rpx; font-weight: 700; padding: 4rpx 16rpx; border-radius: var(--radius-full); background: var(--primary-fixed); color: var(--on-primary-fixed-variant); }
.seat-score-positive { background: rgba(166,243,201,0.5); color: var(--primary); }
.seat-score-negative { background: rgba(255,218,214,0.6); color: var(--tertiary); }
.seat-score-pending { background: var(--surface-container); color: var(--on-surface-variant); font-weight: 500; }
.seat-empty .seat-avatar-empty { background: var(--surface-container-low); display: flex; align-items: center; justify-content: center; }
.seat-empty-icon { width: 44rpx; height: 44rpx; }

/* ========== 游戏卡操作 ========== */
.game-card-actions { display: flex; gap: var(--space-sm); padding-top: var(--space-xs); }
.game-action-btn { flex: 1; height: 88rpx; border-radius: var(--radius-md); display: flex; align-items: center; justify-content: center; gap: 8rpx; font-size: 28rpx; font-weight: 600; }
.game-action-secondary { background: var(--surface-container); color: var(--on-surface); }
.game-action-primary { background: var(--primary); color: var(--on-primary); box-shadow: var(--shadow-card); }
.game-action-btn:active { opacity: 0.9; transform: scale(0.98); }
.game-action-icon { width: 28rpx; height: 28rpx; }

/* ========== 空状态 ========== */
.empty-card { background: var(--surface-container-lowest); border-radius: var(--radius-lg); padding: 80rpx 40rpx; text-align: center; box-shadow: var(--shadow-card); }
.empty-icon-wrap { width: 120rpx; height: 160rpx; margin: 0 auto 28rpx; display: flex; align-items: center; justify-content: center; background: linear-gradient(145deg,#ffffff 0%,#f5f0e6 60%,#e8dfd0 100%); border-radius: 18%; box-shadow: 0 8rpx 24rpx rgba(26,26,46,0.08); }
.recent-item-icon image { width: 36rpx; height: 36rpx; }
.empty-text { font-size: 30rpx; font-weight: 500; color: var(--on-surface); margin-bottom: 8rpx; }

/* ========== 最近战绩 ========== */
.recent-section { display: flex; flex-direction: column; gap: var(--space-sm); }
.recent-more { display: flex; align-items: center; gap: 4rpx; }
.recent-more-text { font-size: 24rpx; color: var(--primary); }
.recent-more-arrow { font-size: 24rpx; color: var(--primary); }
.recent-card { background: var(--surface-container-lowest); border-radius: var(--radius-lg); padding: var(--space-md); box-shadow: var(--shadow-card); display: flex; flex-direction: column; }
.recent-item { display: flex; align-items: center; justify-content: space-between; padding: var(--space-xs) 0; }
.recent-item-icon { width: 80rpx; height: 80rpx; border-radius: var(--radius-default); display: flex; align-items: center; justify-content: center; font-size: 36rpx; flex-shrink: 0; background: var(--surface-container); }
.recent-item-info { flex: 1; min-width: 0; margin-left: var(--space-sm); }
.recent-item-name { font-size: 28rpx; color: var(--on-surface); display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.recent-item-sub { font-size: 24rpx; color: var(--on-surface-variant); display: block; }
.recent-item-score { display: flex; flex-direction: column; align-items: flex-end; flex-shrink: 0; padding-left: var(--space-xs); }
.recent-score-val { font-size: 36rpx; font-weight: 700; }
.recent-score-rank { font-size: 24rpx; color: var(--on-surface-variant); }
.recent-divider { height: 2rpx; background: var(--surface-container-high); margin: 0 var(--space-md); }

/* 邀请雀友分享按钮（重置 button 默认样式） */
.game-action-share { margin: 0; background: inherit; line-height: inherit; }
.game-action-share::after { border: none; }
