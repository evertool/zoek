<!--pages/room/room.wxml — 台间页 v6 Stitch 100% 还原-->
<view class="page" wx:if="{{game}}">
  <!-- 主内容 -->
  <view class="main-content" style="padding-top: {{navPadding}}px;">
    <!-- 顶部状态栏 -->
    <view class="room-status-bar">
      <view class="room-status-left">
        <view class="nav-back-btn" bindtap="goBack">
          <image class="nav-back-icon" src="/assets/icons/nav-back.svg" mode="aspectFit" />
        </view>
        <view class="status-pill">
          <view class="status-dot {{game.status === 'forming' ? 'status-dot-active' : ''}}"></view>
          <text>{{game.statusText}} ({{players.length}}/4人)</text>
        </view>
      </view>
      <view class="qr-show-btn" bindtap="toggleQrModal">
        <image class="qr-show-icon" src="/assets/icons/table-qrcode.svg" mode="aspectFit" />
        <text class="qr-show-text">出示台码</text>
      </view>
    </view>

    <!-- 2×2 座位网格 -->
    <view class="seat-grid-2x2">
      <!-- 东位（台主） -->
      <view class="seat-card-2x2" wx:for="{{seats}}" wx:key="seat" data-seat="{{item.seat}}" bindlongpress="onSeatLongPress">
        <view class="seat-card-top">
          <image class="seat-wind-badge-img" src="/assets/icons/seat-wind-{{item.windClass}}.svg" mode="aspectFit" />
          <view class="tag tag-forming" wx:if="{{item.isOwner}}">台主</view>
        </view>
        <view class="seat-player-row">
          <block wx:if="{{item.player}}">
            <image class="seat-player-avatar" src="{{item.player.avatar_url}}" mode="aspectFill" wx:if="{{item.player.avatar_url}}" />
            <view class="seat-player-avatar seat-player-placeholder" wx:else>{{item.player.nickname[0]}}</view>
            <view class="seat-player-info">
              <text class="seat-player-name">{{item.player.nickname}}</text>
            </view>
          </block>
          <block wx:else>
            <view class="seat-player-avatar seat-player-empty"><image class="seat-empty-icon-large" src="/assets/icons/table-seat-empty-add.png" mode="aspectFit" /></view>
            <view class="seat-player-info">
              <text class="seat-player-name text-secondary">虚位以待</text>
            </view>
          </block>
        </view>
        <view class="seat-score-row" wx:if="{{item.player}}">
          <text class="seat-score-label">当前战绩</text>
          <text class="seat-score-val {{item.score >= 0 ? 'text-positive' : 'text-negative'}}">{{item.score >= 0 ? '+' : ''}}{{item.score}}</text>
        </view>
        <view class="seat-score-row" wx:else>
          <text class="seat-score-label text-secondary">计分底数</text>
          <text class="seat-score-val text-secondary">0</text>
        </view>
        <view class="seat-action" wx:if="{{item.player && !item.isOwner}}">
          <view class="seat-action-btn" catchtap="openScoringModal" data-seat="{{item.seat}}" data-name="{{item.player.nickname}}">
            <image class="seat-action-icon" src="/assets/icons/table-balance-zero-sum.png" mode="aspectFit" /><text>比分</text>
          </view>
        </view>
        <view class="seat-action" wx:if="{{!item.player}}">
          <view class="seat-action-btn seat-action-invite" catchtap="shareInvite">
            <image class="seat-action-icon" src="/assets/icons/share-wechat.png" mode="aspectFit" /><text>呼叫雀友</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 即时流水账单 -->
    <view class="ledger-card">
      <view class="ledger-header">
        <image class="ledger-icon" src="/assets/icons/score-statement-history.png" mode="aspectFit" />
        <text class="ledger-title">即时流水账单</text>
        <text class="ledger-count">共 {{ledger.length}} 笔记录</text>
      </view>
      <view class="ledger-list">
        <view class="ledger-item" wx:for="{{ledger}}" wx:key="id">
          <view class="ledger-item-left">
            <view class="ledger-wind ledger-wind-{{item.windClass}}">{{item.wind}}</view>
            <view class="ledger-item-info">
              <view class="ledger-item-title-row">
                <text class="ledger-item-title">{{item.desc}}</text>
                <text class="ledger-item-time">{{item.timeText}}</text>
              </view>
              <text class="ledger-item-sub">{{item.sub}}</text>
            </view>
          </view>
          <view class="ledger-item-right">
            <text class="ledger-item-score {{item.score >= 0 ? 'text-positive' : 'text-negative'}}">{{item.score >= 0 ? '+' : ''}}{{item.score}}</text>
            <text class="ledger-item-status">已入账</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 模态层 1: QR 台码弹窗 -->
  <view class="modal-overlay {{showQrModal ? 'modal-show' : ''}}" bindtap="toggleQrModal">
    <view class="qr-modal-card" catchtap="stopPropagation">
      <view class="qr-modal-header">
        <view>
          <text class="qr-modal-title">扫码加入牌局</text>
          <text class="qr-modal-sub">微信扫一扫 · 自动锁定空位</text>
        </view>
        <view class="modal-close-btn" bindtap="toggleQrModal"><text>✕</text></view>
      </view>
      <view class="qr-modal-body">
        <image class="qr-modal-img" src="{{qrPath}}" mode="aspectFit" wx:if="{{qrPath}}" />
        <view class="qr-modal-img-placeholder" wx:else><text>QR</text></view>
        <text class="qr-modal-num">台号 #{{game.game_id}}</text>
        <text class="qr-modal-tip">永久有效 · 仅限本局同台使用</text>
      </view>
      <view class="qr-modal-btn" bindtap="toggleQrModal"><text>完成</text></view>
    </view>
  </view>

  <!-- 模态层 2: 比分抽屉 -->
  <view class="modal-overlay modal-bottom {{showScoreModal ? 'modal-show' : ''}}">
    <view class="score-sheet" catchtap="stopPropagation">
      <view class="score-sheet-header">
        <view>
          <text class="score-sheet-label">快捷台间记分</text>
          <text class="score-sheet-title">向【{{scoreTargetSeat}}位 · {{scoreTargetName}}】转记分数</text>
        </view>
        <view class="modal-close-btn" bindtap="closeScoringModal"><text>✕</text></view>
      </view>
      <view class="score-quick-grid">
        <view class="score-quick-btn" wx:for="{{[4, 8, 16, 24]}}" wx:key="*this" data-val="{{item}}" bindtap="setScoreValue"><text>+{{item}}</text></view>
      </view>
      <view class="score-stepper">
        <text class="score-stepper-label">入账积分</text>
        <view class="score-stepper-control">
          <view class="stepper-btn" bindtap="adjustScore" data-delta="-2"><text>-</text></view>
          <text class="stepper-val">{{currentScore}}</text>
          <view class="stepper-btn" bindtap="adjustScore" data-delta="2"><text>+</text></view>
        </view>
      </view>
      <view class="score-submit-btn" bindtap="submitScore"><text>确认记入本局流水</text></view>
    </view>
  </view>

  <!-- 模态层 3: 换位确认 -->
  <view class="modal-overlay {{showSwapModal ? 'modal-show' : ''}}" bindtap="closeSwapModal">
    <view class="swap-modal-card" catchtap="stopPropagation">
          <view class="swap-modal-icon"><image src="/assets/icons/seat-swap.png" mode="aspectFit" /></view>
      <text class="swap-modal-title">申请交换座位</text>
      <text class="swap-modal-desc">{{swapTargetText}}</text>
      <view class="swap-modal-tip"><text>对方在手机上点击「同意」后方可互换</text></view>
      <view class="swap-modal-actions">
        <view class="swap-cancel-btn" bindtap="closeSwapModal"><text>取消</text></view>
        <view class="swap-confirm-btn" bindtap="sendSwapRequest"><text>发送申请</text></view>
      </view>
    </view>
  </view>

  <!-- Toast -->
  <view class="toast {{showToast ? 'toast-show' : ''}}">
    <text>{{toastMsg}}</text>
  </view>

  <!-- 底部操作栏 -->
  <view class="room-footer safe-bottom">
    <block wx:if="{{game.status === 'forming'}}">
      <view class="btn-plain-danger" wx:if="{{isOwner}}" bindtap="doCancel"><text>取消开台</text></view>
    </block>
    <block wx:if="{{game.status === 'active'}}">
      <view class="room-actions">
        <view class="btn-primary" bindtap="goScore"><text>入分 / 计分</text></view>
        <view class="btn-secondary" bindtap="goSettlement"><text>查看排名</text></view>
      </view>
      <block wx:if="{{isOwner}}">
        <view class="btn-plain-danger" wx:if="{{!hasScores}}" bindtap="doCancel"><text>取消开台</text></view>
        <view class="btn-plain-danger btn-plain-danger-row" wx:else bindtap="doEnd">
          <image class="btn-plain-danger-icon" src="/assets/icons/action-exit.svg" mode="aspectFit" />
          <text>结束散台</text>
        </view>
      </block>
    </block>
    <block wx:if="{{game.status === 'ended'}}">
      <view class="btn-primary" bindtap="goSettlement"><text>查看找数</text></view>
    </block>
  </view>
</view>
