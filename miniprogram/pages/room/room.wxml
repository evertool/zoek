<!--pages/room/room.wxml — 台间页 v7 环形桌面版（对齐设计稿）-->
<view class="page">
  <!-- 顶栏：返回按钮 + 状态胶囊 + 台码，与右上角系统胶囊同一水平 -->
  <view class="top-bar" style="padding-top: {{capsuleTop}}px;">
    <view class="nav-back-btn" style="width: {{capsuleHeight}}px; height: {{capsuleHeight}}px;" bindtap="goBack">
      <image class="nav-back-img" src="/assets/icons/nav-back.svg" mode="aspectFit" />
    </view>
    <view class="status-pill" wx:if="{{game}}">
      <view class="status-dot {{game.status === 'forming' ? 'status-dot-active' : ''}}"></view>
      <!-- 入座人数取后端的 player_count（只算在座），不能用 players.length——那份含已离座的人 -->
      <text>{{game.statusText}} · {{game.player_count}}/4 入座</text>
    </view>
    <!-- 还能凑脚就出示台码（拉人入台）：牌局进行中 + 成员没锁 + 未满 4 人，判据见 room.js applyGame -->
    <view class="qr-icon-btn" wx:if="{{canInvite}}" bindtap="openQrModal">
      <image class="qr-icon-img" src="/assets/icons/table-qrcode.svg" mode="aspectFit" />
    </view>
  </view>

  <!-- 主内容 -->
  <view class="main-content" style="padding-top: 8rpx;" wx:if="{{game}}">

    <!-- 桌面：4 个等腰梯形（北/东/南/西）由中心圆向外放射，短边贴圆心、长边朝外 -->
    <view class="table-stage {{fx.quake ? 'fx-quake' : ''}}">
      <view class="table-center">
        <view class="table-center-ring"></view>
        <text class="table-center-tile">發</text>
      </view>

      <view class="wind-dot wind-dot-top">南</view>
      <view class="wind-dot wind-dot-left">東</view>
      <view class="wind-dot wind-dot-right">西</view>
      <view class="wind-dot wind-dot-bottom">北</view>

      <view class="table-side side-{{item.pos}}"
        wx:for="{{seats}}" wx:key="seat" data-seat="{{item.seat}}" bindlongpress="onSeatLongPress">
        <view class="side-fill {{fx.target === item.pos && fx.hit ? 'fx-hit-shake' : ''}} {{fx.target === item.pos && fx.kicked ? 'fx-avatar-kick' : ''}} {{fx.target === item.pos && fx.tomatoHeavy ? 'fx-tomato-heavy' : ''}}">
          <view class="side-body {{item.player ? '' : 'side-body-empty'}}">
            <block wx:if="{{item.player}}">
              <view class="seat-head">
                <view class="seat-avatar-wrap">
                  <image class="seat-avatar" src="{{item.player.avatar_url}}" mode="aspectFill" wx:if="{{item.player.avatar_url}}" />
                  <view class="seat-avatar seat-avatar-ph" wx:else>{{item.player.nickname[0]}}</view>
                  <!-- 脸上流淌番茄酱层（丢番茄命中后显现） -->
                  <view class="face-sauce {{fx.sauceTarget === item.pos ? 'fx-sauce-on' : ''}}">
                    <image src="/assets/icons/fx-tomato-face.svg" mode="aspectFill" />
                  </view>
                </view>
                <view class="seat-meta">
                  <view class="seat-owner-tag" wx:if="{{item.isOwner}}">台主</view>
                  <text class="seat-name">{{item.player.nickname}}</text>
                </view>
              </view>
              <text class="seat-score {{item.score >= 0 ? 'text-positive' : 'text-negative'}}">{{item.score >= 0 ? '+' : ''}}{{item.score}}</text>
              <!-- 给分：我出分、对方得分（自己那一席不给分） -->
              <view class="give-btn" wx:if="{{!item.isSelf}}" catchtap="openScoringModal"
                data-seat="{{item.seat}}" data-name="{{item.player.nickname}}" data-player-id="{{item.player.player_id}}">
                <text class="give-btn-plus">＋</text><text>给分</text>
              </view>
              <view class="give-btn give-btn-self" wx:else><text>我</text></view>
            </block>
            <block wx:else>
              <image class="seat-empty-ring" src="/assets/icons/table-seat-empty-add.svg" mode="aspectFit" />
              <text class="seat-empty-text">虚位以待</text>
              <view class="invite-btn" hover-class="invite-btn-active">
                <image class="invite-icon" src="/assets/icons/table-seat-empty-add.svg" mode="aspectFit" />
                <text>呼叫雀友</text>
                <button class="invite-hit" open-type="share"></button>
              </view>
            </block>
          </view>
        </view>
      </view>

      <!-- 席位互动道具 fx 层：只做动画（pointer-events:none，不挡任何操作） -->
      <view class="fx-stage">
        <!-- 扔飞拖鞋 -->
        <block wx:if="{{fx.slipper}}">
          <view class="fx-slipper" style="{{fx.slipper.style}}">
            <view class="fx-slipper-inner">
              <image src="/assets/icons/fx-slipper.svg" mode="aspectFit" />
            </view>
          </view>
        </block>
        <!-- 命中星芒 -->
        <view wx:if="{{fx.stars}}" class="fx-stars {{fx.stars.on ? 'fx-on' : ''}}" style="{{fx.stars.style}}">
          <text class="fx-star">⭐</text>
          <text class="fx-star-b">💥</text>
          <text class="fx-star-c">✨</text>
          <view class="fx-stars-label"><text>嗱嗱声出牌啦，唔好谂咁耐！</text></view>
        </view>
        <!-- 台下猛踢：三重冲击波 + 大脚 + 火花 -->
        <block wx:if="{{fx.kick}}">
          <view class="fx-shock-center" style="{{fx.kick.style}}">
            <view class="fx-shock fx-shock-1 {{fx.kick.run ? 'fx-run-1' : ''}}"></view>
            <view class="fx-shock fx-shock-2 {{fx.kick.run ? 'fx-run-2' : ''}}"></view>
            <view class="fx-shock fx-shock-3 {{fx.kick.run ? 'fx-run-3' : ''}}"></view>
          </view>
          <view class="fx-foot {{fx.kick.run ? 'fx-run' : ''}}" style="left: {{fx.kick.footX}}px; top: {{fx.kick.footY}}px;"><text>🦶</text></view>
          <view class="fx-sparks {{fx.kick.hit ? 'fx-on' : ''}}" style="left: {{fx.kick.cx}}px; top: {{fx.kick.cy}}px;">
            <text>💥</text>
            <text class="fx-spark-b">💢</text>
            <text class="fx-spark-c">⚡</text>
            <text class="fx-spark-tag">CRITICAL HIT!</text>
          </view>
        </block>
        <!-- 花儿谢了 -->
        <block wx:if="{{fx.flower}}">
          <view class="fx-flower {{fx.flower.on ? 'fx-on' : ''}}" style="left: {{fx.flower.x}}px; top: {{fx.flower.y}}px; transform: translateX(-50%);">
            <view class="fx-flower-cloud"><text>🌧️</text><text>☁️</text></view>
            <view class="fx-rain"><view class="r1"></view><view class="r2"></view><view class="r3"></view></view>
            <view class="fx-wind"><view></view><view class="w2"></view></view>
            <view class="fx-flower-stem {{fx.flower.wither ? 'fx-run-droop' : ''}}">
              <text class="fx-flower-head">{{fx.flower.wither ? '🥀' : '🌹'}}</text>
              <view class="fx-stem"></view>
            </view>
            <view class="fx-petals">
              <text class="p1 {{fx.flower.wither ? 'fx-run' : ''}}">🥀</text>
              <text class="p2 {{fx.flower.wither ? 'fx-run' : ''}}">🍂</text>
              <text class="p3 {{fx.flower.wither ? 'fx-run' : ''}}">🍁</text>
            </view>
            <view class="fx-flower-bubble {{fx.flower.bubble ? 'fx-on' : ''}}"><text>快脆啲，呢铺等住赢！🥀</text></view>
          </view>
        </block>
        <!-- 斟杯靓茶 -->
        <block wx:if="{{fx.tea}}">
          <view class="fx-tea-teapot {{fx.tea.tilt ? 'fx-tilt' : ''}}" style="left: {{fx.tea.potX}}px; top: {{fx.tea.potY}}px;">
            <image src="/assets/icons/fx-teapot.svg" mode="aspectFit" />
          </view>
          <view class="fx-tea-stream {{fx.tea.pour ? 'fx-on' : ''}}" style="left: {{fx.tea.streamX}}px; top: {{fx.tea.streamY}}px; height: {{fx.tea.streamH}}px;"></view>
          <view class="fx-tea-cup" style="left: {{fx.tea.cupX}}px; top: {{fx.tea.cupY}}px;">
            <view class="fx-steam"><view class="s1"></view><view class="s2"></view><view class="s3"></view></view>
            <view class="cup-body">
              <view class="cup-water {{fx.tea.pour ? 'fx-on' : ''}}"><text>茶香</text></view>
            </view>
            <view class="cup-label"><text>轻啲嚟，手下留情唔好咁狠！</text></view>
          </view>
        </block>
        <!-- 丢番茄：抛物线飞行 → 冲击闪光 + 碎块爆散 + 剧震震屏 → 大爆浆糊脸 -->
        <block wx:if="{{fx.tomato}}">
          <view wx:if="{{fx.tomato.phase === 'fly'}}" class="fx-tomato-fly" style="{{fx.tomato.style}}">
            <image src="/assets/icons/fx-tomato-fly.svg" mode="aspectFit" />
          </view>
          <view wx:if="{{fx.tomato.phase === 'splat'}}" class="fx-tomato-stage {{fx.tomato.fade ? 'fx-fade' : ''}}" style="left: {{fx.tomato.x}}px; top: {{fx.tomato.y}}px;">
            <view class="fx-tomato-blast"></view>
            <view class="fx-frag" style="--tx:150rpx;--ty:-130rpx;--rot:180deg;"><text class="fx-frag-emoji">🍅</text></view>
            <view class="fx-frag" style="--tx:-160rpx;--ty:-100rpx;--rot:-220deg;"><view class="fx-frag-dot"></view></view>
            <view class="fx-frag" style="--tx:130rpx;--ty:140rpx;--rot:140deg;"><view class="fx-frag-chip"></view></view>
            <view class="fx-frag" style="--tx:-140rpx;--ty:120rpx;--rot:-160deg;"><view class="fx-frag-dot d2"></view></view>
            <view class="fx-frag" style="--tx:20rpx;--ty:-180rpx;--rot:90deg;"><view class="fx-frag-stem"></view></view>
            <view class="fx-frag" style="--tx:-40rpx;--ty:170rpx;--rot:-45deg;"><text class="fx-frag-emoji">💥</text></view>
            <image class="fx-tomato-big" src="/assets/icons/fx-tomato-splatter.svg" mode="aspectFit" />
            <view class="fx-tomato-bubble"><text>食番茄啦，乱咁出牌！🍅</text></view>
          </view>
        </block>
        <!-- 踢击私密暗号气泡 -->
        <view wx:if="{{fx.banner}}" class="fx-banner {{fx.banner.on ? 'fx-on' : ''}}">
          <text class="banner-icon">🦶</text>
          <view style="flex: 1; min-width: 0;">
            <text class="banner-title">{{fx.banner.title}}</text>
            <view class="banner-desc"><text>{{fx.banner.desc}}</text></view>
          </view>
        </view>
      </view>
    </view>

    <!-- 流水账单 -->
    <view class="ledger-card">
      <view class="ledger-header">
        <image class="ledger-icon" src="/assets/icons/score-statement-history.svg" mode="aspectFit" />
        <text class="ledger-title">流水账单</text>
        <text class="ledger-count">共 {{ledger.length}} 笔记录</text>
      </view>
      <view class="ledger-list">
        <view class="ledger-item" wx:for="{{ledger}}" wx:key="id" wx:if="{{index < ledgerShown}}">
          <image class="ledger-avatar" src="{{item.avatar}}" mode="aspectFill" wx:if="{{item.avatar}}" />
          <view class="ledger-avatar ledger-avatar-ph" wx:else>{{item.peerInitial}}</view>
          <view class="ledger-info">
            <text class="ledger-item-title">{{item.desc}}</text>
            <text class="ledger-item-sub">{{item.sub}}</text>
          </view>
          <text class="ledger-item-score {{item.score >= 0 ? 'text-positive' : 'text-negative'}}" wx:if="{{item.mine}}">{{item.score >= 0 ? '+' : ''}}{{item.score}}</text>
          <text class="ledger-item-score text-secondary" wx:else>{{item.amount}}</text>
        </view>
        <view class="ledger-empty" wx:if="{{ledger.length === 0}}">
          <text>暂无转分记录</text>
        </view>
      </view>
      <!-- 分页：查看全部 / 收起 -->
      <view class="ledger-more ledger-more-tap" wx:if="{{ledger.length > ledgerShown}}" bindtap="loadMoreLedger">
        <text>查看全部 {{ledger.length}} 笔</text><text class="ledger-more-arrow">›</text>
      </view>
      <view class="ledger-more ledger-more-tap" wx:elif="{{ledger.length > ledgerPageSize}}" bindtap="collapseLedger">
        <text>收起</text>
      </view>
    </view>
  </view>

  <!-- 加载中 -->
  <view class="room-state" wx:elif="{{loading}}">
    <view class="room-state-spinner"></view>
    <text class="room-state-text">加载中...</text>
  </view>

  <!-- 加载失败 -->
  <view class="room-state" wx:else>
    <text class="room-state-text">牌局加载失败</text>
    <view class="room-state-btn" bindtap="loadGame"><text>重试</text></view>
  </view>

  <!-- 模态层 1: QR 台码弹窗 -->
  <view class="modal-overlay {{showQrModal ? 'modal-show' : ''}}" bindtap="closeQrModal">
    <view class="qr-modal-card" catchtap="stopPropagation">
      <view class="qr-modal-header">
        <view>
          <text class="qr-modal-title">扫码加入牌局</text>
          <text class="qr-modal-sub">微信扫一扫 · 自动锁定空位</text>
        </view>
        <view class="modal-close-btn" bindtap="closeQrModal"><text>✕</text></view>
      </view>
      <view class="qr-modal-body">
        <view class="qr-modal-loading" wx:if="{{qrLoading}}">
          <view class="room-state-spinner"></view>
          <text class="qr-modal-tip">台码生成中...</text>
        </view>
        <image class="qr-modal-img" src="{{qrPath}}" mode="aspectFit" wx:elif="{{qrPath}}" />
        <view class="qr-modal-img-placeholder qr-modal-retry" wx:elif="{{qrError}}" bindtap="retryQRCode">
          <text class="qr-modal-retry-icon">↻</text>
          <text class="qr-modal-tip">台码生成失败，点击重试</text>
        </view>
        <view class="qr-modal-img-placeholder" wx:else><text>QR</text></view>
        <text class="qr-modal-tip" wx:if="{{qrPath}}">永久有效 · 仅限本局同台使用</text>
      </view>
      <!-- 呼叫雀友：透明 button 命中层拉起微信分享（与座位「邀请入座」同款实现） -->
      <view class="qr-modal-btn" hover-class="qr-modal-btn-active">
        <image class="qr-modal-btn-icon" src="/assets/icons/share-wechat.svg" mode="aspectFit" />
        <text>呼叫雀友</text>
        <button class="qr-modal-btn-hit" open-type="share"></button>
      </view>
    </view>
  </view>

  <!-- 模态层 2: 比分抽屉 -->
  <view class="modal-overlay modal-bottom {{showScoreModal ? 'modal-show' : ''}}">
    <view class="score-sheet" catchtap="stopPropagation">
      <view class="score-sheet-header">
        <view class="score-sheet-icon"><image src="/assets/icons/arrows-split-up-and-left-solid-full.svg" mode="aspectFit" /></view>
        <view class="score-sheet-heading">
          <text class="score-sheet-title">比分转入给 <text class="score-sheet-name">{{scoreTargetName}}（{{scoreTargetWind}}位）</text></text>
          <text class="score-sheet-sub">你扣除对应分数，对方增加对应分数</text>
        </view>
        <view class="modal-close-btn" bindtap="closeScoringModal"><text>✕</text></view>
      </view>

      <view class="score-amount-box">
        <view class="score-step-btn" bindtap="adjustScore" data-delta="-1"><text>−</text></view>
        <view class="score-amount-center">
          <text class="score-amount-label">本次转入分值</text>
          <view class="score-amount-value">
            <input class="score-amount-input" type="number" maxlength="3" value="{{scoreText}}" bindinput="onScoreInput" />
            <text class="score-amount-unit">分</text>
          </view>
        </view>
        <view class="score-step-btn" bindtap="adjustScore" data-delta="1"><text>＋</text></view>
      </view>

      <text class="score-preset-label">快捷预设分值</text>
      <view class="score-preset-row">
        <view class="score-preset-btn {{currentScore === item ? 'score-preset-on' : ''}}" wx:for="{{[5, 10, 20]}}" wx:key="*this" data-val="{{item}}" bindtap="setScoreValue"><text>{{item}} 分</text></view>
      </view>

      <view class="score-submit-btn {{currentScore <= 0 ? 'score-submit-btn-off' : ''}}" bindtap="submitScore">
        <image class="score-submit-icon" src="/assets/icons/status-check-on-primary.svg" mode="aspectFit" />
        <text>确认比分：转出 {{currentScore}} 分</text>
      </view>
    </view>
  </view>

  <!-- 模态层 3: 换位确认 -->
  <view class="modal-overlay {{showSwapModal ? 'modal-show' : ''}}" bindtap="closeSwapModal">
    <view class="swap-modal-card" catchtap="stopPropagation">
          <view class="swap-modal-icon"><image src="/assets/icons/seat-swap.svg" mode="aspectFit" /></view>
      <text class="swap-modal-title">申请交换座位</text>
      <text class="swap-modal-desc">{{swapTargetText}}</text>
      <view class="swap-modal-tip"><text>对方在手机上点击「同意」后方可互换</text></view>
      <view class="swap-modal-actions">
        <view class="swap-cancel-btn" bindtap="closeSwapModal"><text>取消</text></view>
        <view class="swap-confirm-btn" bindtap="sendSwapRequest"><text>发送申请</text></view>
      </view>
      <!-- 台主额外入口：长按他人座位现在一律是「申请换位」，移出改从这里进（离座动作，有流水账单需先「结束散台」结算） -->
      <view class="swap-kick-btn" wx:if="{{isOwner}}" bindtap="kickFromSwapModal">
        <text>移出牌台</text>
      </view>
    </view>
  </view>

  <!-- 模态层 4: 收到他人的换位申请（同意 / 拒绝） -->
  <view class="modal-overlay {{showIncomingSwap ? 'modal-show' : ''}}">
    <view class="swap-modal-card" catchtap="stopPropagation">
      <view class="swap-modal-icon"><image src="/assets/icons/seat-swap.svg" mode="aspectFit" /></view>
      <text class="swap-modal-title">收到换位申请</text>
      <text class="swap-modal-desc">{{incomingSwap.from_nickname}} 想与你互换座位</text>
      <view class="swap-modal-tip"><text>{{incomingSwap.swapTip}}</text></view>
      <view class="swap-modal-actions">
        <view class="swap-cancel-btn" bindtap="rejectIncomingSwap"><text>拒绝</text></view>
        <view class="swap-confirm-btn" bindtap="acceptIncomingSwap"><text>同意</text></view>
      </view>
    </view>
  </view>

  <!-- 模态层 5: 席位互动道具（入口，动画本体在桌面 fx 层） -->
  <view class="modal-overlay modal-bottom {{showPropModal ? 'modal-show' : ''}}" bindtap="closePropModal">
    <view class="prop-sheet" catchtap="stopPropagation">
      <view class="prop-head">
        <view style="flex: 1; min-width: 0;">
          <text class="prop-title">互动道具</text>
          <text class="prop-sub">{{propTargetName ? '向【' + propTargetName + '】发送互动微道具或暗号' : '先选一个互动目标席位'}}</text>
        </view>
        <view class="modal-close-btn" bindtap="closePropModal"><text>✕</text></view>
      </view>
      <view class="prop-targets">
        <text class="prop-targets-label">互动目标：</text>
        <view wx:for="{{propTargets}}" wx:key="pos"
          class="prop-target-chip {{propTarget === item.pos ? 'prop-target-on' : ''}}"
          data-pos="{{item.pos}}" data-name="{{item.name}}" data-pid="{{item.pid}}" bindtap="selectPropTarget">
          <text>{{item.name}}</text>
        </view>
      </view>
      <view class="prop-grid">
        <view class="prop-card" data-type="slipper" bindtap="useProp">
          <view class="prop-card-top"><text class="prop-card-emoji">🩴</text><text class="prop-card-tag">物理飞击</text></view>
          <view><text class="prop-card-name">飞拖鞋</text><text class="prop-card-desc">嗱嗱声出牌啦，唔好谂咁耐！</text></view>
        </view>
        <view class="prop-card" data-type="tea" bindtap="useProp">
          <view class="prop-card-top"><text class="prop-card-emoji">🍵</text><text class="prop-card-tag">紫砂倾注</text></view>
          <view><text class="prop-card-name">斟杯靓茶</text><text class="prop-card-desc">轻啲嚟，手下留情唔好咁狠！</text></view>
        </view>
        <view class="prop-card prop-card-hot" data-type="kick" bindtap="useProp">
          <view class="prop-card-top"><text class="prop-card-emoji">🦶</text><text class="prop-card-tag">全桌震颤</text></view>
          <view><text class="prop-card-name">台下猛踢</text><text class="prop-card-desc">识做啦，猛咁踢脚喇！</text></view>
        </view>
        <view class="prop-card prop-card-warm" data-type="flower" bindtap="useProp">
          <view class="prop-card-top"><text class="prop-card-emoji">🥀</text><text class="prop-card-tag">萧瑟催牌</text></view>
          <view><text class="prop-card-name">花嘟谢埋</text><text class="prop-card-desc">快脆啲，呢铺等住赢！</text></view>
        </view>
        <view class="prop-card prop-card-wide" data-type="dimsum" bindtap="useProp">
          <text class="prop-card-emoji">🍅</text>
          <view style="flex: 1; min-width: 0;">
            <text class="prop-card-name">丢番茄</text>
            <text class="prop-card-desc">食番茄啦，乱咁出牌！</text>
          </view>
          <text class="prop-card-tag">番茄暴击</text>
        </view>
      </view>
      <text class="prop-foot-tip">道具仅为友谊催化剂，请保持惬意乐道精神</text>
    </view>
  </view>

  <!-- Toast -->
  <view class="toast {{showToast ? 'toast-show' : ''}}">
    <text>{{toastMsg}}</text>
  </view>

  <!-- 长按换座 Lottie 动画覆盖层 -->
  <view class="swap-anim-overlay {{showSwapAnim ? 'swap-anim-show' : ''}}">
    <canvas type="2d" id="lottie-swap" class="swap-anim-canvas"></canvas>
  </view>

  <!-- 底部操作栏：道具盒在左；取消开台 / 结束散台 / 查找数靠右 -->
  <view class="room-footer safe-bottom" wx:if="{{game}}">
    <view class="foot-soft" bindtap="openPropModal"><text class="foot-prop-emoji">🪄</text><text>道具盒</text></view>
    <view class="foot-soft foot-soft-right" wx:if="{{isOwner && game.status === 'forming'}}" bindtap="doCancel">
      <image class="foot-soft-icon" src="/assets/icons/action-exit.svg" mode="aspectFit" /><text>取消开台</text>
    </view>
    <view class="foot-soft foot-soft-right" wx:elif="{{isOwner && game.status === 'active' && !hasScores}}" bindtap="doCancel">
      <image class="foot-soft-icon" src="/assets/icons/action-exit.svg" mode="aspectFit" /><text>取消开台</text>
    </view>
    <view class="foot-soft foot-soft-right" wx:elif="{{isOwner && game.status === 'active'}}" bindtap="doEnd">
      <image class="foot-soft-icon" src="/assets/icons/action-exit.svg" mode="aspectFit" /><text>结束散台</text>
    </view>
    <view class="foot-soft foot-soft-right" wx:elif="{{game.status === 'ended'}}" bindtap="goSettlement"><text>查看找数</text></view>
  </view>
</view>
