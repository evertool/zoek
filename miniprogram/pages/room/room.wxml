<!--pages/room/room.wxml — 房间页-->
<view class="container" wx:if="{{game}}">
  <!-- 牌局信息 -->
  <view class="card">
    <view class="room-header">
      <view class="room-name">{{game.name}}</view>
      <view class="tag {{game.statusClass}}">{{game.statusText}}</view>
    </view>
    <view class="room-meta" wx:if="{{game.current_round_number}}">
      <text>第{{game.current_round_number}}局</text>
      <text class="text-secondary" style="margin-left: 20rpx;">已完成{{game.completed_rounds}}局</text>
    </view>
    <view class="room-meta" wx:else>
      <text class="text-secondary">已完成{{game.completed_rounds}}局</text>
    </view>
  </view>

  <!-- 雀友列表 -->
  <view class="card">
    <view class="section-title">雀友 ({{players.length}}/4)</view>
    <view class="player-list">
      <view class="player-item" wx:for="{{players}}" wx:key="player_id">
        <view class="avatar-text" style="background: {{item.avatarColor}}">{{item.nickname[0]}}</view>
        <view class="player-name">{{item.nickname}}</view>
        <view class="tag tag-forming" wx:if="{{item.isOwner}}">台主</view>
      </view>
    </view>
  </view>

  <!-- 邀请区（组台中） -->
  <view class="card invite-card" wx:if="{{game.status === 'forming'}}">
    <view class="section-title">邀请雀友</view>
    <view class="text-secondary" style="margin-bottom: 24rpx;">扫码或分享链接即可加入</view>

    <!-- 小程序码 -->
    <view class="qr-area" wx:if="{{qrPath}}">
      <image class="qr-image" src="{{qrPath}}" mode="aspectFit" />
      <view class="text-secondary" style="margin-top: 16rpx;">{{players.length}}/4 已加入</view>
    </view>
    <view class="qr-loading" wx:elif="{{qrLoading}}">
      <view class="text-secondary">正在生成二维码...</view>
    </view>
    <view class="qr-error" wx:elif="{{qrError}}">
      <view class="text-error">{{qrError}}</view>
      <button class="btn-secondary" style="margin-top: 16rpx;" bindtap="loadQRCode">重新生成</button>
    </view>

    <!-- 邀请按钮 -->
    <button class="btn-accent" open-type="share" style="margin-top: 24rpx;">邀请好友</button>
  </view>

  <!-- 操作区 -->
  <view class="action-bar">
    <!-- forming 状态 -->
    <block wx:if="{{game.status === 'forming'}}">
      <view class="text-secondary" style="text-align: center; margin-bottom: 16rpx;">等齐雀友加入后开始计分</view>
      <button class="btn-danger" wx:if="{{isOwner}}" bindtap="doCancel">删除房间</button>
    </block>

    <!-- active 状态 -->
    <block wx:if="{{game.status === 'active'}}">
      <button class="btn-primary" bindtap="goScore">入分 / 计分</button>
      <button class="btn-secondary" bindtap="goSettlement">查看排名</button>
      <button class="btn-danger" wx:if="{{isOwner}}" bindtap="doEnd">散台</button>
    </block>

    <!-- ended 状态 -->
    <block wx:if="{{game.status === 'ended'}}">
      <button class="btn-primary" bindtap="goSettlement">查看结算</button>
      <button class="btn-secondary" bindtap="goScore" wx:if="{{game.current_round_number}}">查看最近一局</button>
    </block>

    <!-- cancelled / expired -->
    <block wx:if="{{game.status === 'cancelled' || game.status === 'expired'}}">
      <view class="text-secondary" style="text-align: center;">此牌桌已{{game.statusText}}</view>
    </block>
  </view>
</view>
