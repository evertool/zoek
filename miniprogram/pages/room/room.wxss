/* pages/room/room.wxss — 台间页（设计 v2：深绿主视觉 + 米白底） */

.page {
  padding: 32rpx;
  min-height: 100vh;
  box-sizing: border-box;
}

/* ========== 深绿主视觉头部卡 ========== */
.hero {
  border-radius: 28rpx;
  padding: 44rpx 36rpx;
  margin-bottom: 32rpx;
  position: relative;
  overflow: hidden;
}

.hero-deco-tile {
  position: absolute;
  right: -18rpx;
  top: -14rpx;
  width: 110rpx;
  height: 146rpx;
  font-size: 52rpx;
  transform: rotate(16deg);
  opacity: 0.9;
}

.hero-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 14rpx;
  position: relative;
  z-index: 2;
}

.hero-name {
  color: #F7F3E8;
  font-size: 40rpx;
  font-weight: 800;
  letter-spacing: 2rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  margin-right: 16rpx;
}

.hero-info {
  display: flex;
  align-items: center;
  position: relative;
  z-index: 2;
}

.hero-round {
  color: #F6EEDC;
  font-size: 28rpx;
  font-weight: 700;
}

.hero-dot {
  color: rgba(247, 243, 232, 0.5);
  margin: 0 16rpx;
}

.hero-completed {
  color: rgba(247, 243, 232, 0.7);
  font-size: 24rpx;
}

/* ========== 区段标题 ========== */
.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.section-title {
  margin-bottom: 0;
}

/* ========== 雀友网格 ========== */
.player-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 36rpx;
}

.player-cell {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 120rpx;
}

.player-avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: var(--color-primary);
  color: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  font-weight: 700;
  margin-bottom: 12rpx;
  box-sizing: border-box;
}

.avatar-owner {
  border: 5rpx solid var(--color-gold);
  box-shadow: 0 6rpx 14rpx rgba(201, 162, 84, 0.35);
}

.avatar-empty {
  background: var(--color-card-warm);
  color: var(--color-text-tertiary);
  font-size: 44rpx;
  font-weight: 300;
  border: 2rpx dashed var(--color-text-tertiary);
}

.player-name {
  font-size: 24rpx;
  text-align: center;
  margin-bottom: 8rpx;
  max-width: 120rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* ========== 分享卡片（QR） ========== */
.share-card {
  text-align: center;
  border: 2rpx dashed var(--color-primary);
  background: var(--color-card);
}

.share-title {
  font-size: 32rpx;
  font-weight: 800;
  color: var(--color-text);
  letter-spacing: 3rpx;
}

.share-desc {
  font-size: 24rpx;
  color: var(--color-text-secondary);
  margin: 10rpx 0 28rpx;
}

.qr-frame {
  width: 360rpx;
  height: 360rpx;
  margin: 0 auto 28rpx;
  background: #FFFFFF;
  border: 6rpx solid var(--color-primary);
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  position: relative;
}

.qr-frame::before,
.qr-frame::after {
  content: '';
  position: absolute;
  width: 36rpx;
  height: 36rpx;
  border: 6rpx solid var(--color-gold);
}

.qr-frame::before {
  left: -6rpx;
  top: -6rpx;
  border-right: none;
  border-bottom: none;
  border-radius: 12rpx 0 0 0;
}

.qr-frame::after {
  right: -6rpx;
  bottom: -6rpx;
  border-left: none;
  border-top: none;
  border-radius: 0 0 12rpx 0;
}

.qr-img {
  width: 320rpx;
  height: 320rpx;
}

.qr-loading,
.qr-error {
  font-size: 24rpx;
  color: var(--color-text-secondary);
  padding: 20rpx;
}

.qr-error {
  color: var(--color-error);
}

.share-btn {
  width: 80%;
  margin: 0 auto;
}

/* ========== 操作区 ========== */
.action-bar {
  padding: 36rpx 0 12rpx;
}

.action-bar button {
  margin-bottom: 20rpx;
}

.waiting-text {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  color: var(--color-text-secondary);
  padding: 48rpx 0;
  font-size: 28rpx;
}

.waiting-tile {
  width: 72rpx;
  height: 94rpx;
  font-size: 34rpx;
  margin-bottom: 20rpx;
}
