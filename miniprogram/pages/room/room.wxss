/* pages/room/room.wxss — 台间页 v6 Stitch 100% 还原 */
.page { min-height: 100vh; background: var(--background); }
.main-content { padding-left: var(--margin-screen); padding-right: var(--margin-screen); padding-bottom: 200rpx; display: flex; flex-direction: column; gap: var(--space-md); }

/* 自定义导航栏：仅容纳返回按钮，与胶囊同水平 */
.top-bar { padding-left: var(--margin-screen); padding-right: var(--margin-screen); padding-bottom: 8rpx; }
/* 状态栏（保持原位置，不随胶囊顶高） */
.room-status-bar { display: flex; align-items: center; justify-content: space-between; margin-bottom: 0; }
/* 加载中 / 加载失败 兜底状态（避免 game 为 null 时整页空白） */
.room-state { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 24rpx; padding: 140rpx 0; }
.room-state-spinner { width: 56rpx; height: 56rpx; border: 6rpx solid var(--surface-container-high); border-top-color: var(--primary); border-radius: 50%; animation: room-spin 0.8s linear infinite; }
.room-state-text { font-size: 28rpx; color: var(--on-surface-variant); }
.room-state-btn { margin-top: 8rpx; padding: 16rpx 48rpx; border-radius: var(--radius-full); background: var(--primary); color: var(--on-primary); font-size: 28rpx; }
@keyframes room-spin { to { transform: rotate(360deg); } }
.status-pill { display: flex; align-items: center; gap: 12rpx; padding: 8rpx 24rpx; border-radius: var(--radius-full); background: var(--primary-fixed); color: var(--on-primary-fixed); font-size: 24rpx; font-weight: 500; }
.status-dot { width: 8rpx; height: 8rpx; border-radius: 50%; background: var(--primary); }
.status-dot-active { animation: pulse 2s ease-in-out infinite; }
.qr-show-btn { display: flex; align-items: center; gap: 8rpx; background: var(--surface-container-lowest); padding: 12rpx 24rpx; border-radius: var(--radius-full); box-shadow: var(--shadow-card); }
.qr-show-icon { width: 28rpx; height: 28rpx; }
.qr-show-text { font-size: 24rpx; color: var(--primary); font-weight: 500; }
/* 台主「结束散台」：复用台码按钮外观，转为告警配色以区别于台码入口 */
.qr-show-btn-end { background: var(--error-container); }
.qr-show-text-end { color: var(--on-error-container); }
.nav-back-btn { width: 68rpx; height: 68rpx; border-radius: 50%; background: var(--surface-container-lowest); box-shadow: var(--shadow-card); display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
.nav-back-icon { font-size: 40rpx; color: var(--on-surface); line-height: 1; }

/* 底部红色文字按钮（取消开台 / 结束散台） */
.btn-plain-danger { display: flex; align-items: center; justify-content: center; gap: 10rpx; padding: 24rpx; }
.btn-plain-danger text { font-size: 30rpx; font-weight: 600; color: var(--error); }
.btn-plain-danger-row { justify-content: flex-start; padding-left: 36rpx; }
.btn-plain-danger-icon { width: 32rpx; height: 32rpx; }

/* 2×2 座位 */
.seat-grid-2x2 { display: grid; grid-template-columns: 1fr 1fr; gap: var(--gutter-grid); width: 100%; }
.seat-card-2x2 { background: var(--surface-container-lowest); border-radius: var(--radius-lg); padding: var(--space-sm); box-shadow: var(--shadow-card); display: flex; flex-direction: column; gap: var(--space-xs); min-width: 0; }
.seat-card-top { display: flex; align-items: center; justify-content: space-between; }
.seat-wind-badge-img { width: 48rpx; height: 48rpx; }
.seat-player-row { display: flex; align-items: center; gap: 16rpx; }
.seat-player-avatar { width: 72rpx; height: 72rpx; border-radius: 50%; background: var(--surface-container); flex-shrink: 0; }
.seat-player-placeholder { display: flex; align-items: center; justify-content: center; font-size: 32rpx; font-weight: 600; color: var(--on-surface); }
.seat-player-empty { background: var(--surface-container); display: flex; align-items: center; justify-content: center; }
.seat-empty-icon-large { width: 40rpx; height: 40rpx; }
.seat-player-info { flex: 1; min-width: 0; }
.seat-player-name { font-size: 28rpx; font-weight: 600; color: var(--on-surface); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.seat-score-row { display: flex; align-items: baseline; justify-content: space-between; }
.seat-score-label { font-size: 24rpx; color: var(--on-surface-variant); }
.seat-score-val { font-size: 44rpx; font-weight: 700; }
.seat-action { padding-top: 8rpx; overflow: hidden; }
.seat-action-btn { height: 64rpx; border-radius: var(--radius-md); background: var(--surface-container-low); color: var(--primary); display: flex; align-items: center; justify-content: center; gap: 8rpx; font-size: 24rpx; font-weight: 500; }
.seat-action-btn:active { background: var(--primary); color: var(--on-primary); }
/* 呼叫雀友：视觉层复用 .seat-action-btn，透明 button 命中层负责 open-type=share */
.seat-action-btn { position: relative; }
.seat-action-share-hit { position: absolute; top: 0; left: 0; width: 100%; height: 100%; opacity: 0; margin: 0; padding: 0; border: none; border-radius: var(--radius-md); }
.seat-action-share-hit::after { display: none; }
.seat-action-btn-active { background: var(--primary); color: var(--on-primary); }
.seat-action-icon { width: 28rpx; height: 28rpx; }

/* 长按换座 Lottie 动画覆盖层（透明浮层，不置灰全屏，visibility 控制保证 canvas 可取尺寸） */
.swap-anim-overlay { position: fixed; top: 0; left: 0; right: 0; bottom: 0; z-index: 300; display: flex; align-items: center; justify-content: center; opacity: 0; visibility: hidden; transition: opacity 0.2s ease; pointer-events: none; }
.swap-anim-overlay.swap-anim-show { opacity: 1; visibility: visible; }
.swap-anim-canvas { width: 320rpx; height: 320rpx; }

/* 公告：本局总分核对提醒 */
.round-notice { margin-bottom: var(--space-sm); padding: 20rpx 24rpx; border-radius: var(--radius-md); background: var(--error-container, #FBE9E7); }
.round-notice text { font-size: 24rpx; line-height: 1.5; color: var(--error); }

/* 流水账单 */
.ledger-card { background: var(--surface-container-lowest); border-radius: var(--radius-lg); padding: var(--space-md); box-shadow: var(--shadow-card); display: flex; flex-direction: column; gap: var(--space-sm); }
.ledger-header { display: flex; align-items: center; justify-content: space-between; }
.ledger-icon { width: 32rpx; height: 32rpx; }
.ledger-title { font-size: 36rpx; font-weight: 600; color: var(--on-surface); flex: 1; margin-left: 8rpx; }
.ledger-count { font-size: 20rpx; color: var(--outline); }
/* 「收齐」：方形圆角 + 浅绿底，做成一枚小麻将台面牌的质感 */
.ledger-next-btn { margin-left: auto; min-width: 54rpx; height: 54rpx; padding: 0 8rpx; box-sizing: border-box; display: flex; align-items: center; justify-content: center; background: var(--primary-fixed); border: 2rpx solid rgba(0,82,53,0.16); border-radius: 13rpx; box-shadow: inset 0 2rpx 0 rgba(255,255,255,0.55), 0 3rpx 8rpx -3rpx rgba(0,82,53,0.2); }
.ledger-next-btn text { font-size: 21rpx; font-weight: 700; color: var(--on-primary-fixed-variant); letter-spacing: 0.5rpx; }
.ledger-next-btn:active { background: var(--primary-fixed-dim); }
.ledger-empty { padding: 32rpx 0; text-align: center; font-size: 24rpx; color: var(--outline); }
.ledger-more { padding-top: 16rpx; border-top: 2rpx solid var(--surface-container); text-align: center; }
.ledger-more text { font-size: 24rpx; color: var(--primary); font-weight: 500; }
.ledger-item { display: flex; align-items: center; justify-content: space-between; padding: 16rpx 0; }
.ledger-item-left { display: flex; align-items: center; gap: 16rpx; flex: 1; min-width: 0; }
.ledger-wind { width: 40rpx; height: 40rpx; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 22rpx; font-weight: 700; background: var(--secondary-container); color: var(--on-secondary-container); flex-shrink: 0; }
.ledger-item-info { flex: 1; min-width: 0; }
.ledger-item-title-row { display: flex; align-items: center; gap: 12rpx; }
.ledger-item-title { font-size: 24rpx; color: var(--on-surface); }
.ledger-item-sub { font-size: 24rpx; color: var(--outline); }
.ledger-item-right { display: flex; flex-direction: column; align-items: flex-end; flex-shrink: 0; }
.ledger-item-score { font-size: 44rpx; font-weight: 700; }
.ledger-item-status { font-size: 20rpx; color: var(--primary); }

/* 模态层 */
.modal-overlay { position: fixed; top: 0; left: 0; right: 0; bottom: 0; z-index: 100; background: rgba(33, 49, 69, 0.4); backdrop-filter: blur(8rpx); -webkit-backdrop-filter: blur(8rpx); display: none; align-items: center; justify-content: center; padding: 0 var(--margin-screen); }
.modal-overlay.modal-show { display: flex; }
.modal-bottom { align-items: flex-end; padding: 0; }
.modal-close-btn { width: 64rpx; height: 64rpx; border-radius: 50%; background: var(--surface-container); display: flex; align-items: center; justify-content: center; font-size: 28rpx; color: var(--on-surface-variant); }

/* QR 弹窗 */
.qr-modal-card { background: var(--surface-container-lowest); border-radius: var(--radius-lg); width: 100%; max-width: 680rpx; padding: var(--space-lg); box-shadow: var(--shadow-modal); }
.qr-modal-header { display: flex; align-items: center; justify-content: space-between; padding-bottom: var(--space-sm); }
.qr-modal-title { font-size: 36rpx; font-weight: 600; color: var(--on-surface); display: block; }
.qr-modal-sub { font-size: 24rpx; color: var(--on-surface-variant); display: block; }
.qr-modal-body { display: flex; flex-direction: column; align-items: center; justify-content: center; background: var(--surface-container-low); border-radius: var(--radius-lg); padding: var(--space-lg); margin: var(--space-md) 0; }
.qr-modal-img { width: 384rpx; height: 384rpx; border-radius: var(--radius-default); background: var(--surface-container-lowest); padding: 16rpx; box-shadow: var(--shadow-card); }
.qr-modal-img-placeholder { width: 384rpx; height: 384rpx; border-radius: var(--radius-default); background: var(--surface-container-lowest); display: flex; align-items: center; justify-content: center; font-size: 48rpx; color: var(--outline); }
.qr-modal-num { margin-top: 24rpx; font-size: 28rpx; font-weight: 600; color: var(--primary); }
.qr-modal-tip { font-size: 20rpx; color: var(--outline); }
.qr-modal-btn { height: 88rpx; border-radius: var(--radius-md); background: var(--primary); color: var(--on-primary); display: flex; align-items: center; justify-content: center; font-size: 28rpx; font-weight: 600; }

/* 比分抽屉 */
.score-sheet { background: var(--surface-container-lowest); border-top-left-radius: var(--radius-xl); border-top-right-radius: var(--radius-xl); width: 100%; max-width: 960rpx; padding: var(--space-lg); box-shadow: var(--shadow-modal); }
.score-sheet-header { display: flex; align-items: flex-start; gap: 20rpx; padding-bottom: var(--space-md); }
.score-sheet-icon { width: 72rpx; height: 72rpx; border-radius: 50%; background: rgba(0,82,53,0.08); display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
.score-sheet-icon image { width: 44rpx; height: 44rpx; }
.score-sheet-heading { flex: 1; min-width: 0; }
.score-sheet-title { font-size: 34rpx; font-weight: 700; color: var(--on-surface); display: block; line-height: 1.35; }
.score-sheet-name { color: var(--primary); font-weight: 700; }
.score-sheet-sub { font-size: 24rpx; color: var(--on-surface-variant); display: block; margin-top: 6rpx; }

.score-amount-box { display: flex; align-items: center; justify-content: space-between; background: rgba(0,82,53,0.05); border: 2rpx solid rgba(0,82,53,0.12); border-radius: var(--radius-lg); padding: 28rpx 24rpx; }
.score-step-btn { width: 88rpx; height: 88rpx; border-radius: var(--radius-default); background: var(--surface-container-lowest); border: 2rpx solid rgba(0,82,53,0.14); display: flex; align-items: center; justify-content: center; font-size: 40rpx; font-weight: 700; color: var(--primary); flex-shrink: 0; }
.score-step-btn:active { background: rgba(0,82,53,0.08); }
.score-amount-center { flex: 1; min-width: 0; display: flex; flex-direction: column; align-items: center; }
.score-amount-label { font-size: 24rpx; color: var(--on-surface-variant); }
.score-amount-value { display: flex; align-items: baseline; justify-content: center; margin-top: 4rpx; }
.score-amount-input { width: 120rpx; height: 88rpx; font-size: 76rpx; font-weight: 700; color: var(--primary); text-align: center; }
.score-amount-unit { font-size: 30rpx; font-weight: 600; color: var(--primary); margin-left: 4rpx; }

.score-preset-label { font-size: 24rpx; color: var(--on-surface-variant); display: block; margin: var(--space-md) 0 var(--space-xs); }
.score-preset-row { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--gutter-grid); }
.score-preset-btn { height: 88rpx; border-radius: var(--radius-default); background: var(--surface-container-lowest); border: 2rpx solid var(--outline-variant); display: flex; align-items: center; justify-content: center; font-size: 28rpx; font-weight: 700; color: var(--on-surface); }
.score-preset-on { border: 4rpx solid var(--primary); background: rgba(0,82,53,0.06); color: var(--primary); }

.score-submit-btn { margin-top: var(--space-lg); height: 96rpx; border-radius: var(--radius-md); background: var(--primary); color: var(--on-primary); display: flex; align-items: center; justify-content: center; gap: 12rpx; font-size: 30rpx; font-weight: 600; }
.score-submit-btn-off { opacity: 0.45; }
.score-submit-icon { width: 36rpx; height: 36rpx; }

/* 换位弹窗 */
.swap-modal-card { background: var(--surface-container-lowest); border-radius: var(--radius-lg); max-width: 640rpx; width: 100%; padding: var(--space-lg); box-shadow: var(--shadow-modal); display: flex; flex-direction: column; align-items: center; gap: var(--space-sm); }
.swap-modal-icon { width: 48rpx; height: 48rpx; }
.swap-modal-icon image { width: 48rpx; height: 48rpx; }
.swap-modal-title { font-size: 36rpx; font-weight: 600; color: var(--on-surface); text-align: center; }
.swap-modal-desc { font-size: 28rpx; color: var(--on-surface-variant); text-align: center; }
.swap-modal-tip { background: var(--surface-container-low); border-radius: var(--radius-default); padding: 16rpx; }
.swap-modal-tip text { font-size: 20rpx; color: var(--outline); }
.swap-modal-actions { display: grid; grid-template-columns: 1fr 1fr; gap: var(--gutter-grid); margin-top: var(--space-md); width: 100%; }
.swap-cancel-btn { height: 80rpx; border-radius: var(--radius-md); background: var(--surface-container); color: var(--on-surface); display: flex; align-items: center; justify-content: center; font-size: 24rpx; font-weight: 500; }
.swap-confirm-btn { height: 80rpx; border-radius: var(--radius-md); background: var(--primary); color: var(--on-primary); display: flex; align-items: center; justify-content: center; font-size: 24rpx; font-weight: 500; }

/* Toast */
.toast { position: fixed; top: 160rpx; left: 50%; transform: translateX(-50%); z-index: 200; background: rgba(33, 49, 69, 0.9); color: var(--inverse-on-surface); padding: 16rpx 32rpx; border-radius: var(--radius-full); font-size: 24rpx; box-shadow: var(--shadow-modal); opacity: 0; transition: opacity 0.3s ease; pointer-events: none; }
.toast.toast-show { opacity: 1; }

/* 底部操作栏 */
.room-footer { position: fixed; left: 0; right: 0; bottom: 0; padding: 20rpx var(--margin-screen) calc(env(safe-area-inset-bottom) + 20rpx); background: rgba(248, 249, 255, 0.92); backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px); z-index: 50; display: flex; flex-direction: column; gap: 16rpx; }
