/* pages/room/room.wxss — 台间页 v8 十字桌面版（docs/design/room 还原） */
/* 禁止整页被左右拖动：内容只要横向溢出（哪怕亚像素），iOS/安卓都允许把整页拖走；
 * overscroll-behavior 再关掉拖到边缘后的整页回弹。竖向滚动不受影响。 */
page { overflow-x: hidden; overscroll-behavior-x: none; }
.page { min-height: 100vh; background: var(--background); overflow-x: hidden; display: flex; flex-direction: column; }
.main-content { padding-left: 24rpx; padding-right: 24rpx; padding-bottom: 24rpx; display: flex; flex-direction: column; gap: var(--space-md); }

/* 加载中 / 加载失败 兜底状态（避免 game 为 null 时整页空白） */
.room-state { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 24rpx; padding: 140rpx 0; }
.room-state-spinner { width: 56rpx; height: 56rpx; border: 6rpx solid var(--surface-container-high); border-top-color: var(--primary); border-radius: 50%; animation: room-spin 0.8s linear infinite; }
.room-state-text { font-size: 28rpx; color: var(--on-surface-variant); }
.room-state-btn { margin-top: 8rpx; padding: 16rpx 48rpx; border-radius: var(--radius-full); background: var(--primary); color: var(--on-primary); font-size: 28rpx; }
@keyframes room-spin { to { transform: rotate(360deg); } }

/* ========== 顶栏：返回 + 状态胶囊（左） / 出示台码（紧随其后 6px） ========== */
.top-bar { display: flex; align-items: center; padding-left: 24rpx; padding-right: 24rpx; padding-bottom: 8rpx; }
.top-bar-left { display: flex; align-items: center; gap: 10rpx; min-width: 0; }
.nav-back-btn { border-radius: 50%; background: var(--surface-container-lowest); box-shadow: var(--shadow-card); display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
.nav-back-img { width: 36rpx; height: 36rpx; }
/* 状态胶囊：淡绿底 + 呼吸圆点（设计稿 primary/10） */
.status-pill { display: flex; align-items: center; gap: 8rpx; padding: 8rpx 14rpx; border-radius: var(--radius-full); background: rgba(0, 82, 53, 0.1); color: var(--primary); font-size: 24rpx; font-weight: 500; flex-shrink: 0; }
.status-dot { width: 10rpx; height: 10rpx; border-radius: 50%; background: var(--primary); }
.status-dot-active { animation: pulse 2s ease-in-out infinite; }
/* 出示台码：紧跟状态胶囊（约 6px），不再推到右侧 */
.qr-text-btn { margin-left: 10rpx; display: flex; align-items: center; gap: 6rpx; padding: 10rpx 14rpx; border-radius: var(--radius-full); background: var(--surface-container-high); flex-shrink: 0; }
.qr-text-btn text { font-size: 22rpx; font-weight: 600; color: var(--on-surface); }
/* 散台（头部紧凑版）：与台码并排，右缘要避开系统胶囊，故收窄内边距 */
.end-btn { margin-left: 8rpx; display: flex; align-items: center; gap: 6rpx; padding: 10rpx 14rpx; border-radius: var(--radius-full); background: rgba(142, 18, 21, 0.08); flex-shrink: 0; }
.end-btn text { font-size: 22rpx; font-weight: 600; color: var(--tertiary); }
.end-btn-icon { width: 26rpx; height: 26rpx; }
.end-btn:active { background: rgba(142, 18, 21, 0.18); }
.qr-text-icon { width: 28rpx; height: 28rpx; }
.qr-text-btn:active { background: var(--surface-variant); }

/* ========== 桌面卡：渐变底 + 双光晕，十字布局 ==========
 * 舞台 690×720；中心圆 192rpx 居中 (249..441, 264..456)，圆心 (345, 360)。
 * 四张席位卡 192×200：上(249,12) 左(12,260) 右(486,260) 下(249,508)。
 * 方位沿用设计稿：南在上、東在左、西在右、北在下（不是通用罗盘的「北在上」）。 */
.table-stage { position: relative; width: 690rpx; height: 760rpx; margin: 0 auto; flex-shrink: 0; border-radius: 48rpx; background: linear-gradient(180deg, var(--surface-container-low) 0%, var(--surface-container-lowest) 45%, var(--surface-container-low) 100%); box-shadow: var(--shadow-card); overflow: hidden; }
/* 装饰光晕：radial-gradient 代替 filter:blur（滤镜层在快速滚动时易把 fixed 元素搞丢帧） */
.stage-blob { position: absolute; width: 320rpx; height: 320rpx; border-radius: 50%; pointer-events: none; }
.stage-blob-tr { top: -96rpx; right: -96rpx; background: radial-gradient(circle, rgba(0, 82, 53, 0.12) 0%, rgba(0, 82, 53, 0.06) 45%, rgba(0, 82, 53, 0) 72%); }
.stage-blob-bl { bottom: -96rpx; left: -96rpx; background: radial-gradient(circle, rgba(144, 77, 0, 0.12) 0%, rgba(144, 77, 0, 0.06) 45%, rgba(144, 77, 0, 0) 72%); }

/* 席位卡（外层只管定位，视觉与 fx 命中都在 .side-fill 上） */
.side-top { position: absolute; left: 249rpx; top: 12rpx; width: 192rpx; height: 200rpx; }
.side-bottom { position: absolute; left: 249rpx; top: 508rpx; width: 192rpx; height: 200rpx; }
.side-left { position: absolute; left: 12rpx; top: 260rpx; width: 192rpx; height: 200rpx; }
.side-right { position: absolute; left: 486rpx; top: 260rpx; width: 192rpx; height: 200rpx; }
.side-fill { position: absolute; top: 0; left: 0; right: 0; bottom: 0; box-sizing: border-box; background: rgba(255, 255, 255, 0.95); border-radius: var(--radius-md); box-shadow: 0 2rpx 10rpx rgba(11, 28, 48, 0.05); padding: 12rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 8rpx; }

.seat-head { display: flex; align-items: center; gap: 8rpx; width: 100%; min-width: 0; }
/* 点头像/昵称 = 打开道具盒 */
.seat-head-active { opacity: 0.65; }
.seat-avatar-wrap { position: relative; flex-shrink: 0; }
.seat-avatar { width: 56rpx; height: 56rpx; border-radius: 50%; background: var(--surface-container); flex-shrink: 0; }
.seat-avatar-ph { display: flex; align-items: center; justify-content: center; font-size: 26rpx; font-weight: 600; color: var(--on-surface); }
.seat-meta { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 2rpx; }
.seat-owner-tag { align-self: flex-start; padding: 0 8rpx; border-radius: var(--radius-sm); background: var(--secondary-fixed); color: var(--on-secondary-fixed); font-size: 16rpx; font-weight: 600; line-height: 1.5; }
.seat-name { font-size: 22rpx; font-weight: 600; line-height: 1.25; color: var(--on-surface); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.seat-score { font-size: 36rpx; font-weight: 700; line-height: 1.1; }
/* 「＋ 给分」入口 */
.give-btn { width: 100%; height: 44rpx; border-radius: var(--radius-full); background: rgba(0, 82, 53, 0.1); color: var(--primary); display: flex; align-items: center; justify-content: center; gap: 2rpx; font-size: 22rpx; font-weight: 500; box-sizing: border-box; }
.give-btn-plus { font-size: 24rpx; font-weight: 700; }
.give-btn:active { background: var(--primary); color: var(--on-primary); }
.give-btn-self { background: var(--surface-container); color: var(--on-surface-variant); font-size: 20rpx; }

/* 空位：加号圈 + 虚位以待 + 呼叫（透明 button 命中层负责 open-type=share） */
.seat-empty-ring { width: 56rpx; height: 56rpx; }
.seat-empty-text { font-size: 22rpx; color: var(--on-surface-variant); }
.invite-btn { position: relative; width: 100%; height: 44rpx; border-radius: var(--radius-full); background: rgba(0, 82, 53, 0.1); color: var(--primary); display: flex; align-items: center; justify-content: center; gap: 4rpx; font-size: 22rpx; font-weight: 500; box-sizing: border-box; }
.invite-icon { width: 24rpx; height: 24rpx; }
.invite-btn-active { background: var(--primary); color: var(--on-primary); }
.invite-hit { position: absolute; top: 0; left: 0; width: 100%; height: 100%; opacity: 0; margin: 0; padding: 0; border: none; border-radius: var(--radius-full); }
.invite-hit::after { display: none; }

/* 中心圆：白底圆 + 内圈渐变 + 牌面「發」 */
.table-center { position: absolute; left: 249rpx; top: 264rpx; width: 192rpx; height: 192rpx; border-radius: 50%; background: var(--surface-container-lowest); border: 2rpx solid rgba(191, 201, 192, 0.3); box-shadow: 0 8rpx 24rpx rgba(11, 28, 48, 0.08); display: flex; align-items: center; justify-content: center; z-index: 3; }
.table-center-ring { position: absolute; left: 8rpx; top: 8rpx; right: 8rpx; bottom: 8rpx; border-radius: 50%; background: linear-gradient(180deg, rgba(239, 244, 255, 0.8) 0%, rgba(239, 244, 255, 0.2) 100%); }
.table-center-tile { position: relative; z-index: 1; font-size: 72rpx; font-weight: 700; color: var(--primary); line-height: 1; letter-spacing: -2rpx; }
/* 東南西北 SVG 风位章：压在中心圆四边（南上、東左、西右、北下），层级高于中心圆 */
.wind-badge { position: absolute; width: 48rpx; height: 48rpx; z-index: 4; filter: drop-shadow(0 4rpx 8rpx rgba(11, 28, 48, 0.12)); }
.wind-badge-top { left: 72rpx; top: -24rpx; }
.wind-badge-bottom { left: 72rpx; bottom: -24rpx; }
.wind-badge-left { left: -24rpx; top: 72rpx; }
.wind-badge-right { right: -24rpx; top: 72rpx; }

/* 长按换座提示 */
.stage-hint { position: absolute; left: 0; right: 0; bottom: 18rpx; display: flex; align-items: center; justify-content: center; gap: 8rpx; }
.stage-hint text { font-size: 20rpx; color: var(--outline); }
.stage-hint-icon { width: 24rpx; height: 24rpx; opacity: 0.8; }

/* 长按换座 Lottie 动画覆盖层（透明浮层，不置灰全屏，visibility 控制保证 canvas 可取尺寸） */
.swap-anim-overlay { position: fixed; top: 0; left: 0; right: 0; bottom: 0; z-index: 300; display: flex; align-items: center; justify-content: center; opacity: 0; visibility: hidden; transition: opacity 0.2s ease; pointer-events: none; }
.swap-anim-overlay.swap-anim-show { opacity: 1; visibility: visible; }
.swap-anim-canvas { width: 320rpx; height: 320rpx; }

/* ========== 流水账单 ========== */
.ledger-card { background: var(--surface-container-lowest); border-radius: var(--radius-lg); padding: var(--space-md); box-shadow: var(--shadow-card); display: flex; flex-direction: column; gap: var(--space-sm); }
.ledger-header { display: flex; align-items: center; gap: 12rpx; }
.ledger-icon-chip { width: 48rpx; height: 48rpx; border-radius: var(--radius-default); background: rgba(254, 147, 44, 0.15); display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
.ledger-icon { width: 30rpx; height: 30rpx; }
.ledger-title { font-size: 30rpx; font-weight: 600; color: var(--on-surface); flex: 1; }
.ledger-count { padding: 4rpx 16rpx; border-radius: var(--radius-sm); background: var(--surface-container); color: var(--outline); font-size: 22rpx; font-weight: 500; flex-shrink: 0; }
.ledger-list { display: flex; flex-direction: column; gap: 8rpx; padding-top: 8rpx; }
.ledger-item { display: flex; align-items: center; gap: 16rpx; padding: 10rpx 12rpx; border-radius: var(--radius-md); }
.ledger-item:active { background: var(--surface-container-low); }
.ledger-avatar { width: 64rpx; height: 64rpx; border-radius: 50%; background: var(--surface-container); flex-shrink: 0; }
.ledger-avatar-ph { display: flex; align-items: center; justify-content: center; font-size: 26rpx; font-weight: 600; color: var(--on-surface); }
.ledger-info { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 2rpx; }
.ledger-item-title { font-size: 24rpx; color: var(--on-surface); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
/* 次行：时间（含原因）与给分标签同行，标签紧跟在时间右边（sub 只缩不涨，标签才贴着时间） */
.ledger-item-subline { display: flex; align-items: center; gap: 8rpx; min-width: 0; }
.ledger-item-sub { min-width: 0; flex-shrink: 1; font-size: 20rpx; color: var(--outline); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.ledger-tag { flex-shrink: 0; display: flex; align-items: center; height: 32rpx; padding: 0 10rpx; border-radius: 8rpx; background: rgba(0,82,53,0.10); border: 2rpx solid rgba(0,82,53,0.18); }
.ledger-tag text { font-size: 20rpx; font-weight: 600; color: var(--primary); line-height: 1; }
.ledger-item-sub { font-size: 20rpx; color: var(--outline); }
.ledger-item-score { font-size: 32rpx; font-weight: 700; flex-shrink: 0; }
.ledger-empty { padding: 32rpx 0; text-align: center; font-size: 24rpx; color: var(--outline); }
/* 到底了（无下一页时显示，更多靠卡片上滑手势） */
.ledger-end { display: flex; align-items: center; justify-content: center; gap: 16rpx; padding-top: 16rpx; border-top: 2rpx solid var(--surface-container); }
.ledger-end text { font-size: 22rpx; color: var(--outline); }
.ledger-end-line { width: 48rpx; height: 2rpx; background: rgba(191, 201, 192, 0.5); }

/* 模态层 */
.modal-overlay { position: fixed; top: 0; left: 0; right: 0; bottom: 0; z-index: 100; background: rgba(33, 49, 69, 0.4); backdrop-filter: blur(8rpx); -webkit-backdrop-filter: blur(8rpx); display: none; align-items: center; justify-content: center; padding: 0 var(--margin-screen); }
.modal-overlay.modal-show { display: flex; }
.modal-bottom { align-items: flex-end; padding: 0; }
.modal-close-btn { width: 64rpx; height: 64rpx; border-radius: 50%; background: var(--surface-container); display: flex; align-items: center; justify-content: center; font-size: 28rpx; color: var(--on-surface-variant); }

/* QR 弹窗 */
.qr-modal-card { background: var(--surface-container-lowest); border-radius: var(--radius-lg); width: 100%; max-width: 680rpx; padding: var(--space-lg); box-shadow: var(--shadow-modal); }
.qr-modal-header { display: flex; align-items: center; justify-content: space-between; padding-bottom: var(--space-sm); }
.qr-modal-title { font-size: 36rpx; font-weight: 600; color: var(--on-surface); display: block; }
.qr-modal-sub { font-size: 24rpx; color: var(--on-surface-variant); display: block; }
.qr-modal-body { display: flex; flex-direction: column; align-items: center; justify-content: center; background: var(--surface-container-low); border-radius: var(--radius-lg); padding: var(--space-lg); margin: var(--space-md) 0; }
.qr-modal-img { width: 384rpx; height: 384rpx; border-radius: var(--radius-default); background: var(--surface-container-lowest); padding: 16rpx; box-shadow: var(--shadow-card); }
.qr-modal-img-placeholder { width: 384rpx; height: 384rpx; border-radius: var(--radius-default); background: var(--surface-container-lowest); display: flex; align-items: center; justify-content: center; font-size: 48rpx; color: var(--outline); }
.qr-modal-room { margin-top: 20rpx; font-size: 28rpx; font-weight: 600; color: var(--on-surface); }
.qr-modal-tip { margin-top: 8rpx; font-size: 20rpx; color: var(--outline); text-align: center; }
/* 台码加载中 / 加载失败（失败态整块可点重试） */
.qr-modal-loading { width: 384rpx; height: 384rpx; border-radius: var(--radius-default); background: var(--surface-container-lowest); display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 24rpx; }
.qr-modal-retry { flex-direction: column; gap: 16rpx; }
.qr-modal-retry:active { opacity: 0.7; }
.qr-modal-retry-icon { font-size: 64rpx; line-height: 1; color: var(--primary); }
/* loading / 失败态内部已有 gap，去掉 tip 自带的 margin-top，避免间距叠加 */
.qr-modal-loading .qr-modal-tip,
.qr-modal-retry .qr-modal-tip { margin-top: 0; font-size: 24rpx; }
.qr-modal-btn { position: relative; height: 88rpx; border-radius: var(--radius-md); background: var(--primary); color: var(--on-primary); display: flex; align-items: center; justify-content: center; gap: 12rpx; font-size: 28rpx; font-weight: 600; }
.qr-modal-btn-icon { width: 48rpx; height: 48rpx; padding: 6rpx; background: #ffffff; border-radius: 50%; box-sizing: border-box; }
.qr-modal-btn-active { opacity: 0.85; }
.qr-modal-btn-hit { position: absolute; top: 0; left: 0; width: 100%; height: 100%; opacity: 0; margin: 0; padding: 0; border: none; border-radius: var(--radius-md); }
.qr-modal-btn-hit::after { display: none; }

/* 比分抽屉 */
.score-sheet { background: var(--surface-container-lowest); border-top-left-radius: var(--radius-xl); border-top-right-radius: var(--radius-xl); width: 100%; max-width: 960rpx; padding: var(--space-lg); box-shadow: var(--shadow-modal); }
.score-sheet-header { display: flex; align-items: flex-start; gap: 20rpx; padding-bottom: var(--space-md); }
.score-sheet-icon { width: 72rpx; height: 72rpx; border-radius: 50%; background: rgba(0,82,53,0.08); display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
.score-sheet-icon image { width: 44rpx; height: 44rpx; }
.score-sheet-heading { flex: 1; min-width: 0; }
.score-sheet-title { font-size: 34rpx; font-weight: 700; color: var(--on-surface); display: block; line-height: 1.35; }
.score-sheet-name { color: var(--primary); font-weight: 700; }
.score-sheet-sub { font-size: 24rpx; color: var(--on-surface-variant); display: block; margin-top: 6rpx; }

.score-amount-box { display: flex; align-items: center; justify-content: space-between; background: rgba(0,82,53,0.05); border: 2rpx solid rgba(0,82,53,0.12); border-radius: var(--radius-lg); padding: 28rpx 24rpx; }
.score-step-btn { width: 88rpx; height: 88rpx; border-radius: var(--radius-default); background: var(--surface-container-lowest); border: 2rpx solid rgba(0,82,53,0.14); display: flex; align-items: center; justify-content: center; font-size: 40rpx; font-weight: 700; color: var(--primary); flex-shrink: 0; }
.score-step-btn:active { background: rgba(0,82,53,0.08); }
.score-amount-center { flex: 1; min-width: 0; display: flex; flex-direction: column; align-items: center; }
.score-amount-label { font-size: 24rpx; color: var(--on-surface-variant); }
.score-amount-value { display: flex; align-items: baseline; justify-content: center; margin-top: 4rpx; }
/* 宽度按 3 位数留量：76rpx 粗体数字一位约 42rpx，「100」约 126rpx，
   原来 120rpx 会裁掉最后一位（含光标），放到 220rpx 才够 */
.score-amount-input { width: 220rpx; height: 88rpx; font-size: 76rpx; font-weight: 700; color: var(--primary); text-align: center; }
/* 空态占位：抽屉打开即聚焦会清空默认 0，用灰色 0 占位，避免看起来是个空框 */
.score-amount-ph { color: var(--on-surface-variant); font-weight: 700; }
.score-amount-unit { font-size: 30rpx; font-weight: 600; color: var(--primary); margin-left: 4rpx; }

.score-preset-label { font-size: 24rpx; color: var(--on-surface-variant); display: block; margin: var(--space-md) 0 var(--space-xs); }
/* 预设已上膛：文案转绿加粗，提示「再点一下即刻转出」 */
.score-preset-label-on { color: var(--primary); font-weight: 600; }
.score-preset-row { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--gutter-grid); }
.score-preset-btn { height: 88rpx; border-radius: var(--radius-default); background: var(--surface-container-lowest); border: 2rpx solid var(--outline-variant); display: flex; align-items: center; justify-content: center; font-size: 28rpx; font-weight: 700; color: var(--on-surface); }
.score-preset-on { border: 4rpx solid var(--primary); background: rgba(0,82,53,0.06); color: var(--primary); }

/* 给分标签（可多选）：6 个一排的次级胶囊，选中转绿（比预设更轻，不抢主操作视线） */
.score-tag-label { font-size: 24rpx; color: var(--on-surface-variant); display: block; margin: var(--space-md) 0 var(--space-xs); }
.score-tag-hint { font-size: 20rpx; color: var(--outline); }
.score-tag-row { display: grid; grid-template-columns: repeat(6, 1fr); gap: 12rpx; }
.score-tag { height: 72rpx; border-radius: var(--radius-default); background: var(--surface-container); border: 2rpx solid var(--outline-variant); display: flex; align-items: center; justify-content: center; }
.score-tag text { font-size: 24rpx; font-weight: 500; color: var(--on-surface-variant); }
.score-tag-on { background: rgba(0,82,53,0.10); border-color: var(--primary); }
.score-tag-on text { color: var(--primary); font-weight: 700; }

.score-submit-btn { margin-top: var(--space-lg); height: 96rpx; border-radius: var(--radius-md); background: var(--primary); color: var(--on-primary); display: flex; align-items: center; justify-content: center; gap: 12rpx; font-size: 30rpx; font-weight: 600; }
.score-submit-btn-off { opacity: 0.45; }
.score-submit-icon { width: 36rpx; height: 36rpx; }

/* 换位弹窗 */
.swap-modal-card { background: var(--surface-container-lowest); border-radius: var(--radius-lg); max-width: 640rpx; width: 100%; padding: var(--space-lg); box-shadow: var(--shadow-modal); display: flex; flex-direction: column; align-items: center; gap: var(--space-sm); }
.swap-modal-icon { width: 48rpx; height: 48rpx; }
.swap-modal-icon image { width: 48rpx; height: 48rpx; }
.swap-modal-title { font-size: 36rpx; font-weight: 600; color: var(--on-surface); text-align: center; }
.swap-modal-desc { font-size: 28rpx; color: var(--on-surface-variant); text-align: center; }
.swap-modal-tip { background: var(--surface-container-low); border-radius: var(--radius-default); padding: 16rpx; }
.swap-modal-tip text { font-size: 20rpx; color: var(--outline); }
.swap-modal-actions { display: grid; grid-template-columns: 1fr 1fr; gap: var(--gutter-grid); margin-top: var(--space-md); width: 100%; }
.swap-cancel-btn { height: 80rpx; border-radius: var(--radius-md); background: var(--surface-container); color: var(--on-surface); display: flex; align-items: center; justify-content: center; font-size: 24rpx; font-weight: 500; }
.swap-confirm-btn { height: 80rpx; border-radius: var(--radius-md); background: var(--primary); color: var(--on-primary); display: flex; align-items: center; justify-content: center; font-size: 24rpx; font-weight: 500; }
/* 台主专用：移出牌台（次要、危险动作，放在换位弹窗底部） */
.swap-kick-btn { width: 100%; height: 72rpx; margin-top: var(--space-xs); border-radius: var(--radius-md); background: var(--surface-container); color: var(--tertiary); display: flex; align-items: center; justify-content: center; font-size: 24rpx; font-weight: 500; }
.swap-kick-btn:active { opacity: 0.75; }

/* Toast */
.toast { position: fixed; top: 160rpx; left: 50%; transform: translateX(-50%); z-index: 200; background: rgba(33, 49, 69, 0.9); color: var(--inverse-on-surface); padding: 16rpx 32rpx; border-radius: var(--radius-full); font-size: 24rpx; box-shadow: var(--shadow-modal); opacity: 0; transition: opacity 0.3s ease; pointer-events: none; }
.toast.toast-show { opacity: 1; }

/* 底部操作栏：设计稿无底色 + sticky 跟随内容（不用 fixed——快速滚动时 fixed 层会丢帧，
 * 表现为按钮消失但命中区还在）。margin-top:auto 保证内容不足一屏时也贴底。 */
.room-footer { position: sticky; bottom: 0; z-index: 50; margin-top: auto; padding: 12rpx var(--margin-screen) calc(env(safe-area-inset-bottom) + 8rpx); display: flex; align-items: center; gap: 24rpx; }
.foot-btn { flex: 1; display: flex; align-items: center; justify-content: center; gap: 10rpx; height: 88rpx; border-radius: var(--radius-md); background: var(--surface-container-lowest); box-shadow: 0 8rpx 24rpx rgba(11, 28, 48, 0.1); box-sizing: border-box; }
.foot-btn:active { background: var(--surface-container-low); }
.foot-btn-text { font-size: 26rpx; font-weight: 600; color: var(--on-surface); }
.foot-btn-icon { width: 32rpx; height: 32rpx; }
.foot-btn-danger .foot-btn-text { color: var(--tertiary); }

/* ========== 席位互动道具 fx 层（动画移植自 docs/design/room-donghua/code.html） ==========
 * 只做动画不改桌面样式；fx 元素 left/top 由 room.js 的 selectorQuery 注入（px，相对 .table-stage）。 */
.fx-stage { position: absolute; left: 0; top: 0; right: 0; bottom: 0; z-index: 30; overflow: hidden; pointer-events: none; }

/* 全桌地震（作用在 .table-stage 上，与圆角/让位等静态 transform 无冲突） */
@keyframes fxTableQuake {
  0% { transform: translate(0, 0) rotate(0deg); }
  10% { transform: translate(-9px, -12px) rotate(-2.8deg) scale(1.02); }
  25% { transform: translate(11px, 8px) rotate(2.4deg) scale(0.98); }
  40% { transform: translate(-10px, 6px) rotate(-1.5deg); }
  55% { transform: translate(8px, -5px) rotate(1.2deg); }
  70% { transform: translate(-5px, 3px) rotate(-0.6deg); }
  85% { transform: translate(3px, -2px) rotate(0.3deg); }
  100% { transform: translate(0, 0) rotate(0deg) scale(1); }
}
.table-stage.fx-quake { animation: fxTableQuake 0.75s cubic-bezier(.36,.07,.19,.97) both; }

/* 目标头像：命中抖动 / 被踢弹飞（作用在 .side-fill 上） */
@keyframes fxHeadHitShake {
  0% { transform: translate(0, 0) rotate(0deg); }
  15% { transform: translate(-8px, 6px) rotate(-12deg) scale(0.92); }
  30% { transform: translate(7px, -4px) rotate(10deg); }
  45% { transform: translate(-5px, 3px) rotate(-6deg); }
  60% { transform: translate(4px, -2px) rotate(4deg); }
  80% { transform: translate(-2px, 1px) rotate(-1deg); }
  100% { transform: translate(0, 0) rotate(0deg) scale(1); }
}
.side-fill.fx-hit-shake { animation: fxHeadHitShake 0.65s cubic-bezier(.36,.07,.19,.97) both; }
@keyframes fxAvatarKick {
  0% { transform: translate(0, 0) scale(1) rotate(0deg); }
  20% { transform: translate(-22px, -32px) scale(0.7, 1.35) rotate(-28deg); }
  45% { transform: translate(18px, 14px) scale(1.28, 0.75) rotate(18deg); }
  65% { transform: translate(-8px, -6px) scale(0.92, 1.08) rotate(-8deg); }
  85% { transform: translate(4px, 2px) scale(1.04, 0.96) rotate(4deg); }
  100% { transform: translate(0, 0) scale(1) rotate(0deg); }
}
.side-fill.fx-avatar-kick { animation: fxAvatarKick 0.85s cubic-bezier(.22,1,.36,1) both; }

/* 1. 扔飞拖鞋：外层管 X（匀速）、内层管 Y+旋转+缩放（合成抛物线，坐标用 CSS 变量注入） */
.fx-slipper { position: absolute; left: -52rpx; top: -52rpx; width: 104rpx; height: 104rpx; z-index: 5; animation: fxSlipperX 0.65s linear both; }
.fx-slipper-inner { width: 100%; height: 100%; animation: fxSlipperArc 0.65s ease-in-out both; }
.fx-slipper-inner image { width: 100%; height: 100%; filter: drop-shadow(0 8rpx 12rpx rgba(0,0,0,0.5)); }
@keyframes fxSlipperX { from { transform: translateX(var(--sx)); } to { transform: translateX(var(--dx)); } }
@keyframes fxSlipperArc {
  0% { transform: translateY(var(--sy)) rotate(0deg) scale(0.6); }
  25% { transform: translateY(calc(var(--sy) + (var(--dy) - var(--sy)) * 0.25 - 155rpx)) rotate(180deg) scale(0.95); }
  50% { transform: translateY(calc(var(--sy) + (var(--dy) - var(--sy)) * 0.5 - 220rpx)) rotate(360deg) scale(1.1); }
  75% { transform: translateY(calc(var(--sy) + (var(--dy) - var(--sy)) * 0.75 - 155rpx)) rotate(540deg) scale(0.95); }
  100% { transform: translateY(var(--dy)) rotate(720deg) scale(0.6); }
}
.fx-stars-label { position: absolute; top: 96rpx; left: 50%; transform: translateX(-50%); padding: 6rpx 20rpx; border-radius: 999rpx; background: rgba(0,0,0,0.75); white-space: nowrap; z-index: 3; }
.fx-stars-label text { font-size: 20rpx; color: #fef08a; font-weight: 700; }
/* 命中星芒 */
.fx-stars { position: absolute; width: 180rpx; height: 180rpx; margin-left: -90rpx; margin-top: -90rpx; display: flex; align-items: center; justify-content: center; opacity: 0; z-index: 6; }
.fx-stars.fx-on { opacity: 1; }
.fx-stars .fx-star { position: absolute; font-size: 72rpx; color: #fde047; animation: fxStarPop 0.7s ease-out forwards; }
.fx-stars .fx-star-b { position: absolute; top: -8rpx; right: -8rpx; font-size: 44rpx; animation: fxPing 1s cubic-bezier(0, 0, 0.2, 1) infinite; }
.fx-stars .fx-star-c { position: absolute; bottom: -4rpx; left: -8rpx; font-size: 36rpx; animation: fxBounce 1s infinite; }
@keyframes fxStarPop { 0% { transform: scale(0) rotate(0deg); opacity: 1; } 50% { transform: scale(1.4) rotate(90deg); opacity: 1; } 100% { transform: scale(1.8) rotate(180deg); opacity: 0; } }

/* 2. 台下猛踢：大脚破屏 + 三重冲击波 + 火花 */
.fx-foot { position: absolute; font-size: 144rpx; z-index: 8; filter: drop-shadow(0 16px 24px rgba(0,0,0,0.6)); opacity: 0; }
.fx-foot.fx-run { animation: fxFootSweep 0.75s cubic-bezier(.17,.89,.32,1.28) forwards; }
@keyframes fxFootSweep {
  0% { transform: translate3d(240px, 180px, 0) rotate(-65deg) scale(0.3); opacity: 0; }
  25% { opacity: 1; transform: translate3d(80px, 40px, 0) rotate(-35deg) scale(1.4); }
  45% { transform: translate3d(0, 0, 0) rotate(8deg) scale(1.65); }
  65% { transform: translate3d(-20px, -12px) rotate(12deg) scale(1.4); opacity: 1; }
  100% { transform: translate3d(-160px, -80px, 0) rotate(35deg) scale(0.5); opacity: 0; }
}
.fx-shock-center { position: absolute; width: 0; height: 0; }
.fx-shock { position: absolute; border-radius: 50%; opacity: 0; transform: translate(-50%, -50%) scale(0.2); }
.fx-shock-1 { width: 224rpx; height: 224rpx; border: 8rpx solid #fcd34d; box-shadow: 0 0 24rpx rgba(251,191,36,0.9); }
.fx-shock-2 { width: 288rpx; height: 288rpx; border: 4rpx solid #6ee7b7; box-shadow: 0 0 18rpx rgba(52,211,153,0.8); }
.fx-shock-3 { width: 352rpx; height: 352rpx; border: 2rpx solid #f87171; }
.fx-shock.fx-run-1 { animation: fxShockExpand 0.7s cubic-bezier(0.1, 0.8, 0.2, 1) forwards; }
.fx-shock.fx-run-2 { animation: fxShockExpand 0.7s cubic-bezier(0.1, 0.8, 0.2, 1) 0.12s forwards; }
.fx-shock.fx-run-3 { animation: fxShockExpand 0.7s cubic-bezier(0.1, 0.8, 0.2, 1) 0.22s forwards; }
@keyframes fxShockExpand {
  0% { transform: translate(-50%, -50%) scale(0.2); opacity: 1; border-width: 8rpx; }
  50% { opacity: 0.9; }
  100% { transform: translate(-50%, -50%) scale(3.2); opacity: 0; border-width: 2rpx; }
}
.fx-sparks { position: absolute; width: 0; height: 0; display: flex; align-items: center; justify-content: center; opacity: 0; z-index: 7; }
.fx-sparks.fx-on { opacity: 1; }
.fx-sparks text { position: absolute; font-size: 64rpx; animation: fxPing 1s cubic-bezier(0, 0, 0.2, 1) infinite; }
.fx-sparks .fx-spark-b { top: -32rpx; right: -48rpx; font-size: 44rpx; animation: fxBounce 1s infinite; }
.fx-sparks .fx-spark-c { bottom: -40rpx; left: -40rpx; font-size: 40rpx; animation: fxSpin 1s linear infinite; }
.fx-sparks .fx-spark-tag { position: absolute; top: -64rpx; left: 16rpx; padding: 4rpx 16rpx; border-radius: 8rpx; background: #8e1215; color: #fff; font-size: 22rpx; font-weight: 700; animation: fxPulse 2s cubic-bezier(0.4, 0, 0.6, 1) infinite; }
@keyframes fxPing { 75%, 100% { transform: scale(2); opacity: 0; } }
@keyframes fxBounce { 0%, 100% { transform: translateY(-25%); animation-timing-function: cubic-bezier(0.8, 0, 1, 1); } 50% { transform: none; animation-timing-function: cubic-bezier(0, 0, 0.2, 1); } }
@keyframes fxSpin { to { transform: rotate(360deg); } }
@keyframes fxPulse { 50% { opacity: 0.5; } }

/* 3. 花儿谢了：愁云雨丝 + 寒风 + 枯萎 + 花瓣飘落 + 粤语气泡 */
.fx-flower { position: absolute; display: flex; flex-direction: column; align-items: center; opacity: 0; transition: opacity 0.3s ease; z-index: 9; }
.fx-flower.fx-on { opacity: 1; }
.fx-flower-cloud { display: flex; align-items: center; opacity: 0.9; }
.fx-flower-cloud text { font-size: 56rpx; }
.fx-flower-cloud text + text { font-size: 44rpx; margin-left: -16rpx; }
.fx-rain { display: flex; align-items: center; gap: 8rpx; margin-top: -4rpx; }
.fx-rain view { width: 4rpx; border-radius: 4rpx; background: rgba(147, 197, 253, 0.8); animation: fxRainDrop 0.85s linear infinite; }
.fx-rain .r1 { height: 14rpx; }
.fx-rain .r2 { height: 18rpx; background: rgba(191, 219, 254, 0.9); animation-delay: 0.28s; }
.fx-rain .r3 { height: 12rpx; background: rgba(147, 197, 253, 0.7); animation-delay: 0.55s; }
@keyframes fxRainDrop { 0% { transform: translateY(0); opacity: 0; } 30% { opacity: 0.9; } 100% { transform: translateY(32rpx); opacity: 0; } }
.fx-wind { position: absolute; left: 0; right: 0; top: 48rpx; display: flex; flex-direction: column; gap: 8rpx; }
.fx-wind view { height: 2rpx; border-radius: 4rpx; background: rgba(255,255,255,0.7); animation: fxWindBreeze 1.3s ease-out infinite; }
.fx-wind .w2 { width: 48rpx; background: rgba(224, 242, 254, 0.6); animation-delay: 0.4s; }
@keyframes fxWindBreeze { 0% { transform: translateX(-120rpx) scaleY(0.7); opacity: 0; } 40% { opacity: 0.85; } 100% { transform: translateX(180rpx) scaleY(1.2); opacity: 0; } }
.fx-flower-stem { position: relative; margin-top: 4rpx; display: flex; flex-direction: column; align-items: center; transform-origin: bottom center; }
.fx-flower-stem.fx-run-droop { animation: fxStemDroop 2.4s cubic-bezier(.42,0,.58,1) forwards; }
.fx-flower-head { font-size: 64rpx; filter: saturate(1.4) brightness(1.1); }
.fx-stem { width: 4rpx; height: 28rpx; border-radius: 4rpx; background: #40614f; transform-origin: bottom center; }
@keyframes fxStemDroop {
  0% { transform: rotate(0deg) scale(1); }
  35% { transform: rotate(-8deg) scale(1); }
  70% { transform: rotate(42deg) translate(8rpx, 12rpx) scale(0.92); }
  100% { transform: rotate(62deg) translate(14rpx, 20rpx) scale(0.85); }
}
.fx-petals { position: absolute; top: 96rpx; left: 50%; margin-left: -20rpx; }
.fx-petals text { position: absolute; opacity: 0; }
.fx-petals .p1 { font-size: 32rpx; color: rgba(225, 29, 72, 0.9); }
.fx-petals .p2 { font-size: 28rpx; color: rgba(190, 18, 60, 0.85); }
.fx-petals .p3 { font-size: 24rpx; color: rgba(159, 18, 57, 0.8); }
.fx-petals .p1.fx-run { animation: fxPetalFall1 2.2s cubic-bezier(0.25, 0.46, 0.45, 0.94) forwards; }
.fx-petals .p2.fx-run { animation: fxPetalFall2 2.5s cubic-bezier(0.25, 0.46, 0.45, 0.94) 0.15s forwards; }
.fx-petals .p3.fx-run { animation: fxPetalFall3 2.1s cubic-bezier(0.25, 0.46, 0.45, 0.94) 0.3s forwards; }
@keyframes fxPetalFall1 { 0% { transform: translate(0,0) rotate(0deg) scale(1); opacity: 1; } 40% { transform: translate(-36rpx, 56rpx) rotate(85deg) scale(0.9); } 75% { transform: translate(24rpx, 110rpx) rotate(190deg) scale(0.8); opacity: 0.8; } 100% { transform: translate(-16rpx, 190rpx) rotate(310deg) scale(0.6); opacity: 0; } }
@keyframes fxPetalFall2 { 0% { transform: translate(0,0) rotate(0deg) scale(1); opacity: 1; } 35% { transform: translate(44rpx, 48rpx) rotate(-70deg) scale(0.9); } 70% { transform: translate(-28rpx, 116rpx) rotate(-160deg) scale(0.75); opacity: 0.8; } 100% { transform: translate(32rpx, 180rpx) rotate(-260deg) scale(0.5); opacity: 0; } }
@keyframes fxPetalFall3 { 0% { transform: translate(0,0) rotate(0deg) scale(1); opacity: 1; } 50% { transform: translate(-16rpx, 76rpx) rotate(120deg) scale(0.85); } 100% { transform: translate(-40rpx, 170rpx) rotate(240deg) scale(0.55); opacity: 0; } }
.fx-flower-bubble { margin-top: 8rpx; padding: 8rpx 20rpx; border-radius: 999rpx; background: rgba(0,0,0,0.75); border: 2rpx solid rgba(255,255,255,0.2); opacity: 0; transform: translateY(8rpx); transition: all 0.5s ease; white-space: nowrap; }
.fx-flower-bubble.fx-on { opacity: 1; transform: translateY(0); }
.fx-flower-bubble text { font-size: 20rpx; color: #fef08a; font-weight: 700; }

/* 4. 斟杯靓茶：紫砂壶飞入倾斜 + 金黄茶汤 + 水位涟漪白雾 */
.fx-tea-teapot { position: absolute; width: 210rpx; height: 170rpx; z-index: 6; transition: transform 0.5s ease-out; filter: drop-shadow(0 12px 16px rgba(0,0,0,0.5)); }
.fx-tea-teapot.fx-tilt { transform: rotate(-42deg); }
.fx-tea-teapot image { width: 100%; height: 100%; }
/* 弧形水流：wrapper 按 JS 算出的角度旋转（transform-origin 固定在壶嘴端），茶汤沿弧线拉出 */
.fx-tea-stream { position: absolute; z-index: 5; opacity: 0; transform-origin: 73.3% 5%; transition: opacity 0.25s ease; pointer-events: none; }
.fx-tea-stream.fx-on { opacity: 1; }
.fx-tea-stream image { width: 100%; height: 100%; transform-origin: 73.3% 5%; transform: scaleY(0.12); transition: transform 0.4s ease-out; filter: drop-shadow(0 0 8rpx rgba(234, 179, 8, 0.65)); }
.fx-tea-stream.fx-on image { transform: scaleY(1); }
.fx-tea-cup { position: absolute; display: flex; flex-direction: column; align-items: center; z-index: 6; }
.fx-tea-cup .cup-body { position: relative; width: 88rpx; height: 88rpx; border-radius: 50%; background: rgba(255,251,235,0.95); border: 4rpx solid #fcd34d; box-shadow: var(--shadow-card); display: flex; align-items: center; justify-content: center; overflow: hidden; }
.fx-tea-cup .cup-water { width: 64rpx; height: 64rpx; border-radius: 50%; background: rgba(217,119,6,0.85); display: flex; align-items: center; justify-content: center; transform: scale(0.9); transition: transform 0.5s ease; }
.fx-tea-cup .cup-water.fx-on { transform: scale(1.05); }
.fx-tea-cup .cup-water text { font-size: 18rpx; color: #451a03; font-weight: 700; }
.fx-tea-cup .cup-label { margin-top: 4rpx; padding: 2rpx 12rpx; border-radius: 999rpx; background: rgba(0,0,0,0.6); font-size: 18rpx; color: #fde68a; font-weight: 600; }
.fx-steam { position: absolute; left: 0; right: 0; top: -28rpx; display: flex; align-items: flex-end; justify-content: center; gap: 6rpx; }
.fx-steam view { border-radius: 999rpx; background: rgba(255,255,255,0.8); filter: blur(2rpx); animation: fxTeaSteam 1.6s ease-out infinite; }
.fx-steam .s1 { width: 6rpx; height: 24rpx; }
.fx-steam .s2 { width: 8rpx; height: 30rpx; background: rgba(255,255,255,0.9); animation-delay: 0.5s; }
.fx-steam .s3 { width: 6rpx; height: 20rpx; background: rgba(255,255,255,0.6); }
@keyframes fxTeaSteam { 0% { transform: translateY(0) scaleX(0.8); opacity: 0; } 40% { opacity: 0.75; } 100% { transform: translateY(-48rpx) scaleX(1.3); opacity: 0; } }

/* 5. 丢番茄：阶段一 飞行番茄（CSS 变量坐标 + 抛物线弧 + 680° 旋转） */
.fx-tomato-fly { position: absolute; left: -26px; top: -26px; width: 52px; height: 52px; z-index: 10; animation: fxTomatoFlyX 0.54s linear both; }
.fx-tomato-fly image { width: 100%; height: 100%; filter: drop-shadow(0 8px 18px rgba(220,38,38,0.85)); animation: fxTomatoFlyArc 0.54s cubic-bezier(.25,.46,.45,.94) both; }
@keyframes fxTomatoFlyX { from { transform: translateX(var(--sx)); } to { transform: translateX(var(--dx)); } }
@keyframes fxTomatoFlyArc {
  0% { transform: translateY(var(--sy)) scale(0.85) rotate(0deg); }
  50% { transform: translateY(calc(var(--sy) + (var(--dy) - var(--sy)) * 0.5 - 190rpx)) scale(1.3) rotate(340deg); }
  100% { transform: translateY(var(--dy)) scale(1.15) rotate(680deg); }
}
/* 阶段二 爆浆舞台：锚定头像正中心 */
.fx-tomato-stage { position: absolute; transform: translate(-50%, -50%); width: 0; height: 0; z-index: 9; transition: opacity 0.4s ease; }
.fx-tomato-stage.fx-fade { opacity: 0; }
/* 剧烈爆炸冲击波光晕 */
.fx-tomato-blast { position: absolute; left: -120rpx; top: -120rpx; width: 240rpx; height: 240rpx; border-radius: 50%; background: radial-gradient(circle, rgba(251,191,36,0.9) 0%, rgba(220,38,38,0.55) 55%, rgba(220,38,38,0) 75%); filter: blur(6rpx); animation: fxTomatoBlast 0.45s ease-out both; }
@keyframes fxTomatoBlast { 0% { transform: scale(0.1); opacity: 0.95; } 100% { transform: scale(2.6); opacity: 0; } }
/* 四分五裂碎块粒子（6 个，per-frag CSS 变量方向爆散） */
.fx-frag { position: absolute; left: -20rpx; top: -20rpx; width: 40rpx; height: 40rpx; display: flex; align-items: center; justify-content: center; animation: fxFragBurst 0.65s cubic-bezier(.1,.9,.2,1) 0.05s both; }
.fx-frag-emoji { font-size: 36rpx; }
.fx-frag-dot { width: 28rpx; height: 28rpx; border-radius: 50%; background: #b91c1c; }
.fx-frag-dot.d2 { background: #ef4444; }
.fx-frag-chip { width: 32rpx; height: 20rpx; border-radius: 8rpx; background: #dc2626; transform: rotate(45deg); }
.fx-frag-stem { width: 16rpx; height: 32rpx; border-radius: 8rpx; background: #16a34a; transform: rotate(12deg); }
@keyframes fxFragBurst { 0% { transform: translate(0,0) scale(1.4); opacity: 1; } 100% { transform: translate(var(--tx), var(--ty)) scale(0.2) rotate(var(--rot)); opacity: 0; } }
/* 大爆浆主图（200x200 设计稿 SVG） */
.fx-tomato-big { position: absolute; left: -88px; top: -88px; width: 176px; height: 176px; filter: drop-shadow(0 6px 16px rgba(153,27,27,0.85)); animation: fxTomatoBigPop 0.5s cubic-bezier(.34,1.56,.64,1) both; }
@keyframes fxTomatoBigPop { 0% { transform: scale(0.3) rotate(-18deg); opacity: 0.7; } 100% { transform: scale(1) rotate(0deg); opacity: 1; } }
/* 粤语催牌气泡 */
.fx-tomato-bubble { position: absolute; left: 50%; transform: translateX(-50%); top: -170rpx; padding: 10rpx 24rpx; border-radius: 999rpx; background: rgba(69,10,10,0.95); border: 2rpx solid rgba(239,68,68,0.8); box-shadow: 0 8rpx 20rpx rgba(185,28,28,0.6); white-space: nowrap; animation: fxTomatoBigPop 0.4s cubic-bezier(.34,1.56,.64,1) both; }
.fx-tomato-bubble text { font-size: 22rpx; color: #fef08a; font-weight: 800; }
/* 南位（top）贴舞台顶部：气泡向上会被 overflow:hidden 裁掉，翻到头像下方 */
.fx-tomato-bubble.fx-bubble-below { top: 130rpx; }
/* 头像脸上番茄酱层（溢出裁圆 + 显现流淌动画） */
.face-sauce { position: absolute; left: 0; top: 0; right: 0; bottom: 0; border-radius: 50%; overflow: hidden; opacity: 0; pointer-events: none; z-index: 2; }
.face-sauce.fx-sauce-on { animation: fxFaceStain 3.2s cubic-bezier(.16,1,.3,1) both; }
.face-sauce image { width: 100%; height: 100%; }
@keyframes fxFaceStain {
  0% { opacity: 0; transform: scale(0.3) rotate(-15deg); }
  20% { opacity: 1; transform: scale(1.15) rotate(4deg); }
  40% { opacity: 1; transform: scale(1) rotate(0deg); }
  85% { opacity: 0.95; }
  100% { opacity: 0; transform: scale(0.96) translateY(6rpx); }
}
/* 番茄重击：头像剧震后仰与颠簸 */
.fx-tomato-heavy { animation: fxTomatoHeavy 1.1s cubic-bezier(.2,.85,.3,1.1) both; }
@keyframes fxTomatoHeavy {
  0% { transform: scale(1) translate(0,0) rotate(0deg); }
  10% { transform: scale(0.72) translate(4px,12px) rotate(18deg); filter: brightness(1.4); }
  20% { transform: scale(1.15) translate(-14px,-8px) rotate(-16deg); }
  32% { transform: scale(0.92) translate(10px,8px) rotate(12deg); }
  45% { transform: scale(1.06) translate(-8px,-6px) rotate(-8deg); }
  60% { transform: scale(0.97) translate(6px,4px) rotate(6deg); }
  75% { transform: scale(1.02) translate(-3px,-2px) rotate(-3deg); }
  90% { transform: scale(0.99) translate(1px,1px) rotate(1deg); }
  100% { transform: scale(1) translate(0,0) rotate(0deg); filter: brightness(1); }
}

/* 7. 给分动画（docs/design/geifendonghua）：-N 下沉 + 4 枚筹码抛物线 + 到账 Q 弹/波纹/+N 浮升 */
.fx-give-badge { position: absolute; transform: translate(-50%, 0); padding: 4rpx 18rpx; border-radius: var(--radius-full); font-size: 26rpx; font-weight: 700; white-space: nowrap; z-index: 12; }
.fx-give-minus { background: rgba(186, 26, 26, 0.9); color: #ffffff; border: 2rpx solid rgba(255, 255, 255, 0.4); box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.25); animation: fxGiveSink 1.6s cubic-bezier(0.22, 1, 0.36, 1) both; }
.fx-give-plus { background: var(--primary); color: var(--on-primary); border: 2rpx solid var(--primary-fixed-dim); box-shadow: 0 8rpx 24rpx rgba(0, 82, 53, 0.35); animation: fxGiveFloat 1.75s cubic-bezier(0.22, 1, 0.36, 1) both; }
@keyframes fxGiveSink {
  0% { opacity: 0; transform: translate(-50%, -10rpx) scale(0.8); }
  25% { opacity: 1; transform: translate(-50%, 8rpx) scale(1.05); }
  70% { opacity: 0.9; transform: translate(-50%, 28rpx) scale(1); }
  100% { opacity: 0; transform: translate(-50%, 52rpx) scale(0.85); }
}
@keyframes fxGiveFloat {
  0% { opacity: 0; transform: translate(-50%, 20rpx) scale(0.65); }
  20% { opacity: 1; transform: translate(-50%, -12rpx) scale(1.12); }
  40% { transform: translate(-50%, -28rpx) scale(1); }
  75% { opacity: 1; transform: translate(-50%, -48rpx) scale(0.98); }
  100% { opacity: 0; transform: translate(-50%, -72rpx) scale(0.9); }
}
/* 筹码：外层管 X（加速冲向目标），内层管 Y 抛物弧 + 720° 旋转 + 中段放大 */
.fx-give-coin { position: absolute; left: 0; top: 0; width: 44rpx; height: 44rpx; margin: -22rpx 0 0 -22rpx; z-index: 11; animation: fxGiveCoinX 650ms cubic-bezier(0.5, 0, 0.85, 0.5) both; }
.fx-give-coin-inner { width: 100%; height: 100%; border-radius: 999rpx; background: radial-gradient(circle at 35% 30%, #fff7d6, #fe932c 60%, #b05c00 100%); box-shadow: 0 0 20rpx rgba(254, 147, 44, 0.7), inset 0 2rpx 2rpx rgba(255, 255, 255, 0.8), 0 4rpx 10rpx rgba(0, 0, 0, 0.3); border: 2rpx solid #fef08a; display: flex; align-items: center; justify-content: center; animation: fxGiveCoinArc 650ms cubic-bezier(0.25, 0.46, 0.45, 0.94) both; }
.fx-give-coin-inner text { font-size: 22rpx; font-weight: 800; color: #78350f; }
@keyframes fxGiveCoinX { from { transform: translateX(var(--sx)); } to { transform: translateX(var(--dx)); } }
@keyframes fxGiveCoinArc {
  0% { transform: translateY(var(--sy)) rotate(0deg) scale(0.85); }
  50% { transform: translateY(calc(var(--sy) + (var(--dy) - var(--sy)) * 0.5 - 150rpx)) rotate(360deg) scale(1.35); }
  100% { transform: translateY(var(--dy)) rotate(720deg) scale(1.15); }
}
/* 到账：目标头像 Q 弹 + 翡翠金光波纹（给分专用，与道具 fx 互不复用） */
@keyframes fxGiveBounce {
  0% { transform: scale(1); }
  35% { transform: scale(1.18); }
  65% { transform: scale(0.96); }
  100% { transform: scale(1); }
}
.seat-avatar-wrap.fx-give-bounce { animation: fxGiveBounce 0.65s cubic-bezier(0.34, 1.56, 0.64, 1) both; }
.give-ripple { position: absolute; left: 0; top: 0; right: 0; bottom: 0; border-radius: 50%; border: 4rpx solid var(--primary-fixed-dim); background: rgba(0, 82, 53, 0.2); opacity: 0; pointer-events: none; z-index: 3; }
.give-ripple.give-ripple-on { animation: fxGiveRing 0.85s cubic-bezier(0.16, 1, 0.3, 1) forwards; }
@keyframes fxGiveRing {
  0% { transform: scale(0.85); opacity: 0.9; }
  100% { transform: scale(2.2); opacity: 0; }
}

/* 6. 台下猛踢的私密暗号气泡（桌面内浮层，非全局弹窗） */
.fx-banner { position: absolute; left: 24rpx; right: 24rpx; bottom: 24rpx; display: flex; align-items: center; gap: 12rpx; padding: 16rpx 20rpx; border-radius: 24rpx; background: rgba(33,49,69,0.95); border: 2rpx solid rgba(255,220,195,0.3); box-shadow: 0 16rpx 48rpx rgba(0,0,0,0.35); opacity: 0; transform: translateY(48rpx); transition: all 0.3s ease; z-index: 10; }
.fx-banner.fx-on { opacity: 1; transform: translateY(0); }
.fx-banner .banner-icon { font-size: 44rpx; animation: fxBounce 1s infinite; }
.fx-banner .banner-title { font-size: 24rpx; font-weight: 700; color: #ffdcc3; }
.fx-banner .banner-desc { font-size: 20rpx; color: rgba(234,241,255,0.9); margin-top: 2rpx; }

/* 道具抽屉（沿用现有 modal 风格） */
.prop-sheet { background: var(--surface-container-lowest); border-top-left-radius: var(--radius-xl); border-top-right-radius: var(--radius-xl); width: 100%; padding: var(--space-lg) var(--space-lg) calc(env(safe-area-inset-bottom) + var(--space-lg)); box-shadow: var(--shadow-modal); display: flex; flex-direction: column; }
.prop-head { display: flex; align-items: flex-start; justify-content: space-between; }
.prop-title { font-size: 34rpx; font-weight: 700; color: var(--on-surface); }
.prop-sub { font-size: 24rpx; color: var(--on-surface-variant); margin-top: 4rpx; }
.prop-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 20rpx; margin-top: 24rpx; }
.prop-card { display: flex; flex-direction: column; justify-content: space-between; min-height: 200rpx; padding: 24rpx; border-radius: var(--radius-lg); background: var(--surface-container-low); text-align: left; box-sizing: border-box; }
.prop-card:active { transform: scale(0.97); }
.prop-card-top { display: flex; align-items: center; justify-content: space-between; }
.prop-card-emoji { font-size: 52rpx; }
.prop-card-tag { font-size: 20rpx; padding: 4rpx 12rpx; border-radius: 8rpx; background: var(--surface-container-high); color: var(--on-surface-variant); font-weight: 600; }
.prop-card-name { font-size: 30rpx; font-weight: 700; color: var(--on-surface); margin-top: 16rpx; }
.prop-card-desc { font-size: 22rpx; color: var(--on-surface-variant); margin-top: 4rpx; }
.prop-card-hot { background: rgba(254, 243, 199, 0.8); border: 2rpx solid rgba(253, 230, 138, 0.8); }
.prop-card-hot .prop-card-name { color: #78350f; }
.prop-card-hot .prop-card-desc { color: #92400e; }
.prop-card-warm { background: rgba(255, 241, 242, 0.8); border: 2rpx solid rgba(254, 202, 202, 0.8); }
.prop-card-warm .prop-card-name { color: #881337; }
.prop-card-warm .prop-card-desc { color: #9f1239; }
.prop-card-wide { grid-column: span 2; flex-direction: row; align-items: center; justify-content: space-between; min-height: 140rpx; }
.prop-card-wide .prop-card-emoji { margin-right: 20rpx; }
.prop-foot-tip { margin-top: 24rpx; font-size: 22rpx; color: var(--outline); text-align: center; }
.prop-card-name, .prop-card-desc, .banner-title, .banner-desc { display: block; }
