<!--pages/score/score.wxml — 记分页-->
<view class="container" wx:if="{{!loading && game}}">
  <!-- 顶部信息 -->
  <view class="card">
    <view class="round-header">
      <view class="game-name">{{game.name}}</view>
      <view class="tag {{game.statusClass}}">{{game.statusText}}</view>
    </view>
    <view class="round-info" wx:if="{{currentRoundNumber}}">
      <text class="round-num">第{{currentRoundNumber}}局</text>
      <text class="text-secondary" style="margin-left: 16rpx;">已完成{{completedRounds}}局</text>
    </view>
    <view class="round-info" wx:else>
      <text class="text-secondary">已完成{{completedRounds}}局</text>
    </view>
  </view>

  <!-- 待确认调整通知 -->
  <view class="card adj-notice" wx:if="{{pendingAdjustments.length > 0}}">
    <view class="section-title">等紧确认</view>
    <view class="adj-item" wx:for="{{pendingAdjustments}}" wx:key="id">
      <view class="adj-info">
        <text>{{item.adjustment_type === 'supplement' ? '补分' : '退分'}} {{item.amount}}分</text>
      </view>
      <view class="adj-actions">
        <button class="mini-btn mini-accept" bindtap="goAcceptAdjustment" data-id="{{item.id}}">确认</button>
        <button class="mini-btn mini-reject" bindtap="goRejectAdjustment" data-id="{{item.id}}">拒绝</button>
      </view>
    </view>
  </view>

  <!-- 当前局信息 -->
  <view class="card" wx:if="{{round}}">
    <view class="submit-progress">
      <text>已入分 {{submittedCount}}/{{memberCount}}</text>
      <text class="text-secondary" wx:if="{{submittedCount < memberCount}}">仲有 {{memberCount - submittedCount}} 位未入</text>
    </view>

    <!-- 我的入分 -->
    <block wx:if="{{roundStatus === 'open' || roundStatus === 'review'}}">
      <view class="score-input-area">
        <view class="text-secondary" style="margin-bottom: 12rpx;">我嘅本局分数</view>
        <view class="score-input-row">
          <input
            class="score-input"
            type="number"
            placeholder="0"
            placeholder-class="input-placeholder"
            value="{{myScore}}"
            bindinput="onScoreInput"
          />
        </view>
        <button class="btn-primary" bindtap="doSubmit" disabled="{{submitting}}">
          {{mySubmitted ? '改分' : '入分'}}
        </button>
      </view>
    </block>

    <!-- 复核阶段 -->
    <block wx:if="{{roundStatus === 'review'}}">
      <view class="review-section">
        <view class="section-title">本局分数</view>
        <view class="score-list">
          <view class="score-item" wx:for="{{submissions}}" wx:key="player_id">
            <view class="score-name">{{item.nickname}}</view>
            <view class="score-value {{item.scoreClass}}">
              {{item.submitted ? item.scoreText : '未入'}}
            </view>
          </view>
        </view>
        <view class="score-sum">
          <text>本局总和：</text>
          <text class="{{scoreSum > 0 ? 'text-positive' : (scoreSum < 0 ? 'text-negative' : 'text-success')}}">
            {{scoreSum > 0 ? '+' : ''}}{{scoreSum}}
          </text>
        </view>
        <view class="text-warning" wx:if="{{scoreSum !== 0}}" style="text-align: center; margin: 16rpx 0;">
          今局总和唔系零，请修改自己的分数
        </view>
        <button class="btn-primary" bindtap="doLock" wx:if="{{scoreSum === 0}}">
          确认锁定
        </button>
      </view>
    </block>

    <!-- open 阶段提交状态 -->
    <block wx:if="{{roundStatus === 'open'}}">
      <view class="submit-status">
        <view class="score-item" wx:for="{{submissions}}" wx:key="player_id">
          <view class="score-name">{{item.nickname}}</view>
          <view class="{{item.submitted ? 'text-success' : 'text-secondary'}}">
            {{item.submitted ? '已入分' : '等紧入分'}}
          </view>
        </view>
      </view>
    </block>
  </view>

  <!-- 底部操作 -->
  <view class="action-bar" wx:if="{{roundStatus === 'ready_for_next'}}">
    <view class="text-success" style="text-align: center; margin-bottom: 16rpx;">
      第{{currentRoundNumber}}局已完成，总和为0
    </view>
    <button class="btn-primary" bindtap="doNextRound">下一局</button>
    <button class="btn-secondary" bindtap="goAdjustment">补分/退分</button>
    <button class="btn-danger" wx:if="{{isOwner}}" bindtap="doEnd">散台</button>
  </view>

  <view class="action-bar" wx:if="{{roundStatus === 'review'}}">
    <button class="btn-secondary" bindtap="goAdjustment">补分/退分</button>
    <button class="btn-danger" wx:if="{{isOwner}}" bindtap="doEnd" disabled>散台</button>
  </view>

  <view class="action-bar" wx:if="{{roundStatus === 'open' && mySubmitted}}">
    <button class="btn-secondary" bindtap="goAdjustment">补分/退分</button>
  </view>
</view>
