/* pages/score/score.wxss — 记分页（设计 v2：深绿状态条 + 大号入分） */

.page {
  padding: 32rpx;
  min-height: 100vh;
  box-sizing: border-box;
}

/* ========== 深绿状态条 ========== */
.hero {
  border-radius: 28rpx;
  padding: 36rpx;
  margin-bottom: 24rpx;
  display: flex;
  align-items: center;
}

.hero-round-tile {
  width: 96rpx;
  height: 126rpx;
  font-size: 44rpx;
  flex-shrink: 0;
  margin-right: 28rpx;
}

.hero-main {
  flex: 1;
  min-width: 0;
}

.hero-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 10rpx;
}

.hero-name {
  color: #F7F3E8;
  font-size: 34rpx;
  font-weight: 700;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  margin-right: 16rpx;
}

.hero-info {
  display: flex;
  align-items: center;
}

.hero-round {
  color: #F6EEDC;
  font-size: 30rpx;
  font-weight: 700;
}

.hero-dot {
  color: rgba(247, 243, 232, 0.5);
  margin: 0 14rpx;
}

.hero-completed {
  color: rgba(247, 243, 232, 0.7);
  font-size: 24rpx;
}

/* ========== 区段标题 ========== */
.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.section-title {
  margin-bottom: 0;
}

/* ========== 待确认调整（金色左边条） ========== */
.adj-card {
  border-left: 8rpx solid var(--color-gold);
}

.adj-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
}

.adj-type {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text);
}

.adj-actions {
  display: flex;
  gap: 12rpx;
}

.mini-btn {
  font-size: 24rpx;
  padding: 10rpx 28rpx;
  border-radius: 24rpx;
  line-height: 1.5;
}

.mini-accept {
  background: var(--color-primary);
  color: #FFF;
}

.mini-reject {
  background: var(--color-bg);
  color: var(--color-text-secondary);
  border: 1rpx solid var(--color-border);
}

/* ========== 进度条 ========== */
.progress-bar {
  margin-bottom: 32rpx;
}

.progress-text {
  display: flex;
  align-items: baseline;
  margin-bottom: 12rpx;
}

.progress-done {
  font-size: 40rpx;
  font-weight: 800;
  color: var(--color-primary);
}

.progress-total {
  font-size: 24rpx;
  color: var(--color-text-secondary);
  margin-left: 4rpx;
}

.progress-track {
  height: 14rpx;
  background: var(--color-bg);
  border-radius: 8rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #237652, #1E6B47);
  border-radius: 8rpx;
  transition: width 0.3s ease;
}

/* ========== 分数输入 ========== */
.score-input-section {
  padding-top: 28rpx;
  border-top: 1rpx solid var(--color-border);
}

.input-label {
  font-size: 26rpx;
  color: var(--color-text-secondary);
  margin-bottom: 20rpx;
}

.score-input-wrap {
  position: relative;
  margin-bottom: 28rpx;
}

.score-sign {
  position: absolute;
  left: 36rpx;
  top: 50%;
  transform: translateY(-50%);
  font-size: 48rpx;
  font-weight: 800;
  color: var(--color-cta);
  z-index: 2;
}

.score-sign-neg {
  color: var(--color-primary);
}

.score-input {
  border: 3rpx solid var(--color-primary);
  border-radius: 28rpx;
  padding: 32rpx;
  font-size: 68rpx;
  font-weight: 800;
  text-align: center;
  background: var(--color-card-warm);
  width: 100%;
  box-sizing: border-box;
}

.input-positive {
  color: var(--color-cta);
}

.input-negative {
  color: var(--color-primary);
}

.input-placeholder {
  color: var(--color-text-tertiary);
  font-weight: 400;
}

/* ========== 提交状态列表 ========== */
.submit-list {
  padding-top: 24rpx;
  border-top: 1rpx solid var(--color-border);
}

.submit-item {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
}

.submit-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: var(--color-primary);
  color: #FFF;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 600;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.submit-name {
  flex: 1;
  font-size: 28rpx;
}

.status-done {
  color: var(--color-success);
  font-size: 24rpx;
  font-weight: 600;
}

.status-wait {
  color: var(--color-text-tertiary);
  font-size: 24rpx;
}

/* ========== 复核列表 ========== */
.review-section {
  padding-top: 28rpx;
  border-top: 1rpx solid var(--color-border);
}

.review-list {
  margin-bottom: 24rpx;
}

.review-item {
  display: flex;
  align-items: center;
  padding: 18rpx 0;
  border-bottom: 1rpx dashed var(--color-border);
}

.review-item:last-child {
  border-bottom: none;
}

.review-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: var(--color-text);
  color: #F7F3E8;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 600;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.review-name {
  flex: 1;
  font-size: 30rpx;
}

.review-score-tile {
  min-width: 120rpx;
  height: 72rpx;
  font-size: 30rpx;
  padding: 0 20rpx;
  box-sizing: border-box;
}

.review-score {
  font-size: 36rpx;
  font-weight: 800;
  color: var(--color-text-tertiary);
}

.sum-row {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 24rpx 0;
  background: var(--color-card-warm);
  border-radius: 20rpx;
  margin-bottom: 8rpx;
}

.sum-label {
  font-size: 28rpx;
  color: var(--color-text-secondary);
  margin-right: 16rpx;
}

.sum-value {
  font-size: 44rpx;
  font-weight: 800;
}

.sum-warning {
  text-align: center;
  color: var(--color-warning);
  font-size: 24rpx;
  padding: 16rpx 0 20rpx;
}

/* ========== 底部操作 ========== */
.action-bar {
  padding: 32rpx 0 12rpx;
}

.action-bar button {
  margin-bottom: 20rpx;
}

.done-text {
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--color-success);
  font-size: 30rpx;
  font-weight: 700;
  margin-bottom: 28rpx;
}

.done-tile {
  width: 52rpx;
  height: 52rpx;
  font-size: 28rpx;
  margin-right: 14rpx;
}
