/* pages/score/score.wxss */
.score-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}

.score-round {
  display: flex;
  align-items: center;
}

.round-num {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--color-accent);
}

/* 入分进度条 */
.progress-bar {
  padding-bottom: 24rpx;
  border-bottom: 1rpx solid var(--color-divider);
  margin-bottom: 24rpx;
}

.progress-info {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.progress-text {
  font-size: 30rpx;
  font-weight: 600;
}

.progress-track {
  height: 8rpx;
  background: var(--color-divider);
  border-radius: 100rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: var(--color-accent);
  border-radius: 100rpx;
  transition: width 0.3s;
}

/* 入分输入区 */
.my-score-area {
  padding-bottom: 24rpx;
  border-bottom: 1rpx solid var(--color-divider);
}

.score-input-row {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.score-input {
  flex: 1;
  border: 2rpx solid var(--color-accent);
  border-radius: var(--radius-md);
  padding: 28rpx;
  font-size: 48rpx;
  font-weight: 700;
  text-align: center;
  background: #FFFCF5;
}

/* 分数列表 */
.score-list, .submit-status {
  padding: 8rpx 0;
}

.score-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--color-divider);
}

.score-item:last-child {
  border-bottom: none;
}

.score-name {
  font-size: 30rpx;
}

.score-value {
  font-size: 36rpx;
  font-weight: 700;
}

/* 总和 */
.score-sum {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 16rpx;
  padding: 24rpx 0;
  font-size: 32rpx;
  font-weight: 700;
}

.sum-warning {
  text-align: center;
  color: var(--color-error);
  font-size: 26rpx;
  padding: 16rpx 0;
  background: #FCE4E4;
  border-radius: var(--radius-sm);
  margin-bottom: 24rpx;
}

.review-section {
  padding-top: 24rpx;
  border-top: 1rpx solid var(--color-divider);
}

/* 调整通知 */
.adj-notice {
  border-left: 6rpx solid var(--color-accent);
}

.adj-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--color-divider);
}

.adj-item:last-child { border-bottom: none; }

.adj-info {
  display: flex;
  gap: 16rpx;
  align-items: center;
}

.adj-type {
  font-size: 28rpx;
  font-weight: 600;
}

.adj-amount {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--color-accent);
}

.adj-actions {
  display: flex;
  gap: 12rpx;
}

.mini-btn {
  font-size: 24rpx;
  padding: 8rpx 28rpx;
  border-radius: 100rpx;
  line-height: 1.5;
}

.mini-accept {
  background: var(--color-success);
  color: #FFF;
}

.mini-reject {
  background: var(--color-divider);
  color: var(--color-text);
}

.round-complete {
  text-align: center;
  padding: 16rpx 0;
}
