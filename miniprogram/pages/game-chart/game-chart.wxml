<!--pages/game-chart/game-chart.wxml — 图表分析页 v6 Stitch 还原-->
<view class="page">
  <view class="top-bar" style="padding-top: {{capsuleTop}}px;">
    <view class="nav-back-btn" style="width: {{capsuleHeight}}px; height: {{capsuleHeight}}px;" bindtap="goBack">
      <text class="nav-back-icon">‹</text>
    </view>
  </view>

  <view class="main-content">

    <block wx:if="{{detail}}">
      <!-- 头部 -->
      <view class="gc-hero card anim-fade-up">
        <view class="gc-hero-head">
          <view class="gc-hero-title-row">
            <!-- <view class="gc-tile-badge">雀</view> -->
            <text class="gc-hero-title">积分走势</text>
          </view>
          <!-- <view class="gc-zero-chip" wx:if="{{detail.zeroSum}}"><text>☑ Σ 零和对账平稳</text></view> -->
        </view>
        <view class="gc-hero-sub">
          <view class="gc-hero-date">
            <text class="gc-date-big">{{detail.dateText}}</text>
            <view class="gc-round-tag">{{detail.flowText}}</view>
          </view>
          <view class="gc-diff">
            <text class="gc-diff-label">{{isRoundMode ? '抽水' : '校对差额'}}</text>
            <text class="gc-diff-val">{{diffText}}</text>
          </view>
        </view>
        <view class="gc-mini-cards">
          <view class="gc-mini-card" wx:for="{{players}}" wx:for-item="p" wx:key="user_id">
            <view class="gc-mini-top">
              <view class="gc-mini-dot" style="background: {{p.color}};"></view>
              <text class="gc-mini-name">{{p.nickname}}</text>
              <image class="gc-mini-wind-svg" src="/assets/icons/seat-wind-{{p.windClass}}.svg" mode="aspectFit" wx:if="{{p.windClass}}" />
            </view>
            <view class="gc-mini-bottom">
              <text class="gc-mini-tag">{{p.tag}}</text>
              <text class="gc-mini-score {{p.scoreClass}}">{{p.finalScore > 0 ? '+' : ''}}{{p.finalScore}}</text>
            </view>
          </view>
        </view>
      </view>

      <!-- 累计积分走势 -->
      <view class="gc-section card anim-fade-up delay-1">
        <view class="gc-section-head">
          <text class="gc-section-title">📈 全场累计积分走势</text>
          <text class="gc-section-sub">点击图例可筛选</text>
        </view>
        <view class="gc-legend">
          <view class="gc-legend-chip {{p.show === false ? 'off' : ''}}" wx:for="{{players}}" wx:for-item="p" wx:key="user_id" data-uid="{{p.user_id}}" bindtap="onLegendTap">
            <view class="gc-legend-dot" style="background: {{p.color}};"></view>
            <text>{{p.nickname}}</text>
          </view>
        </view>
        <canvas type="2d" id="line-chart" class="gc-line-canvas"></canvas>
        <view class="gc-pressure" wx:if="{{pressureText}}"><text>● {{pressureText}}</text></view>
      </view>

      <!-- 标签分析：只统计我给分时贴的标签（我的赔付牌型：放杠/杠爆等） -->
      <view class="gc-section card anim-fade-up delay-2" wx:if="{{hasTagData}}">
        <view class="gc-section-head">
          <text class="gc-section-title">🀄 标签分析 · 我的赔付走势</text>
          <text class="gc-section-sub">只计我给分时贴的标签 · 付出为负</text>
        </view>
        <!-- 标签统计 chips：我给分笔数 + 累计付出 -->
        <view class="gc-tag-stats">
          <view class="gc-tag-chip" wx:for="{{tagStats}}" wx:for-item="t" wx:key="code" data-code="{{t.code}}" bindtap="onTagLegendTap">
            <view class="gc-tag-dot" style="background: {{t.color}}; {{t.show === false ? 'opacity:0.25;' : ''}}"></view>
            <text class="gc-tag-name {{t.show === false ? 'off' : ''}}">{{t.label}}</text>
            <text class="gc-tag-count">{{t.count}}笔</text>
            <text class="gc-tag-net {{t.myNet > 0 ? 'pos' : (t.myNet < 0 ? 'neg' : '')}}">{{t.myNet > 0 ? '+' : ''}}{{t.myNet}}</text>
          </view>
        </view>
        <canvas type="2d" id="tag-chart" class="gc-tag-canvas"></canvas>
        <view class="gc-tag-note">
          <text>每条线 = 我给分贴该标签的累计付出分 · 横轴为第几笔 · 点图例可筛选</text>
        </view>
      </view>

      <!-- 战局复盘 -->
      <view class="gc-section card anim-fade-up delay-2">
        <view class="gc-section-head">
          <text class="gc-section-title">🌀 风云变幻 · 战局复盘</text>
        </view>
        <view class="gc-insights">
          <view class="gc-insight" wx:for="{{insights}}" wx:for-item="ins" wx:key="title">
            <view class="gc-insight-icon"><text>{{ins.icon}}</text></view>
            <view class="gc-insight-body">
              <view class="gc-insight-title-row">
                <text class="gc-insight-title">{{ins.title}}</text>
                <text class="gc-insight-highlight">{{ins.highlight}}</text>
              </view>
              <text class="gc-insight-desc">{{ins.desc}}</text>
            </view>
          </view>
        </view>
      </view>

      <!-- 逐局/逐笔流水条形图（固定行高矢量条形图，再多也绝不重叠） -->
      <view class="gc-section card anim-fade-up delay-2">
        <view class="gc-section-head">
          <text class="gc-section-title">{{isRoundMode ? '📊 逐局流水条形图' : '📊 逐笔流水条形图'}}</text>
          <text class="gc-section-sub">共 {{flowCount}} {{isRoundMode ? '局' : '笔'}} · 单位：分</text>
        </view>
        <view class="gc-bar-list" wx:if="{{flowBars.length > 0}}">
          <view class="gc-bar-row" wx:for="{{flowBars}}" wx:key="idx" wx:if="{{index < barShown}}">
            <text class="gc-bar-idx">{{item.idx}}</text>
            <view class="gc-bar-track">
              <!-- 左半轴（我转出/本局净输：红条向左延伸） -->
              <view class="gc-bar-half gc-bar-half-left">
                <view wx:if="{{item.type === 'out'}}" class="gc-bar-fill gc-bar-fill-out" style="width: {{item.pct}}%;"></view>
              </view>
              <!-- 0 基准轴线 -->
              <view class="gc-bar-zero"></view>
              <!-- 右半轴（我收到/本局净赢：绿条向右；他人互转/平水：灰条向右） -->
              <view class="gc-bar-half gc-bar-half-right">
                <view wx:if="{{item.type === 'in'}}" class="gc-bar-fill gc-bar-fill-in" style="width: {{item.pct}}%;"></view>
                <view wx:elif="{{item.type === 'other'}}" class="gc-bar-fill gc-bar-fill-other" style="width: {{item.pct}}%;"></view>
              </view>
            </view>
            <text class="gc-bar-val gc-bar-val-{{item.type}}">{{item.amountText}}</text>
          </view>
        </view>
        <view class="gc-bar-empty" wx:else><text>暂无转分流水</text></view>
        <view class="gc-bar-more" wx:if="{{flowBars.length > barPageSize}}">
          <text wx:if="{{flowBars.length > barShown}}" bindtap="loadMoreBars">展开其余 {{flowBars.length - barShown}} {{isRoundMode ? '局' : '笔'}}流水 ⌄</text>
          <text wx:else bindtap="collapseBars">收起流水 ⌃</text>
        </view>
        <view class="gc-bar-note">
          <view class="gc-note-item"><view class="gc-note-dot" style="background:#1b6b4a;"></view><text>{{isRoundMode ? '绿色=本局净赢' : '绿色=我收到'}}</text></view>
          <view class="gc-note-item"><view class="gc-note-dot" style="background:#b91c1c;"></view><text>{{isRoundMode ? '红色=本局净输' : '红色=我转出'}}</text></view>
          <view class="gc-note-item"><view class="gc-note-dot" style="background:#cbd5e1;"></view><text>{{isRoundMode ? '灰色=本局平水' : '灰色=他人互转'}}</text></view>
        </view>
      </view>
    </block>

    <view class="load-tip" wx:if="{{loading}}">加载中...</view>
  </view>
</view>
