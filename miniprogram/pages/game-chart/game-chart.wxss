/* pages/game-chart/game-chart.wxss — 图表分析页 */
/* 禁止整页被左右拖动（与房间页同款控制） */
page { overflow-x: hidden; overscroll-behavior-x: none; }
.page { min-height: 100vh; background: var(--background); overflow-x: hidden; }
.main-content { padding-left: var(--margin-screen); padding-right: var(--margin-screen); padding-bottom: 60rpx; display: flex; flex-direction: column; gap: var(--space-md); }
.top-bar { display: flex; align-items: center; padding-left: var(--margin-screen); padding-right: var(--margin-screen); padding-bottom: var(--space-sm); }
.nav-back-btn { border-radius: 50%; background: var(--surface-container-lowest); box-shadow: var(--shadow-card); display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
.nav-back-icon { font-size: 40rpx; color: var(--on-surface); line-height: 1; }
.btn-primary text, .btn-secondary text { white-space: nowrap; }
.btn-primary, .btn-secondary { overflow: hidden; }
.card { background: var(--surface-container-lowest); border-radius: var(--radius-lg); box-shadow: var(--shadow-card); }

/* 头部 */
.gc-hero { padding: var(--space-md); display: flex; flex-direction: column; gap: 18rpx; }
.gc-hero-head { display: flex; align-items: center; justify-content: space-between; }
.gc-hero-title-row { display: flex; align-items: center; gap: 12rpx; }
.gc-tile-badge { width: 44rpx; height: 44rpx; border-radius: var(--radius-default); background: var(--primary-fixed); color: var(--on-primary-fixed); font-size: 24rpx; font-weight: 700; display: flex; align-items: center; justify-content: center; }
.gc-hero-title { font-size: 30rpx; font-weight: 700; color: var(--on-surface); }
.gc-zero-chip { padding: 6rpx 14rpx; border-radius: var(--radius-full); background: var(--primary-fixed); color: var(--on-primary-fixed); font-size: 18rpx; font-weight: 600; }
.gc-hero-sub { display: flex; align-items: flex-end; justify-content: space-between; }
.gc-hero-date { display: flex; align-items: center; gap: 12rpx; }
.gc-date-big { font-size: 36rpx; font-weight: 700; color: var(--on-surface); }
.gc-round-tag { padding: 4rpx 12rpx; border-radius: var(--radius-full); background: var(--surface-container-high); color: var(--on-surface-variant); font-size: 18rpx; }
.gc-diff { display: flex; flex-direction: column; align-items: flex-end; }
.gc-diff-label { font-size: 20rpx; color: var(--on-surface-variant); }
.gc-diff-val { font-size: 40rpx; font-weight: 700; color: var(--primary); }

/* 迷你卡 */
.gc-mini-cards { display: grid; grid-template-columns: 1fr 1fr; gap: var(--gutter-grid); }
.gc-mini-card { background: var(--surface-container-low); border-radius: var(--radius-default); padding: 14rpx 16rpx; display: flex; flex-direction: column; gap: 8rpx; }
.gc-mini-top { display: flex; align-items: center; gap: 8rpx; min-width: 0; }
.gc-mini-dot { width: 14rpx; height: 14rpx; border-radius: 50%; }
.gc-mini-name { font-size: 24rpx; font-weight: 600; color: var(--on-surface); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.gc-mini-wind-svg { width: 30rpx; height: 30rpx; margin-left: auto; flex-shrink: 0; }
.gc-mini-bottom { display: flex; align-items: center; justify-content: space-between; }
.gc-mini-tag { font-size: 20rpx; color: var(--on-surface-variant); }
.gc-mini-score { font-size: 30rpx; font-weight: 700; }

/* 区块 */
.gc-section { padding: var(--space-md); display: flex; flex-direction: column; gap: 16rpx; }
.gc-section-head { display: flex; align-items: baseline; justify-content: space-between; }
.gc-section-title { font-size: 30rpx; font-weight: 700; color: var(--on-surface); }
.gc-section-sub { font-size: 20rpx; color: var(--outline); }

/* 图例 */
.gc-legend { display: flex; flex-wrap: wrap; gap: 12rpx; }
.gc-legend-chip { display: flex; align-items: center; gap: 8rpx; padding: 6rpx 16rpx; border-radius: var(--radius-full); background: var(--surface-container-low); font-size: 20rpx; color: var(--on-surface); }
.gc-legend-chip.off { opacity: 0.4; }
.gc-legend-dot { width: 14rpx; height: 14rpx; border-radius: 50%; }
.gc-line-canvas { width: 100%; height: 440rpx; }
.gc-pressure { background: var(--surface-container-low); border-radius: var(--radius-default); padding: 14rpx 16rpx; font-size: 22rpx; color: var(--on-surface-variant); }

/* 标签分析：统计 chips + 走势画布 */
.gc-tag-stats { display: flex; flex-wrap: wrap; gap: 12rpx; }
.gc-tag-chip { display: flex; align-items: center; gap: 8rpx; padding: 8rpx 16rpx; border-radius: var(--radius-full); background: var(--surface-container-low); }
.gc-tag-dot { width: 14rpx; height: 14rpx; border-radius: 50%; flex-shrink: 0; }
.gc-tag-name { font-size: 22rpx; font-weight: 600; color: var(--on-surface); }
.gc-tag-name.off { opacity: 0.4; }
.gc-tag-count { font-size: 20rpx; color: var(--on-surface-variant); }
.gc-tag-net { font-size: 22rpx; font-weight: 700; color: var(--on-surface-variant); }
.gc-tag-net.pos { color: #1b6b4a; }
.gc-tag-net.neg { color: #b91c1c; }
.gc-tag-canvas { width: 100%; height: 380rpx; }
.gc-tag-note { font-size: 20rpx; color: var(--outline); }

/* 复盘 */
.gc-insights { display: flex; flex-direction: column; gap: 16rpx; }
.gc-insight { display: flex; gap: 16rpx; background: var(--surface-container-low); border-radius: var(--radius-default); padding: 16rpx; }
.gc-insight-icon { width: 56rpx; height: 56rpx; border-radius: 50%; background: var(--surface-container-high); display: flex; align-items: center; justify-content: center; font-size: 28rpx; flex-shrink: 0; }
.gc-insight-body { flex: 1; display: flex; flex-direction: column; gap: 6rpx; min-width: 0; }
.gc-insight-title-row { display: flex; align-items: baseline; justify-content: space-between; gap: 12rpx; flex-wrap: wrap; }
.gc-insight-title { font-size: 26rpx; font-weight: 600; color: var(--on-surface); }
.gc-insight-highlight { font-size: 22rpx; font-weight: 700; color: var(--primary); }
.gc-insight-desc { font-size: 22rpx; color: var(--on-surface-variant); }

/* 逐局/逐笔条形图：固定行高矢量条形图，再多也绝不挤压重叠 */
.gc-bar-list { display: flex; flex-direction: column; gap: 10rpx; padding: 6rpx 0; }
.gc-bar-row { display: flex; align-items: center; height: 38rpx; gap: 14rpx; }
.gc-bar-idx { width: 76rpx; font-size: 20rpx; color: #9ca3af; text-align: left; flex-shrink: 0; white-space: nowrap; font-family: monospace; }
.gc-bar-track { flex: 1; height: 100%; display: flex; align-items: center; min-width: 0; }
.gc-bar-half { height: 22rpx; display: flex; align-items: center; }
.gc-bar-half-left { flex: 0.38; justify-content: flex-end; }
.gc-bar-half-right { flex: 0.62; justify-content: flex-start; }
.gc-bar-zero { width: 2rpx; height: 38rpx; background: #e5e7eb; flex-shrink: 0; }
.gc-bar-fill { height: 22rpx; min-width: 6rpx; transition: width 0.25s ease; }
.gc-bar-fill-in { background: #1b6b4a; border-radius: 0 6rpx 6rpx 0; }
.gc-bar-fill-out { background: #b91c1c; border-radius: 6rpx 0 0 6rpx; }
.gc-bar-fill-other { background: #cbd5e1; border-radius: 0 6rpx 6rpx 0; }
.gc-bar-val { width: 76rpx; font-size: 22rpx; font-weight: 700; text-align: right; flex-shrink: 0; font-family: monospace; }
.gc-bar-val-in { color: #1b6b4a; }
.gc-bar-val-out { color: #b91c1c; }
.gc-bar-val-other { color: #6f7a72; }
.gc-bar-empty { padding: 40rpx 0; text-align: center; font-size: 24rpx; color: var(--outline); }
.gc-bar-more { display: flex; justify-content: center; padding: 8rpx 0 4rpx; }
.gc-bar-more text { font-size: 24rpx; font-weight: 500; color: var(--primary); }
.gc-bar-note { display: flex; gap: 24rpx; flex-wrap: wrap; }
.gc-note-item { display: flex; align-items: center; gap: 8rpx; font-size: 20rpx; color: var(--on-surface-variant); }
.gc-note-dot { width: 12rpx; height: 12rpx; border-radius: 50%; }
