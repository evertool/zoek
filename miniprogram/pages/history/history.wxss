/* pages/history/history.wxss */
.history-card {
  background: var(--color-card);
  border-radius: var(--radius-lg);
  padding: 28rpx 32rpx;
  margin-bottom: 16rpx;
  box-shadow: var(--shadow-sm);
}

.history-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}

.history-name {
  font-size: 32rpx;
  font-weight: 600;
}

.history-info {
  display: flex;
  align-items: center;
}
