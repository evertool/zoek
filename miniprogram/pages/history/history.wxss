/* pages/history/history.wxss — 对局记录 v4 白底卡通版
 * 白卡行：麻将牌图 + 台名 + 局数时间
 */

.page {
  padding: 32rpx;
  min-height: 100vh;
  box-sizing: border-box;
}

/* ===== 记录卡：麻将牌 + 内容 + 箭头 ===== */
.game-card {
  display: flex;
  align-items: center;
  background: var(--color-card);
  border-radius: 28rpx;
  padding: 30rpx 28rpx;
  margin-bottom: 22rpx;
  box-shadow: 0 6rpx 28rpx rgba(26, 26, 46, 0.06);
  border: 1rpx solid var(--color-border);
  transition: all 0.25s cubic-bezier(0.22, 1, 0.36, 1);
}

.game-card:active {
  transform: scale(0.97);
}

.card-tile {
  width: 64rpx;
  height: 84rpx;
  font-size: 28rpx;
  flex-shrink: 0;
  margin-right: 24rpx;
}

.card-body {
  flex: 1;
  min-width: 0;
}

.card-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.card-name {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--color-text);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  margin-right: 16rpx;
}

.card-bottom {
  display: flex;
  align-items: center;
}

.card-time {
  margin-left: 24rpx;
  color: var(--color-text-tertiary);
  font-size: 24rpx;
}

.card-arrow {
  color: var(--color-text-tertiary);
  font-size: 44rpx;
  font-weight: 300;
  flex-shrink: 0;
  margin-left: 12rpx;
}

/* ===== 空状态 ===== */
.empty-tile {
  width: 120rpx;
  height: 160rpx;
  font-size: 56rpx;
  margin-bottom: 28rpx;
}

/* ===== 加载提示 ===== */
.load-tip {
  text-align: center;
  color: var(--color-text-tertiary);
  font-size: 24rpx;
  padding: 32rpx 0;
}

/* ===== 删除按钮 ===== */
.card-ops {
  display: flex;
  align-items: center;
  flex-shrink: 0;
  margin-left: 12rpx;
}

.card-delete {
  font-size: 22rpx;
  color: var(--color-text-tertiary);
  padding: 8rpx 18rpx;
  border: 2rpx solid var(--color-border);
  border-radius: 24rpx;
  transition: all 0.25s ease;
}

.card-delete:active {
  color: var(--color-error);
  border-color: var(--color-error);
  background: var(--color-error-soft);
}
