/* pages/history/history.wxss — 开台手账 v6 Stitch 100% 还原 */
.page { min-height: 100vh; background: var(--background); padding-bottom: 160rpx; }
.main-content { padding-left: var(--margin-screen); padding-right: var(--margin-screen); display: flex; flex-direction: column; gap: var(--space-md); }

/* 标题区 */
.hs-title-section { padding-top: var(--space-xs); }
.hs-title-row { display: flex; align-items: center; justify-content: space-between; }
.hs-title-left { display: flex; flex-direction: column; gap: 8rpx; }
.hs-title-row-inner { display: flex; align-items: baseline; gap: 16rpx; }
.hs-title { font-size: 40rpx; font-weight: 600; color: var(--on-surface); letter-spacing: -1rpx; }
.hs-title-badge { padding: 8rpx 16rpx; border-radius: var(--radius-full); background: var(--primary-fixed); color: var(--on-primary-fixed); font-size: 20rpx; font-weight: 500; }
.hs-subtitle { font-size: 24rpx; color: var(--on-surface-variant); }
.hs-day-tabs { display: flex; gap: 16rpx; margin-top: 20rpx; }
.hs-day-tab { flex: 1; display: flex; align-items: center; justify-content: center; padding: 16rpx 0; border-radius: var(--radius-full); background: var(--surface-container-low); color: var(--on-surface-variant); font-size: 26rpx; font-weight: 500; }
.hs-day-tab.active { background: var(--primary); color: var(--on-primary); box-shadow: var(--shadow-card); }
.hs-rank-badge { padding: 2rpx 12rpx; border-radius: var(--radius-full); background: var(--secondary-fixed); color: var(--secondary-fixed-variant); font-size: 18rpx; font-weight: 600; flex-shrink: 0; }

/* 本月概览 */
.hs-overview { position: relative; overflow: hidden; border-radius: var(--radius-lg); background: var(--surface-container-lowest); padding: var(--space-md); box-shadow: var(--shadow-card); }
.hs-overview-glow { position: absolute; right: -32rpx; bottom: -32rpx; width: 224rpx; height: 224rpx; border-radius: 50%; background: rgba(0, 82, 53, 0.05); pointer-events: none; }
.hs-overview-header { display: flex; align-items: center; justify-content: space-between; position: relative; }
.hs-overview-left { display: flex; align-items: center; gap: 16rpx; }
.hs-overview-icon-wrap { width: 56rpx; height: 56rpx; border-radius: 50%; background: rgba(27, 107, 74, 0.1); display: flex; align-items: center; justify-content: center; }
.hs-overview-icon { width: 28rpx; height: 28rpx; }
.hs-overview-title { font-size: 28rpx; font-weight: 600; color: var(--on-surface); }
.hs-overview-sync { display: flex; align-items: center; gap: 8rpx; padding: 8rpx 16rpx; border-radius: var(--radius-full); background: var(--surface-container-low); }
.hs-sync-icon { width: 24rpx; height: 24rpx; }
.hs-sync-text { font-size: 20rpx; color: var(--on-surface-variant); }
.hs-overview-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-xs); margin-top: var(--space-sm); }
.hs-overview-cell { display: flex; flex-direction: column; padding: var(--space-xs); border-radius: var(--radius-default); background: var(--surface-container-low); }
.hs-overview-cell-highlight { background: rgba(0, 82, 53, 0.05); }
.hs-cell-label { font-size: 20rpx; color: var(--on-surface-variant); }
.hs-cell-val-row { display: flex; align-items: baseline; gap: 8rpx; margin-top: 4rpx; }
.hs-cell-val { font-size: 44rpx; font-weight: 700; color: var(--on-surface); }
.hs-cell-unit { font-size: 20rpx; color: var(--on-surface-variant); }

/* 筛选栏 */
.hs-filter-bar { display: flex; align-items: center; justify-content: space-between; }
.hs-filter-tabs { display: flex; gap: 16rpx; }
.hs-filter-tab { padding: 12rpx 24rpx; border-radius: var(--radius-full); background: var(--surface-container-low); color: var(--on-surface-variant); font-size: 24rpx; font-weight: 500; }
.hs-filter-tab.active { background: var(--primary); color: var(--on-primary); box-shadow: var(--shadow-card); }
.hs-filter-count { font-size: 20rpx; color: var(--outline); }

/* 空状态 */
.hs-empty { padding: 80rpx 40rpx; }

/* 记录列表 */
.hs-records { display: flex; flex-direction: column; gap: var(--space-lg); }
.hs-record-group { display: flex; flex-direction: column; gap: var(--space-xs); }
.hs-group-header { display: flex; align-items: center; justify-content: space-between; padding: 0 8rpx; }
.hs-group-left { display: flex; align-items: center; gap: 12rpx; }
.hs-group-dot { width: 12rpx; height: 12rpx; border-radius: 50%; }
.hs-group-dot-today { background: var(--primary); }
.hs-group-dot-recent { background: var(--outline); }
.hs-group-dot-old { background: var(--outline-variant); }
.hs-group-date { font-size: 36rpx; font-weight: 600; color: var(--on-surface); }
.hs-group-tag { padding: 8rpx 12rpx; border-radius: var(--radius-default); background: var(--primary-fixed-dim); color: var(--on-primary-fixed); font-size: 20rpx; font-weight: 500; }
.hs-group-sub { font-size: 20rpx; color: var(--on-surface-variant); }

/* 记录卡 */
.hs-record-card { position: relative; border-radius: var(--radius-lg); background: var(--surface-container-lowest); padding: var(--space-md); box-shadow: var(--shadow-card); overflow: hidden; transition: all 0.2s cubic-bezier(0,0,0.2,1); }
.hs-record-card:active { transform: scale(0.99); }
.hs-card-top { display: flex; align-items: flex-start; justify-content: space-between; gap: var(--space-xs); }
.hs-card-info { flex: 1; min-width: 0; }
.hs-card-time-row { display: flex; align-items: center; gap: 16rpx; flex-wrap: wrap; }
.hs-card-time { font-size: 36rpx; font-weight: 600; color: var(--on-surface); }
.hs-card-status { display: flex; align-items: center; gap: 8rpx; padding: 8rpx 16rpx; border-radius: var(--radius-full); background: var(--surface-container-low); }
.hs-status-icon { width: 24rpx; height: 24rpx; }
.hs-card-status text { font-size: 20rpx; color: var(--on-surface-variant); }
.hs-card-meta { display: flex; align-items: center; gap: 16rpx; margin-top: 12rpx; font-size: 24rpx; color: var(--on-surface-variant); }
.hs-meta-item { display: flex; align-items: center; gap: 8rpx; }
.hs-meta-icon { font-size: 24rpx; }
.hs-meta-dot { font-size: 24rpx; color: var(--outline-variant); }
.hs-meta-players { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.hs-card-score { display: flex; flex-direction: column; align-items: flex-end; flex-shrink: 0; padding-left: var(--space-xs); }
.hs-score-val { font-size: 44rpx; font-weight: 700; }
.hs-score-tag { margin-top: 8rpx; padding: 8rpx 12rpx; border-radius: var(--radius-default); }
.hs-score-tag-win { background: var(--secondary-fixed); color: var(--on-secondary-fixed); font-size: 20rpx; font-weight: 600; display: flex; align-items: center; gap: 4rpx; }
.hs-score-tag-icon { width: 20rpx; height: 20rpx; }
.hs-score-tag-normal { background: var(--surface-container); color: var(--on-surface-variant); font-size: 20rpx; }

/* 卡片底部 */
.hs-card-footer { margin-top: var(--space-sm); padding-top: var(--space-xs); background: rgba(239, 244, 255, 0.6); margin-left: -32rpx; margin-right: -32rpx; margin-bottom: -32rpx; padding: 16rpx 32rpx; display: flex; align-items: center; justify-content: space-between; }
.hs-card-status-text { display: flex; align-items: center; gap: 8rpx; font-size: 20rpx; color: var(--primary); }
.hs-status-text-icon image { width: 24rpx; height: 24rpx; }
.hs-status-text-icon { display: inline-flex; align-items: center; }
.hs-status-adjustment { color: var(--secondary); }
.hs-card-detail { display: flex; align-items: center; gap: 4rpx; }
.hs-card-detail text { font-size: 20rpx; color: var(--primary); font-weight: 500; }
.hs-card-arrow { font-size: 24rpx; color: var(--primary); }

/* 底部签名 */
.hs-footer { display: flex; align-items: center; justify-content: center; gap: 16rpx; padding: var(--space-md) 0 var(--space-xs); }
.hs-footer-line { width: 80rpx; height: 2rpx; background: var(--surface-container-highest); }
.hs-footer-icon { width: 28rpx; height: 28rpx; }
.hs-footer-text { text-align: center; font-size: 24rpx; color: var(--outline); display: block; }
.hs-footer-sub { text-align: center; font-size: 20rpx; color: var(--outline-variant); margin-top: 4rpx; display: block; }

.load-tip { text-align: center; padding: 40rpx; font-size: 24rpx; color: var(--outline); }
