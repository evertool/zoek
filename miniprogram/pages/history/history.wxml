<!--pages/history/history.wxml — 对局记录-->
<view class="container">
  <view class="empty-state" wx:if="{{games.length === 0 && !loading}}">
    <view class="empty-icon">🀄</view>
    <view style="font-size: 30rpx; color: var(--color-text-secondary);">暂无对局记录</view>
  </view>

  <view class="history-card" wx:for="{{games}}" wx:key="game_id" bindtap="goSettlement" data-id="{{item.game_id}}">
    <view class="history-header">
      <view class="history-name">{{item.name}}</view>
      <view class="tag {{item.statusClass}}">{{item.statusText}}</view>
    </view>
    <view class="history-info">
      <text class="text-secondary">{{item.completed_rounds}}局</text>
      <text class="text-secondary" style="margin-left: 20rpx;">{{item.timeText}}</text>
    </view>
  </view>

  <view class="loading-text" wx:if="{{!hasMore && games.length > 0}}">
    没有更多了
  </view>

  <view class="loading-text" wx:if="{{loading}}">
    加载中...
  </view>
</view>
