/* pages/join/join.wxss — 入台页 v4 白底卡通版
 * 卡通3D牌堆状态图 + 红CTA
 */

.page {
  padding: 32rpx;
  min-height: 100vh;
  box-sizing: border-box;
}

.join-state {
  min-height: 80vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  padding: 0 40rpx;
}

.join-tiles {
  position: relative;
  width: 180rpx;
  height: 170rpx;
  margin-bottom: 36rpx;
}

.join-tile {
  position: absolute;
  width: 96rpx;
  height: 128rpx;
  font-size: 46rpx;
}

.join-tile-b {
  left: 4rpx;
  top: 28rpx;
  transform: rotate(-12deg);
  opacity: 0.9;
  z-index: 3;
}

.join-tile-a {
  right: 8rpx;
  top: 6rpx;
  transform: rotate(8deg);
  z-index: 3;
}

.join-title {
  font-size: 38rpx;
  font-weight: 800;
  color: var(--color-indigo);
  margin-bottom: 12rpx;
  letter-spacing: 3rpx;
}

.join-error {
  width: 100%;
  box-sizing: border-box;
  margin-top: 20rpx;
  color: var(--color-error);
  font-size: 26rpx;
  border: 1rpx solid var(--color-red-soft);
  background: var(--color-red-soft);
}

.join-actions {
  width: 100%;
  margin-top: 40rpx;
}
