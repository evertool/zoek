/* pages/game-detail/game-detail.wxss — 牌局结算明细（queyou-mingxi 设计稿还原） */
/* 禁止整页被左右拖动（与房间页同款控制）：内容横向哪怕溢出亚像素，
 * iOS/安卓都允许把整页拖走；overscroll-behavior 再关掉边缘回弹。竖向滚动不受影响。 */
page { overflow-x: hidden; overscroll-behavior-x: none; }
.page { min-height: 100vh; background: var(--background); overflow-x: hidden; }

/* ========== 导航 ========== */
.top-bar { position: relative; display: flex; align-items: center; padding-left: var(--margin-screen); padding-right: var(--margin-screen); padding-bottom: var(--space-sm); }
.nav-back-btn { border-radius: 50%; background: var(--surface-container-lowest); box-shadow: var(--shadow-card); display: flex; align-items: center; justify-content: center; flex-shrink: 0; z-index: 2; }
.nav-back-icon { font-size: 40rpx; color: var(--on-surface); line-height: 1; }

/* ========== 主体 ========== */
.main-content { padding: var(--space-xs) var(--margin-screen) 200rpx; display: flex; flex-direction: column; gap: var(--space-md); }
.load-tip { text-align: center; padding: 120rpx 0; font-size: 26rpx; color: var(--outline); }

/* 加载失败 / 无权限兜底 */
.gd-error { display: flex; flex-direction: column; align-items: center; gap: 16rpx; padding: 140rpx 40rpx 0; text-align: center; }
.gd-error-icon { width: 64rpx; height: 64rpx; opacity: 0.7; }
.gd-error-text { font-size: 28rpx; font-weight: 600; color: var(--on-surface); }
.gd-error-sub { font-size: 22rpx; color: var(--on-surface-variant); }
.gd-error-actions { display: flex; gap: 20rpx; margin-top: 16rpx; }
.gd-error-btn { padding: 18rpx 56rpx; border-radius: var(--radius-full); background: var(--primary); }
.gd-error-btn text { font-size: 26rpx; font-weight: 600; color: var(--on-primary); }
.gd-error-btn-ghost { background: var(--surface-container-low); }
.gd-error-btn-ghost text { color: var(--on-surface); font-weight: 500; }

/* ========== 完结摘要卡 ========== */
.gd-summary { display: flex; align-items: center; justify-content: space-between; gap: var(--space-xs); background: var(--surface-container-lowest); border: 2rpx solid rgba(0, 0, 0, 0.03); border-radius: var(--radius-lg); padding: 24rpx var(--space-md); box-shadow: var(--shadow-card); }
.gd-summary-left { display: flex; align-items: center; gap: 12rpx; font-size: 24rpx; font-weight: 500; color: var(--on-surface-variant); }
.gd-summary-dot { width: 16rpx; height: 16rpx; border-radius: 50%; background: var(--primary); flex-shrink: 0; }
.gd-balance-chip { display: flex; align-items: center; gap: 8rpx; padding: 8rpx 20rpx; border-radius: var(--radius-md); background: rgba(166, 243, 201, 0.35); border: 2rpx solid rgba(166, 243, 201, 0.7); }
.gd-balance-icon { width: 28rpx; height: 28rpx; }
.gd-balance-chip text { font-size: 22rpx; font-weight: 500; color: var(--primary); }

/* ========== 区块头 ========== */
.gd-section { display: flex; flex-direction: column; gap: 20rpx; }
.gd-section-head { display: flex; align-items: center; justify-content: space-between; padding: 0 4rpx; }
.gd-section-title-wrap { display: flex; align-items: center; gap: 12rpx; }
.gd-section-bar { width: 6rpx; height: 28rpx; border-radius: var(--radius-full); background: var(--primary); }
.gd-section-title { font-size: 28rpx; font-weight: 700; color: var(--on-surface); letter-spacing: -0.3rpx; }
.gd-section-chip { font-size: 24rpx; font-weight: 500; color: var(--on-surface-variant); background: var(--surface-container-low); padding: 4rpx 16rpx; border-radius: var(--radius-default); }
.gd-section-count { font-size: 24rpx; font-weight: 500; color: var(--on-surface-variant); }

/* ========== 全场收支总览 ========== */
.gd-players-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 20rpx; }
/* min-width: 0 关键：grid item 默认 min-width:auto，长昵称+大号分数会把 1fr 轨道
 * 撑破屏幕（真机上字体渲染更宽），导致卡片超出、整页可横向拖动 */
.gd-player { position: relative; min-width: 0; width: 100%; background: var(--surface-container-lowest); border: 2rpx solid rgba(0, 0, 0, 0.03); border-radius: var(--radius-lg); padding: 28rpx 20rpx; min-height: 208rpx; box-sizing: border-box; display: flex; flex-direction: column; justify-content: space-between; gap: 20rpx; box-shadow: var(--shadow-card); overflow: hidden; }
.gd-player-champion { background: linear-gradient(180deg, rgba(166, 243, 201, 0.18) 0%, var(--surface-container-lowest) 100%); border-color: rgba(166, 243, 201, 0.8); }
.gd-player-negative { border-color: rgba(176, 45, 41, 0.18); }
/* 徽章放底行左下（顶掉冠军卡的「第 1 名」）：不占头像昵称那行，也不会被 overflow:hidden 裁掉 */
.gd-player-crown { display: inline-flex; align-items: center; flex-shrink: 0; padding: 4rpx 14rpx; border-radius: var(--radius-full); background: #fbbf24; color: #451a03; font-size: 18rpx; font-weight: 700; border: 2rpx solid #ffffff; box-shadow: var(--shadow-card); }
/* 昵称一行、分数一行，长昵称不再被挤成省略号 */
.gd-player-top { display: flex; align-items: center; gap: 14rpx; min-width: 0; }
.gd-player-avatar-wrap { position: relative; flex-shrink: 0; }
.gd-player-avatar { width: 64rpx; height: 64rpx; border-radius: 50%; display: flex; align-items: center; justify-content: center; color: #fff; font-size: 26rpx; font-weight: 700; overflow: visible; position: relative; }
.gd-player-avatar-img { width: 64rpx; height: 64rpx; border-radius: 50%; position: absolute; top: 0; left: 0; }
.gd-player-wind-svg { position: absolute; bottom: -12rpx; right: -12rpx; width: 40rpx; height: 40rpx; border-radius: 50%; background: #ffffff; box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.08); }
.gd-player-name { display: flex; align-items: baseline; gap: 4rpx; min-width: 0; }
.gd-player-name-text { font-size: 24rpx; font-weight: 700; color: var(--on-surface); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.gd-player-me { font-size: 20rpx; color: var(--primary); flex-shrink: 0; }
/* 底行：名次在左补白、分数在右，卡片不再左下空一块 */
.gd-player-bottom { display: flex; align-items: baseline; justify-content: space-between; gap: 12rpx; min-width: 0; }
.gd-player-rank { font-size: 22rpx; font-weight: 500; color: var(--on-surface-variant); flex-shrink: 0; }
.gd-player-score-val { font-size: 48rpx; font-weight: 900; line-height: 1; letter-spacing: -1rpx; }

/* ========== 转分实时流水 ========== */
.gd-flow-card { background: var(--surface-container-lowest); border: 2rpx solid rgba(0, 0, 0, 0.03); border-radius: var(--radius-xl); padding: 16rpx; box-shadow: var(--shadow-card); }
.gd-flow-row { display: flex; align-items: center; gap: var(--space-sm); padding: 24rpx; }
.gd-flow-row + .gd-flow-row { border-top: 2rpx solid rgba(0, 0, 0, 0.035); }
.gd-flow-avatar { width: 72rpx; height: 72rpx; border-radius: var(--radius-md); display: flex; align-items: center; justify-content: center; font-size: 24rpx; font-weight: 600; flex-shrink: 0; }
.gd-flow-avatar-in { background: rgba(166, 243, 201, 0.35); color: var(--primary); border: 2rpx solid rgba(166, 243, 201, 0.7); }
.gd-flow-avatar-out { background: var(--tertiary-fixed); color: var(--tertiary); border: 2rpx solid var(--tertiary-fixed-dim); }
.gd-flow-avatar-neutral { background: var(--surface-container); color: var(--on-surface-variant); border: 2rpx solid var(--surface-container-high); }
.gd-flow-info { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 6rpx; }
.gd-flow-title { display: flex; align-items: center; gap: 8rpx; min-width: 0; }
.gd-flow-label { font-size: 24rpx; font-weight: 600; color: var(--on-surface); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.gd-flow-label-me { font-size: 24rpx; font-weight: 600; color: var(--primary); white-space: nowrap; }
.gd-flow-arrow { font-size: 24rpx; font-weight: 700; flex-shrink: 0; }
.gd-flow-arrow-in { color: var(--primary); }
.gd-flow-arrow-out { color: var(--tertiary); }
.gd-flow-arrow-neutral { color: var(--outline); }
.gd-flow-sub { font-size: 22rpx; color: var(--outline); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.gd-flow-right { display: flex; flex-direction: column; align-items: flex-end; gap: 4rpx; flex-shrink: 0; }
.gd-flow-score { font-size: 34rpx; font-weight: 700; line-height: 1.1; }
.gd-flow-time { font-size: 20rpx; color: var(--outline); }
.gd-flow-empty { padding: 48rpx 0; text-align: center; font-size: 24rpx; color: var(--outline); }

.gd-flow-more { display: flex; justify-content: center; padding-top: 4rpx; }
.gd-flow-more text { font-size: 24rpx; font-weight: 500; color: var(--outline); }

/* ========== 底部操作栏 ========== */
.gd-bottom { position: fixed; left: 0; right: 0; bottom: 0; z-index: 50; padding: 20rpx var(--margin-screen) calc(env(safe-area-inset-bottom) + 24rpx); background: rgba(248, 249, 255, 0.95); backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px); border-top: 2rpx solid rgba(0, 0, 0, 0.04); }
.gd-chart-btn { display: flex; align-items: center; justify-content: center; gap: 12rpx; height: 88rpx; border-radius: var(--radius-lg); background: var(--surface-container-low); color: var(--on-surface); font-size: 26rpx; font-weight: 500; }
.gd-chart-btn:active { background: var(--surface-container); }
.gd-chart-icon { width: 34rpx; height: 34rpx; }
