<!--pages/game-detail/game-detail.wxml — 牌局结算明细（queyou-mingxi 设计稿还原）-->
<view class="page">
  <!-- 自定义导航：仅返回按钮（无标题） -->
  <view class="top-bar" style="padding-top: {{capsuleTop}}px;">
    <view class="nav-back-btn" style="width: {{capsuleHeight}}px; height: {{capsuleHeight}}px;" bindtap="goBack">
      <text class="nav-back-icon">‹</text>
    </view>
  </view>

  <view class="main-content">
    <block wx:if="{{detail}}">

      <!-- 完结时间 + 零和校验 -->
      <view class="gd-summary anim-fade-up">
        <view class="gd-summary-left">
          <view class="gd-summary-dot"></view>
          <text>{{detail.endedText}}</text>
        </view>
        <view class="gd-balance-chip" wx:if="{{detail.isBalanced}}">
          <image class="gd-balance-icon" src="/assets/icons/table-balance-jade.svg" mode="aspectFit" />
          <text>零和已平账</text>
        </view>
      </view>

      <!-- 全场收支总览 -->
      <view class="gd-section anim-fade-up delay-1">
        <view class="gd-section-head">
          <view class="gd-section-title-wrap">
            <view class="gd-section-bar"></view>
            <text class="gd-section-title">全场收支总览</text>
          </view>
          <text class="gd-section-chip">{{detail.sumText}}</text>
        </view>
        <view class="gd-players-grid">
          <view class="gd-player {{p.isChampion ? 'gd-player-champion' : ''}} {{p.isNegative ? 'gd-player-negative' : ''}}" wx:for="{{detail.players}}" wx:for-item="p" wx:key="player_id">
            <view class="gd-player-top">
              <view class="gd-player-avatar-wrap">
                <view class="gd-player-avatar" style="background: {{p.avatarColor}};">
                  <image wx:if="{{p.avatar_url}}" class="gd-player-avatar-img" src="{{p.avatar_url}}" mode="aspectFill" />
                  <text wx:else>{{p.nickname[0]}}</text>
                </view>
                <image class="gd-player-wind-svg" wx:if="{{p.windClass}}" src="/assets/icons/seat-wind-{{p.windClass}}.svg" mode="aspectFit" />
              </view>
              <view class="gd-player-name">
                <text class="gd-player-name-text">{{p.nickname}}</text>
                <text class="gd-player-me" wx:if="{{p.isMe}}">(我)</text>
              </view>
            </view>
            <view class="gd-player-bottom">
              <!-- 冠军卡：徽章占掉左下的「第 1 名」，不挤头像昵称 -->
              <view class="gd-player-crown" wx:if="{{p.isChampion}}"><text>👑 全场大赢家</text></view>
              <text class="gd-player-rank" wx:elif="{{p.rank}}">第 {{p.rank}} 名</text>
              <text class="gd-player-score-val {{p.scoreClass}}">{{p.scoreText}}</text>
            </view>
          </view>
        </view>
      </view>

      <!-- 转分实时流水 -->
      <view class="gd-section anim-fade-up delay-2">
        <view class="gd-section-head">
          <view class="gd-section-title-wrap">
            <view class="gd-section-bar"></view>
            <text class="gd-section-title">转分流水</text>
          </view>
          <text class="gd-section-count">共 {{detail.flowCount}} 笔过数记录</text>
        </view>

        <view class="gd-flow-card">
          <view class="gd-flow-row" wx:for="{{flow}}" wx:key="id" wx:if="{{index < flowShown}}">
            <view class="gd-flow-avatar gd-flow-avatar-{{item.dirClass}}"><text>{{item.fromInitial}}</text></view>
            <view class="gd-flow-info">
              <view class="gd-flow-title">
                <text class="{{item.fromIsMe ? 'gd-flow-label-me' : 'gd-flow-label'}}">{{item.fromLabel}}</text>
                <text class="gd-flow-arrow gd-flow-arrow-{{item.dirClass}}">→</text>
                <text class="{{item.toIsMe ? 'gd-flow-label-me' : 'gd-flow-label'}}">{{item.toLabel}}</text>
              </view>
              <text class="gd-flow-sub">{{item.subText}}</text>
            </view>
            <view class="gd-flow-right">
              <text class="gd-flow-score {{item.scoreClass}}">{{item.scoreText}}</text>
            </view>
          </view>
          <view class="gd-flow-empty" wx:if="{{flow.length === 0}}"><text>暂无转分记录</text></view>
        </view>

        <view class="gd-flow-more" wx:if="{{flow.length > flowPageSize}}">
          <text wx:if="{{flow.length > flowShown}}" bindtap="loadMoreFlow">展开其余 {{flow.length - flowShown}} 笔流水 ⌄</text>
          <text wx:else bindtap="collapseFlow">收起流水 ⌃</text>
        </view>
      </view>
    </block>

    <view class="load-tip" wx:if="{{loading}}">加载中...</view>

    <!-- 加载失败 / 无权限查看 -->
    <view class="gd-error" wx:if="{{loadError}}">
      <image class="gd-error-icon" src="/assets/icons/sys-info-circle.svg" mode="aspectFit" />
      <text class="gd-error-text">{{loadErrorMsg}}</text>
      <text class="gd-error-sub">只有同台雀友先可以睇到呢份记录</text>
      <view class="gd-error-actions">
        <view class="gd-error-btn" bindtap="loadDetail"><text>重试</text></view>
        <view class="gd-error-btn gd-error-btn-ghost" bindtap="goHome"><text>返回首页</text></view>
      </view>
    </view>
  </view>

  <!-- 底部操作栏：积分走势曲线 -->
  <view class="gd-bottom" wx:if="{{detail}}">
    <view class="gd-chart-btn" bindtap="goChart">
      <image class="gd-chart-icon" src="/assets/icons/sys-chart-bar.svg" mode="aspectFit" />
      <text>积分走势曲线</text>
    </view>
  </view>
</view>
