<!--pages/settlement/settlement.wxml — 结算页 v4 白底卡通版-->
<view class="page" wx:if="{{settlement}}">
  <!-- 深绿找数主视觉 -->
  <view class="hero card-green anim-fade-up">
    <view class="hero-tiles">
      <view class="hero-tile hero-tile-back mj-tile mj-tile-gold anim-float-slow">發</view>
      <view class="hero-tile hero-tile-front mj-tile anim-float">中</view>
    </view>
    <view class="hero-title">找数</view>
    <view class="hero-game" wx:if="{{gameName}}">{{gameName}}</view>
    <view class="hero-info">
      <text>共{{settlement.completed_rounds}}局</text>
      <text wx:if="{{settlement.adjustment_count > 0}}"> · 改分{{settlement.adjustment_count}}条</text>
    </view>
    <view class="hero-updated" wx:if="{{settlement.settlement_updated_at}}">
      更新于 {{settlement.settlement_updated_at}}
    </view>
  </view>

  <!-- 排名列表 -->
  <view class="card anim-fade-up delay-2">
    <view class="rank-list">
      <view class="rank-item anim-fade-up" wx:for="{{settlement.players}}" wx:key="player_id">
        <!-- 排名徽章 -->
        <view class="rank-badge rank-{{item.rank}}">
          <text class="rank-num">{{item.rank}}</text>
        </view>
        <!-- 玩家信息 -->
        <view class="rank-info">
          <view class="rank-name">{{item.nickname}}</view>
          <view class="rank-title" wx:if="{{item.title}}">{{item.title}}</view>
          <view class="rank-detail" wx:if="{{item.adjustments > 0}}">
            改分{{item.adjustments}}条
          </view>
        </view>
        <!-- 分数 -->
        <view class="rank-score {{item.scoreClass}}">
          {{item.scoreText}}
        </view>
      </view>
    </view>
  </view>

  <!-- 操作 -->
  <view class="action-bar safe-bottom">
    <button class="btn-secondary" bindtap="goDetail">查看逐局详情</button>
    <button class="btn-primary" open-type="share">私密分享</button>
  </view>

  <view class="share-tip">
    本次分享仅限牌桌参与者查看详细积分
  </view>
</view>
