<!--pages/settlement/settlement.wxml — 结算页 v6 Stitch 100% 还原-->
<view class="page" wx:if="{{settlement}}">
  <view class="main-content" style="padding-top: {{navPadding}}px;">
    <!-- 散台庆祝头部 -->
    <view class="settle-header anim-fade-up">
      <view class="settle-status-pill">
        <view class="settle-status-dot"></view>
        <text>账目已清 · 雀叙圆满</text>
      </view>
      <text class="settle-title">今晚圆满散台</text>
      <view class="settle-slogan">
        <text>今晚大赢家，全场话事</text>
        <text class="settle-slogan-icon"><image src="/assets/icons/status-check-success.svg" mode="aspectFit" /></text>
      </view>
    </view>

    <!-- 排位变动卡（4人局散台后） -->
    <view class="rank-card anim-fade-up delay-1" wx:if="{{rankCard}}" bindtap="goRank">
      <view class="rank-card-head">
        <text class="rank-card-title">{{rankCard.title}}</text>
        <text class="rank-card-total {{rankCard.totalClass}}">{{rankCard.total}}</text>
      </view>
      <view class="rank-card-lines">
        <text class="rank-card-line" wx:for="{{rankCard.lines}}" wx:key="*this">{{item}}</text>
      </view>
      <text class="rank-card-link">查看我的段位与连胜 ›</text>
    </view>

    <!-- 大赢家聚焦卡 -->
    <view class="winner-card anim-fade-up delay-1">
      <view class="winner-card-glow"></view>
      <view class="winner-card-row">
        <view class="winner-avatar-wrap">
          <image class="winner-avatar" src="{{winnerAvatar}}" mode="aspectFill" wx:if="{{winnerAvatar}}" />
          <view class="winner-avatar winner-placeholder" wx:else><text>{{winnerName[0]}}</text></view>
          <view class="winner-badge"><image class="winner-badge-icon" src="/assets/icons/badge-mahjong-god.svg" mode="aspectFit" /><text>头牌</text></view>
        </view>
        <view class="winner-info">
          <view class="winner-name-row">
            <text class="winner-name">{{winnerName}}</text>
            <view class="winner-champ-tag">本台冠军</view>
          </view>
          <text class="winner-sub">全场结余领跑</text>
        </view>
        <view class="winner-score-col">
          <text class="winner-score-val">+{{winnerScore}}</text>
          <text class="winner-score-label">筹码变动</text>
        </view>
      </view>
    </view>

    <!-- 排名列表 -->
    <view class="rank-card anim-fade-up delay-2">
      <view class="rank-card-header">
        <text class="rank-card-title">四方席位结算</text>
        <text class="rank-card-sub">已平账 · 筹码无差</text>
      </view>
      <view class="rank-list">
        <view class="rank-row" wx:for="{{settlement.players}}" wx:key="player_id">
          <text class="rank-num rank-{{item.rank <= 3 ? item.rank : 'rest'}}">{{item.rank}}</text>
          <image class="rank-avatar" src="{{item.avatar_url}}" mode="aspectFill" wx:if="{{item.avatar_url}}" />
          <view class="rank-avatar rank-avatar-placeholder" wx:else><text>{{item.nickname[0]}}</text></view>
          <view class="rank-info-col">
            <view class="rank-name-row">
              <text class="rank-name">{{item.nickname}}</text>
              <view class="rank-wind-tag">{{item.wind || ''}}</view>
            </view>
            <text class="rank-detail">{{item.detail || ''}}</text>
          </view>
          <text class="rank-score {{item.score >= 0 ? 'text-positive' : 'text-negative'}}">{{item.score >= 0 ? '+' : ''}}{{item.score}}</text>
        </view>
      </view>
    </view>

    <!-- 对局统计 -->
    <view class="stats-section anim-fade-up delay-3">
      <view class="stats-header">
        <text class="stats-title">对局实况手账</text>
        <text class="stats-time">用时 1h 42m</text>
      </view>
      <view class="stats-grid">
        <view class="stats-cell">
          <text class="stats-val">{{settlement.adjustment_count}}</text>
          <text class="stats-label">转分笔数</text>
        </view>
        <view class="stats-cell">
          <text class="stats-val text-positive">+{{settlement.top_score}}</text>
          <text class="stats-label">最高净胜</text>
        </view>
        <view class="stats-cell">
          <text class="stats-val" style="color: var(--secondary);">{{settlement.player_count}}位</text>
          <text class="stats-label">参与雀友</text>
        </view>
      </view>
    </view>

    <!-- 荣耀徽章 -->
    <view class="badge-section anim-fade-up delay-4">
      <view class="badge-header">
        <text class="badge-title">本席荣耀</text>
        <view class="badge-more"><text class="badge-more-text">聚气生财</text></view>
      </view>
      <view class="badge-grid">
        <view class="badge-cell">
          <view class="badge-icon badge-icon-gold"><image src="/assets/icons/badge-mahjong-god.svg" mode="aspectFit" /></view>
          <text class="badge-name">雀神附体</text>
          <text class="badge-sub">{{winnerName}} 领衔</text>
        </view>
        <view class="badge-cell">
          <view class="badge-icon badge-icon-green"><image src="/assets/icons/badge-stable-mountain.svg" mode="aspectFit" /></view>
          <text class="badge-name">稳如泰山</text>
          <text class="badge-sub">细辉 零出冲</text>
        </view>
        <view class="badge-cell">
          <view class="badge-icon badge-icon-neutral"><image src="/assets/icons/badge-lucky-king.svg" mode="aspectFit" /></view>
          <text class="badge-name">结余平稳</text>
          <text class="badge-sub">May姐 善防守</text>
        </view>
      </view>
    </view>

    <!-- 底部操作 -->
    <view class="settle-actions anim-fade-up delay-5">
      <view class="btn-primary settle-reopen" bindtap="goReopen">
        <image class="settle-action-icon" src="/assets/icons/table-settle.svg" mode="aspectFit" /><text>再来一局 (一键克隆开台)</text>
      </view>
      <view class="btn-secondary settle-share" bindtap="goShare">
        <image class="settle-action-icon" src="/assets/icons/table-lock-private.svg" mode="aspectFit" /><text>私密加密分享 · 生成长图</text>
      </view>
    </view>

    <!-- 底部签名 -->
    <view class="settle-footer">
      <view class="settle-divider-line"></view>
      <text class="settle-footer-text">只记录现场积分 · 不设金钱交易</text>
      <text class="settle-footer-sub">悠悠茶香 雀叙情长</text>
    </view>
  </view>

  <!-- Toast -->
  <view class="toast {{showToast ? 'toast-show' : ''}}">
    <image class="toast-icon" src="/assets/icons/status-check-success.svg" mode="aspectFit" />
    <text>{{toastMsg}}</text>
  </view>
</view>
