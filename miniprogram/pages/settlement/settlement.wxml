<!--pages/settlement/settlement.wxml — 结算页-->
<view class="container" wx:if="{{settlement}}">
  <!-- 结算头部 -->
  <view class="card settle-hero">
    <view class="settle-title">结算</view>
    <view class="settle-meta">
      <text class="text-secondary">{{settlement.game_name}}</text>
      <text class="text-secondary" style="margin-left: 16rpx;">共{{settlement.completed_rounds}}局</text>
    </view>
    <view class="text-secondary" wx:if="{{settlement.adjustment_count > 0}}" style="margin-top: 4rpx;">
      改分{{settlement.adjustment_count}}条
    </view>
  </view>

  <!-- 排名列表 -->
  <view class="card">
    <view class="section-title">排名</view>
    <view class="rank-list">
      <view class="rank-item" wx:for="{{settlement.players}}" wx:key="player_id">
        <view class="rank-num rank-{{item.rank}}">
          {{item.rank}}
        </view>
        <view class="rank-info">
          <view class="rank-name">
            {{item.nickname}}
            <text class="rank-title" wx:if="{{item.title}}"> · {{item.title}}</text>
          </view>
          <view class="text-secondary" style="margin-top: 4rpx;">改分{{item.adjustments}}条</view>
        </view>
        <view class="rank-score {{item.scoreClass}}">
          {{item.scoreText}}
        </view>
      </view>
    </view>
  </view>

  <!-- 操作 -->
  <view class="action-bar">
    <button class="btn-secondary" bindtap="goDetail">逐局详情</button>
    <button class="btn-accent" open-type="share">分享结算</button>
  </view>
</view>
