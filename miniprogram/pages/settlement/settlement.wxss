/* pages/settlement/settlement.wxss — 结算页 v6 Stitch 100% 还原 */
.page { min-height: 100vh; background: var(--background); }
.main-content { padding-left: var(--margin-screen); padding-right: var(--margin-screen); padding-bottom: 120rpx; display: flex; flex-direction: column; gap: var(--space-lg); }

/* 散台头部 */
.settle-header { display: flex; flex-direction: column; align-items: center; text-align: center; padding: var(--space-md) 0 var(--space-lg); }
.settle-status-pill { display: inline-flex; align-items: center; gap: 12rpx; padding: 8rpx 24rpx; border-radius: var(--radius-full); background: var(--surface-container-low); margin-bottom: var(--space-sm); }
.settle-status-dot { width: 12rpx; height: 12rpx; border-radius: 50%; background: var(--primary); animation: pulse 2s ease-in-out infinite; }
.settle-title { font-size: 56rpx; font-weight: 700; color: var(--on-surface); letter-spacing: -2rpx; }
.settle-slogan { display: flex; align-items: center; gap: 8rpx; margin-top: 8rpx; }
.settle-slogan text { font-size: 28rpx; color: var(--on-surface-variant); }
.settle-slogan-icon image { width: 28rpx; height: 28rpx; }
.settle-slogan-icon { font-size: 28rpx; color: var(--secondary); }

/* 大赢家卡 */
.winner-card { position: relative; overflow: hidden; border-radius: var(--radius-lg); background: var(--surface-container-lowest); padding: var(--space-lg); box-shadow: var(--shadow-card); }
.winner-card-glow { position: absolute; right: -32rpx; top: -32rpx; width: 224rpx; height: 224rpx; border-radius: 50%; background: rgba(0, 82, 53, 0.05); pointer-events: none; }
.winner-card-row { display: flex; align-items: center; justify-content: space-between; position: relative; }
.winner-avatar-wrap { position: relative; }
.winner-avatar { width: 112rpx; height: 112rpx; border-radius: 50%; background: var(--secondary-fixed); box-shadow: var(--shadow-card); }
.winner-placeholder { display: flex; align-items: center; justify-content: center; font-size: 44rpx; font-weight: 700; color: var(--on-secondary-fixed); }
.winner-badge { position: absolute; bottom: -8rpx; right: -8rpx; padding: 4rpx 12rpx; border-radius: var(--radius-full); background: var(--secondary-container); color: var(--on-secondary-container); font-size: 20rpx; font-weight: 500; display: flex; align-items: center; gap: 4rpx; box-shadow: var(--shadow-card); }
.winner-badge-icon { width: 28rpx; height: 28rpx; }
.winner-info { flex: 1; margin-left: var(--space-md); }
.winner-name-row { display: flex; align-items: center; gap: 8rpx; }
.winner-name { font-size: 36rpx; font-weight: 600; color: var(--on-surface); }
.winner-champ-tag { padding: 4rpx 12rpx; border-radius: var(--radius-default); background: var(--primary-fixed); color: var(--on-primary-fixed-variant); font-size: 20rpx; font-weight: 500; }
.winner-sub { font-size: 24rpx; color: var(--on-surface-variant); margin-top: 4rpx; }
.winner-score-col { text-align: right; }
.winner-score-val { font-size: 44rpx; font-weight: 700; color: var(--primary); }
.winner-score-label { font-size: 20rpx; color: var(--primary); opacity: 0.8; display: block; }

/* 排名卡 */
.rank-card { border-radius: var(--radius-lg); background: var(--surface-container-lowest); box-shadow: var(--shadow-card); overflow: hidden; }
.rank-card-header { padding: var(--space-sm) var(--space-md); background: var(--surface-container-low); display: flex; justify-content: space-between; align-items: center; }
.rank-card-title { font-size: 24rpx; color: var(--on-surface-variant); text-transform: uppercase; letter-spacing: 1rpx; }
.rank-card-sub { font-size: 20rpx; color: var(--outline); }
.rank-list { display: flex; flex-direction: column; }
.rank-row { display: flex; align-items: center; justify-content: space-between; padding: var(--space-sm) var(--space-md); background: var(--surface-container-lowest); }
.rank-num { width: 40rpx; font-size: 36rpx; font-weight: 600; text-align: center; }
.rank-1 { color: var(--secondary); }
.rank-2 { color: var(--on-surface-variant); }
.rank-3 { color: var(--on-surface-variant); }
.rank-rest { color: var(--outline); }
.rank-avatar { width: 72rpx; height: 72rpx; border-radius: 50%; background: var(--surface-container); flex-shrink: 0; margin: 0 var(--space-sm); }
.rank-avatar-placeholder { display: flex; align-items: center; justify-content: center; font-size: 28rpx; font-weight: 600; color: var(--on-surface); }
.rank-info-col { flex: 1; min-width: 0; }
.rank-name-row { display: flex; align-items: center; gap: 12rpx; }
.rank-name { font-size: 28rpx; font-weight: 600; color: var(--on-surface); }
.rank-wind-tag { padding: 4rpx 8rpx; border-radius: var(--radius-default); background: var(--surface-container-high); color: var(--on-surface-variant); font-size: 20rpx; }
.rank-detail { font-size: 24rpx; color: var(--on-surface-variant); }
.rank-score { font-size: 44rpx; font-weight: 700; flex-shrink: 0; }

/* 统计 */
.stats-section { }
.stats-header { display: flex; align-items: center; justify-content: space-between; padding: 0 8rpx; margin-bottom: var(--space-xs); }
.stats-title { font-size: 36rpx; font-weight: 600; color: var(--on-surface); }
.stats-time { font-size: 20rpx; color: var(--outline); }
.stats-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--gutter-grid); }
.stats-cell { display: flex; flex-direction: column; align-items: center; justify-content: center; padding: var(--space-md); border-radius: var(--radius-lg); background: var(--surface-container-lowest); box-shadow: var(--shadow-card); text-align: center; }
.stats-val { font-size: 56rpx; font-weight: 700; color: var(--on-surface); }
.stats-label { font-size: 24rpx; color: var(--on-surface-variant); margin-top: 4rpx; }

/* 徽章 */
.badge-section { }
.badge-header { display: flex; align-items: center; justify-content: space-between; padding: 0 8rpx; margin-bottom: var(--space-xs); }
.badge-title { font-size: 36rpx; font-weight: 600; color: var(--on-surface); }
.badge-more-text { font-size: 24rpx; color: var(--primary); }
.badge-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--gutter-grid); }
.badge-cell { display: flex; flex-direction: column; align-items: center; padding: var(--space-sm); border-radius: var(--radius-lg); background: var(--surface-container-lowest); box-shadow: var(--shadow-card); text-align: center; }
.badge-icon image { width: 40rpx; height: 40rpx; }
.badge-icon { width: 80rpx; height: 80rpx; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin-bottom: 8rpx; }
.badge-icon-gold { background: var(--secondary-fixed); }
.badge-icon-green { background: var(--primary-fixed); }
.badge-icon-neutral { background: var(--surface-container-high); }
.badge-name { font-size: 24rpx; font-weight: 600; color: var(--on-surface); }
.badge-sub { font-size: 20rpx; color: var(--outline); margin-top: 4rpx; }

/* 操作 */
.settle-actions { display: flex; flex-direction: column; gap: var(--space-sm); padding-top: var(--space-xs); }
.settle-reopen, .settle-share { display: flex; align-items: center; justify-content: center; gap: 8rpx; }
.settle-action-icon { width: 28rpx; height: 28rpx; }

/* 底部 */
.settle-footer { display: flex; flex-direction: column; align-items: center; padding: var(--space-md) 0 var(--space-sm); text-align: center; }
.settle-divider-line { width: 80rpx; height: 2rpx; background: var(--surface-container-highest); margin-bottom: 16rpx; }
.settle-footer-text { font-size: 24rpx; color: var(--outline); }
.settle-footer-sub { font-size: 20rpx; color: var(--outline-variant); margin-top: 4rpx; }

/* Toast */
.toast { position: fixed; bottom: 80rpx; left: 50%; transform: translateX(-50%); z-index: 200; padding: 16rpx 32rpx; border-radius: var(--radius-full); background: rgba(33, 49, 69, 0.9); color: var(--inverse-on-surface); font-size: 24rpx; box-shadow: var(--shadow-modal); opacity: 0; transition: opacity 0.3s ease; pointer-events: none; display: flex; align-items: center; gap: 8rpx; }
.toast.toast-show { opacity: 1; }
.toast-icon { width: 28rpx; height: 28rpx; }

/* 排位变动卡 */
.rank-card { background: var(--surface-container-lowest); border-radius: var(--radius-lg); padding: var(--space-md); box-shadow: var(--shadow-card); display: flex; flex-direction: column; gap: 12rpx; border-left: 6rpx solid var(--primary); }
.rank-card-head { display: flex; align-items: center; justify-content: space-between; }
.rank-card-title { font-size: 28rpx; font-weight: 700; color: var(--on-surface); }
.rank-card-total { font-size: 36rpx; font-weight: 700; }
.rank-card-lines { display: flex; flex-direction: column; gap: 4rpx; }
.rank-card-line { font-size: 24rpx; color: var(--on-surface-variant); }
.rank-card-link { font-size: 22rpx; color: var(--primary); font-weight: 600; }
