/* pages/settlement/settlement.wxss — 结算页 v4 白底卡通版
 * 深绿找数主视觉 + 金银铜名次徽章 + 金色称号
 */

.page {
  padding: 32rpx;
  min-height: 100vh;
  box-sizing: border-box;
}

/* ========== 深绿找数主视觉 ========== */
.hero {
  border-radius: 28rpx;
  padding: 56rpx 36rpx 44rpx;
  margin-bottom: 32rpx;
  text-align: center;
  position: relative;
  overflow: hidden;
}

.hero-tiles {
  position: relative;
  width: 150rpx;
  height: 140rpx;
  margin: 0 auto 20rpx;
}

.hero-tile {
  position: absolute;
  width: 84rpx;
  height: 112rpx;
  font-size: 40rpx;
}

.hero-tile-back {
  left: 4rpx;
  top: 22rpx;
  transform: rotate(-12deg);
  background: rgba(255, 248, 239, 0.9);
}

.hero-tile-front {
  right: 10rpx;
  top: 4rpx;
  transform: rotate(8deg);
  z-index: 2;
}

.hero-title {
  color: #FFF8EF;
  font-size: 48rpx;
  font-weight: 900;
  letter-spacing: 10rpx;
  margin-bottom: 10rpx;
}

.hero-game {
  color: rgba(255, 248, 239, 0.85);
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 6rpx;
}

.hero-info {
  color: rgba(255, 248, 239, 0.65);
  font-size: 26rpx;
}

.hero-updated {
  color: rgba(255, 248, 239, 0.4);
  font-size: 22rpx;
  margin-top: 10rpx;
}

/* ========== 排名列表 ========== */
.rank-list {
  padding: 8rpx 0;
}

.rank-item {
  display: flex;
  align-items: center;
  padding: 28rpx 0;
  border-bottom: 1rpx dashed var(--color-border);
}

.rank-item:last-child {
  border-bottom: none;
}

/* 排名徽章：金银铜 */
.rank-badge {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-right: 24rpx;
}

.rank-badge .rank-num {
  font-size: 34rpx;
  font-weight: 800;
}

.rank-1 {
  background: linear-gradient(135deg, #D9B86A, #C9A254);
  color: #FFF;
  box-shadow: 0 6rpx 16rpx var(--color-gold-glow);
}

.rank-2 {
  background: linear-gradient(135deg, #C4CBD2, #9FA8B0);
  color: #FFF;
}

.rank-3 {
  background: linear-gradient(135deg, #D29A6A, #C98A5B);
  color: #FFF;
}

.rank-4, .rank-5, .rank-6 {
  background: var(--color-bg-soft);
  color: var(--color-text-secondary);
  border: 1rpx solid var(--color-border);
}

/* 玩家信息 */
.rank-info {
  flex: 1;
  min-width: 0;
}

.rank-name {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--color-text);
}

.rank-title {
  display: inline-block;
  font-size: 22rpx;
  color: var(--color-gold-dark);
  background: var(--color-gold-light);
  border: 1rpx solid var(--color-gold);
  padding: 4rpx 16rpx;
  border-radius: 16rpx;
  margin-top: 8rpx;
}

.rank-detail {
  font-size: 22rpx;
  color: var(--color-text-secondary);
  margin-top: 6rpx;
}

/* 分数 */
.rank-score {
  font-size: 44rpx;
  font-weight: 800;
  flex-shrink: 0;
}

/* ========== 底部操作 ========== */
.action-bar {
  padding: 32rpx 0 12rpx;
}

.action-bar button {
  margin-bottom: 20rpx;
}

.share-tip {
  text-align: center;
  color: var(--color-text-tertiary);
  font-size: 22rpx;
  padding: 16rpx 0;
}
