/* pages/detail/detail.wxss */
.detail-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.detail-name {
  font-size: 36rpx;
  font-weight: 700;
}

.round-item {
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--color-divider);
}

.round-item:last-child {
  border-bottom: none;
}

.round-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-accent);
  margin-bottom: 16rpx;
}

.round-subs {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.sub-item {
  display: flex;
  align-items: center;
  gap: 12rpx;
  background: var(--color-divider);
  border-radius: var(--radius-sm);
  padding: 12rpx 20rpx;
}

.sub-name {
  font-size: 26rpx;
  color: var(--color-text-secondary);
}

.sub-score {
  font-size: 28rpx;
  font-weight: 700;
}

.adj-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--color-divider);
}

.adj-item:last-child {
  border-bottom: none;
}

.adj-type {
  font-size: 28rpx;
  font-weight: 600;
}
