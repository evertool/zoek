/* pages/detail/detail.wxss — 单场详情（设计 v2：时间线 + 金边调整卡） */

.page {
  padding: 32rpx;
  min-height: 100vh;
  box-sizing: border-box;
}

/* ===== 头部卡 ===== */
.hero-card {
  display: flex;
  align-items: center;
}

.hero-tile {
  width: 84rpx;
  height: 110rpx;
  font-size: 40rpx;
  flex-shrink: 0;
  margin-right: 26rpx;
}

.hero-main {
  flex: 1;
  min-width: 0;
}

.hero-name {
  font-size: 38rpx;
  font-weight: 800;
  color: var(--color-text);
  margin-bottom: 6rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* ===== 逐局时间线 ===== */
.round-item {
  display: flex;
  padding-bottom: 28rpx;
}

.round-item:last-child {
  padding-bottom: 8rpx;
}

.round-rail {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-right: 22rpx;
  flex-shrink: 0;
}

.round-num-tile {
  width: 60rpx;
  height: 78rpx;
  font-size: 28rpx;
  flex-shrink: 0;
}

.round-line {
  flex: 1;
  width: 3rpx;
  min-height: 24rpx;
  background: var(--color-border);
  margin-top: 8rpx;
}

.round-body {
  flex: 1;
  min-width: 0;
  padding-top: 8rpx;
}

.round-num {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--color-green);
  margin-bottom: 14rpx;
}

.round-subs {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.sub-chip {
  display: flex;
  align-items: center;
  background: var(--color-card-warm);
  border: 1rpx solid var(--color-border);
  border-radius: 40rpx;
  padding: 8rpx 20rpx;
}

.sub-name {
  font-size: 24rpx;
  color: var(--color-text-secondary);
  margin-right: 10rpx;
}

.sub-score {
  font-size: 28rpx;
  font-weight: 700;
}

/* ===== 改分记录（金色左边条） ===== */
.adj-card {
  border-left: 8rpx solid var(--color-gold);
}

.adj-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx dashed var(--color-border);
}

.adj-row:last-child {
  border-bottom: none;
}

.adj-type {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text);
}

/* ===== 底部操作 ===== */
.action-bar {
  padding: 32rpx 0 12rpx;
}
