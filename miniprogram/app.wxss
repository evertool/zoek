/* app.wxss — 得闲开台全局样式 v6
 * 100% Stitch Design System: Lingnan Mahjong Social Scorekeeper
 * 所有数值精确映射 Stitch px -> rpx (×2)
 */

page {
  /* === 色彩系统 === */
  --surface: #f8f9ff;
  --surface-dim: #cbdbf5;
  --surface-bright: #f8f9ff;
  --surface-container-lowest: #ffffff;
  --surface-container-low: #eff4ff;
  --surface-container: #e5eeff;
  --surface-container-high: #dce9ff;
  --surface-container-highest: #d3e4fe;
  --on-surface: #0b1c30;
  --on-surface-variant: #3f4943;
  --inverse-surface: #213145;
  --inverse-on-surface: #eaf1ff;
  --outline: #6f7a72;
  --outline-variant: #bfc9c0;
  --surface-tint: #1b6b4a;
  --surface-variant: #d3e4fe;

  --primary: #005235;
  --on-primary: #ffffff;
  --primary-container: #1b6b4a;
  --on-primary-container: #9ce9bf;
  --inverse-primary: #8ad6ae;
  --primary-fixed: #a6f3c9;
  --primary-fixed-dim: #8ad6ae;
  --on-primary-fixed: #002113;
  --on-primary-fixed-variant: #005235;

  --secondary: #904d00;
  --on-secondary: #ffffff;
  --secondary-container: #fe932c;
  --on-secondary-container: #663500;
  --secondary-fixed: #ffdcc3;
  --secondary-fixed-dim: #ffb77d;
  --on-secondary-fixed: #2f1500;
  --on-secondary-fixed-variant: #6e3900;

  --tertiary: #8e1215;
  --on-tertiary: #ffffff;
  --tertiary-container: #b02d29;
  --on-tertiary-container: #ffcdc7;
  --tertiary-fixed: #ffdad6;
  --tertiary-fixed-dim: #ffb4ac;
  --on-tertiary-fixed: #410002;
  --on-tertiary-fixed-variant: #8e1214;

  --error: #ba1a1a;
  --on-error: #ffffff;
  --error-container: #ffdad6;
  --on-error-container: #93000a;

  --background: #f8f9ff;
  --on-background: #0b1c30;

  /* === 间距系统 (Stitch px→rpx ×2) === */
  --space-2xs: 8rpx;
  --space-xs: 16rpx;
  --space-sm: 24rpx;
  --space-md: 32rpx;
  --space-lg: 40rpx;
  --space-xl: 48rpx;
  --space-2xl: 64rpx;
  --space-3xl: 80rpx;
  --margin-screen: 40rpx;
  --gutter-grid: 24rpx;

  /* === 圆角系统 (Stitch px→rpx ×2) === */
  --radius-sm: 8rpx;
  --radius-default: 16rpx;
  --radius-md: 24rpx;
  --radius-lg: 32rpx;
  --radius-xl: 48rpx;
  --radius-full: 9999rpx;

  /* === 阴影系统 === */
  --shadow-card: 0 4rpx 16rpx -4rpx rgba(11,28,48,0.06), 0 2rpx 4rpx -2rpx rgba(11,28,48,0.03);
  --shadow-lifted: 0 16rpx 48rpx -8rpx rgba(27,107,74,0.12), 0 4rpx 12rpx -2rpx rgba(11,28,48,0.04);
  --shadow-modal: 0 48rpx 96rpx -16rpx rgba(0,0,0,0.18);

  /* === 字体规格 (Stitch px→rpx ×2) === */
  --font-display-lg: 72rpx;
  --font-display-mobile: 56rpx;
  --font-headline-lg: 48rpx;
  --font-headline-md: 40rpx;
  --font-headline-sm: 36rpx;
  --font-body-lg: 32rpx;
  --font-body-md: 28rpx;
  --font-body-sm: 24rpx;
  --font-label-lg: 28rpx;
  --font-label-md: 24rpx;
  --font-label-sm: 20rpx;
  --font-score-numeral: 44rpx;

  background-color: var(--background);
  color: var(--on-surface);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", sans-serif;
  font-size: 28rpx;
  line-height: 1.5;
}

/* ========== 页面容器 ========== */
.page {
  min-height: 100vh;
  background: var(--background);
  box-sizing: border-box;
}

/* ========== 安全区辅助 ========== */
.pt-safe { padding-top: env(safe-area-inset-top); }
.pb-safe { padding-bottom: env(safe-area-inset-bottom); }

/* ========== 卡片 ========== */
.card {
  background: var(--surface-container-lowest);
  border-radius: var(--radius-lg);
  padding: var(--space-lg);
  margin-bottom: var(--space-md);
  box-shadow: var(--shadow-card);
}

/* ========== 按钮 ========== */
/* 按钮文字不换行（长文案单行省略） */
.btn-primary, .btn-secondary, .btn-danger { overflow: hidden; }
.btn-primary text, .btn-secondary text, .btn-danger text { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

.btn-primary {
  background: var(--primary);
  color: var(--on-primary);
  border: none;
  border-radius: var(--radius-md);
  padding: 24rpx 40rpx;
  font-size: 28rpx;
  font-weight: 600;
  text-align: center;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: var(--space-xs);
  width: 100%;
  box-sizing: border-box;
  transition: opacity 0.2s ease, transform 0.2s ease;
}
.btn-primary:active { opacity: 0.9; transform: scale(0.99); }
.btn-primary[disabled] { opacity: 0.4; }

.btn-secondary {
  background: var(--surface-container-lowest);
  color: var(--on-surface);
  border: 2rpx solid var(--outline-variant);
  border-radius: var(--radius-md);
  padding: 24rpx 40rpx;
  font-size: 28rpx;
  font-weight: 600;
  text-align: center;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: var(--space-xs);
  width: 100%;
  box-sizing: border-box;
  transition: background 0.2s ease, transform 0.2s ease;
}
.btn-secondary:active { background: var(--surface-container-low); transform: scale(0.99); }

.btn-danger {
  background: transparent;
  color: var(--error);
  border: 2rpx solid var(--error);
  border-radius: var(--radius-md);
  padding: 24rpx 40rpx;
  font-size: 28rpx;
  font-weight: 600;
  text-align: center;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: var(--space-xs);
  width: 100%;
  box-sizing: border-box;
  transition: background 0.2s ease, transform 0.2s ease;
}
.btn-danger:active { background: var(--error-container); transform: scale(0.99); }

.btn-green { 
  background: var(--primary); color: var(--on-primary); border: none; 
  border-radius: var(--radius-md); padding: 24rpx 40rpx; font-size: 28rpx; font-weight: 600; 
  text-align: center; display: flex; align-items: center; justify-content: center; gap: var(--space-xs); 
  width: 100%; box-sizing: border-box; transition: opacity 0.2s ease, transform 0.2s ease; 
}
.btn-green:active { opacity: 0.9; transform: scale(0.99); }
.btn-green[disabled] { opacity: 0.4; }

/* ========== 标签 ========== */
.tag {
  display: inline-flex; align-items: center; gap: 6rpx;
  padding: 6rpx 16rpx; border-radius: var(--radius-full);
  font-size: 20rpx; font-weight: 500; letter-spacing: 0.5rpx;
}
.tag-forming { background: var(--secondary-fixed); color: var(--on-secondary-fixed); }
.tag-active { background: var(--primary-fixed); color: var(--on-primary-fixed-variant); }
.tag-ended { background: var(--surface-container-high); color: var(--on-surface-variant); }
.tag-cancelled { background: var(--error-container); color: var(--on-error-container); }
.tag-pending { background: var(--tertiary-fixed); color: var(--on-tertiary-fixed-variant); }
.tag-accepted { background: var(--primary-fixed); color: var(--on-primary-fixed-variant); }

/* ========== 文字 ========== */
.text-secondary { color: var(--on-surface-variant); font-size: 24rpx; }
.text-positive { color: var(--primary); font-weight: 700; }
.text-negative { color: var(--tertiary); font-weight: 700; }
.text-zero { color: var(--on-surface-variant); font-weight: 600; }

/* ========== 空状态 ========== */
.empty-state { text-align: center; padding: 120rpx 40rpx; color: var(--on-surface-variant); }
.empty-state .empty-text { font-size: 30rpx; margin-bottom: 8rpx; }

/* ========== 底部操作栏 ========== */
.footer-bar {
  position: fixed; left: 0; right: 0; bottom: 0;
  padding: 20rpx var(--margin-screen) calc(env(safe-area-inset-bottom) + 20rpx);
  background: rgba(248, 249, 255, 0.92);
  backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px);
  border-top: 1rpx solid var(--outline-variant); z-index: 50;
}
.safe-bottom { padding-bottom: env(safe-area-inset-bottom); }

/* ========== 动画 ========== */
@keyframes fadeInUp { from { opacity: 0; transform: translateY(40rpx); } to { opacity: 1; transform: translateY(0); } }
@keyframes fadeInScale { from { opacity: 0; transform: scale(0.85); } to { opacity: 1; transform: scale(1); } }
@keyframes slideInFromBottom { from { transform: translateY(100%); } to { transform: translateY(0); } }
@keyframes pulse { 0%,100% { opacity: 1; } 50% { opacity: 0.5; } }

.anim-fade-up { animation: fadeInUp 0.5s cubic-bezier(0,0,0.2,1) both; }
.anim-fade-scale { animation: fadeInScale 0.4s cubic-bezier(0,0,0.2,1) both; }
.anim-slide-up { animation: slideInFromBottom 0.3s cubic-bezier(0,0,0.2,1) both; }
.anim-pulse { animation: pulse 2s ease-in-out infinite; }

.delay-1 { animation-delay: 0.06s; }
.delay-2 { animation-delay: 0.12s; }
.delay-3 { animation-delay: 0.18s; }
.delay-4 { animation-delay: 0.24s; }
.delay-5 { animation-delay: 0.3s; }
.delay-6 { animation-delay: 0.36s; }
.delay-7 { animation-delay: 0.42s; }
.delay-8 { animation-delay: 0.48s; }

/* ========== 麻将牌 (兼容) ========== */
.mj-tile {
  display: inline-flex; align-items: center; justify-content: center;
  background: linear-gradient(145deg, #ffffff 0%, #f5f0e6 60%, #e8dfd0 100%);
  border-radius: 18%; position: relative; font-weight: 900; line-height: 1; z-index: 1;
  box-shadow: 0 8rpx 24rpx rgba(26,26,46,0.12), inset 0 3rpx 8rpx rgba(26,26,46,0.06);
  border: 2rpx solid rgba(216,207,182,0.4);
}
.mj-tile-red { color: #e8442e; }
.mj-tile-green { color: #1e6b47; }
.mj-tile-gold { color: #a8851e; }
.mj-tile-blue { color: #2d5a9d; }
.mj-tile-ink { color: #2f2f2f; }
/* 白板 = 内框双线（牌面自身描边保持默认淡色，不参与） */
.mj-tile-blank { color: transparent; }
.blank-inner { position: absolute; top: 14%; left: 14%; right: 14%; bottom: 14%; border: 3rpx solid #2d5a9d; border-radius: 8%; }
.blank-inner::after { content: ''; position: absolute; top: 5rpx; left: 5rpx; right: 5rpx; bottom: 5rpx; border: 3rpx solid #2d5a9d; border-radius: 6rpx; }
