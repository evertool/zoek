/* app.wxss — 得闲开台全局样式
 * 色系参照 docs/design 设计图（v2 重构）
 * 米白宣纸底 + 牌桌深绿 + 红橙 CTA + 金色点缀，麻将牌视觉母题
 */

page {
  /* 品牌色系（设计图 v2） */
  --color-primary: #1E6B47;        /* 牌桌深绿（主品牌色） */
  --color-primary-dark: #145036;   /* 深绿按压态 */
  --color-primary-light: #E4F0E9;  /* 浅绿背景 */
  --color-cta: #E8442E;            /* 红橙 CTA（主按钮） */
  --color-cta-light: #FDE8E4;      /* 浅红背景 */
  --color-gold: #C9A254;           /* 金色点缀 */
  --color-gold-light: #F6EEDC;     /* 浅金背景 */
  --color-dark: #23352B;           /* 墨绿近黑（标题文字） */
  --color-success: #3E8E5A;        /* 成功绿 */
  --color-success-light: #E4F0E9;  /* 浅绿背景 */
  --color-warning: #E8842E;        /* 警告橙 */
  --color-warning-light: #FDF0E2; /* 浅橙背景 */
  --color-error: #C93A2E;          /* 错误红 */
  --color-bg: #F7F3E8;             /* 米白宣纸背景（设计图主底色） */
  --color-card: #FFFFFF;           /* 卡片白 */
  --color-card-warm: #FCFAF3;     /* 暖白卡片 */
  --color-text: #23352B;           /* 主文字墨绿 */
  --color-text-secondary: #7A8480; /* 次文字灰绿 */
  --color-text-tertiary: #B8C0BB;  /* 三级文字 */
  --color-border: #EDE7D8;         /* 米色边框 */

  background-color: var(--color-bg);
  color: var(--color-text);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
  line-height: 1.6;
}

/* ========== 页面容器 ========== */
.page {
  padding: 32rpx 32rpx calc(env(safe-area-inset-bottom) + 40rpx);
  min-height: 100vh;
  box-sizing: border-box;
}

/* ========== 卡片 ========== */
.card {
  background: var(--color-card);
  border-radius: 28rpx;
  padding: 36rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 6rpx 28rpx rgba(35, 53, 43, 0.06);
  border: 1rpx solid var(--color-border);
}

.card-warm {
  background: var(--color-card-warm);
}

/* 深绿实底卡片（设计图中的主视觉卡） */
.card-green {
  background: linear-gradient(160deg, #237652 0%, #1E6B47 55%, #175A3B 100%);
  color: #F7F3E8;
  border: none;
  box-shadow: 0 12rpx 32rpx rgba(30, 107, 71, 0.3);
}

/* ========== 按钮 ========== */
/* 红橙主 CTA */
.btn-primary {
  background: linear-gradient(135deg, #F0603F 0%, #E8442E 100%);
  color: #FFFFFF;
  border: none;
  border-radius: 48rpx;
  padding: 24rpx 48rpx;
  font-size: 30rpx;
  font-weight: 600;
  text-align: center;
  display: block;
  width: 100%;
  box-sizing: border-box;
  letter-spacing: 2rpx;
  box-shadow: 0 10rpx 24rpx rgba(232, 68, 46, 0.28);
}

.btn-primary[disabled] {
  opacity: 0.4;
  box-shadow: none;
}

/* 深绿按钮（次级确认动作） */
.btn-green {
  background: linear-gradient(135deg, #237652 0%, #1E6B47 100%);
  color: #FFFFFF;
  border: none;
  border-radius: 48rpx;
  padding: 24rpx 48rpx;
  font-size: 30rpx;
  font-weight: 600;
  text-align: center;
  display: block;
  width: 100%;
  box-sizing: border-box;
  letter-spacing: 2rpx;
  box-shadow: 0 10rpx 24rpx rgba(30, 107, 71, 0.28);
}

.btn-green[disabled] {
  opacity: 0.4;
  box-shadow: none;
}

.btn-secondary {
  background: var(--color-card);
  color: var(--color-text);
  border: 2rpx solid var(--color-border);
  border-radius: 48rpx;
  padding: 24rpx 48rpx;
  font-size: 30rpx;
  font-weight: 500;
  text-align: center;
  display: block;
  width: 100%;
  box-sizing: border-box;
}

.btn-danger {
  background: transparent;
  color: var(--color-error);
  border: 2rpx solid var(--color-error);
  border-radius: 48rpx;
  padding: 24rpx 48rpx;
  font-size: 30rpx;
  font-weight: 500;
  text-align: center;
  display: block;
  width: 100%;
  box-sizing: border-box;
}

/* ========== 麻将牌视觉母题 ========== */
/* 立体麻将牌：米白牌面 + 圆角 + 底部厚度 */
.mj-tile {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(180deg, #FFFEF9 0%, #F3EEDF 100%);
  border-radius: 18%;
  border: 1rpx solid #E8E0CC;
  box-shadow: 0 6rpx 0 #D8CFB6, 0 10rpx 18rpx rgba(35, 53, 43, 0.15);
  color: var(--color-cta);
  font-weight: 800;
  line-height: 1;
}

.mj-tile-green {
  color: var(--color-primary);
}

.mj-tile-gold {
  color: var(--color-gold);
}

/* ========== 标题 ========== */
.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--color-text);
  margin-bottom: 20rpx;
  letter-spacing: 1rpx;
}

/* ========== 文字辅助 ========== */
.text-secondary {
  color: var(--color-text-secondary);
  font-size: 24rpx;
}

.text-success { color: var(--color-success); }
.text-warning { color: var(--color-warning); }
.text-error { color: var(--color-error); }

.text-positive {
  color: var(--color-cta);
  font-weight: 700;
}

.text-negative {
  color: var(--color-primary);
  font-weight: 700;
}

.text-zero {
  color: var(--color-text-secondary);
  font-weight: 600;
}

/* ========== 空状态 ========== */
.empty-state {
  text-align: center;
  padding: 120rpx 40rpx;
  color: var(--color-text-secondary);
}

.empty-state .empty-icon {
  font-size: 96rpx;
  margin-bottom: 24rpx;
  opacity: 0.6;
}

.empty-state .empty-text {
  font-size: 30rpx;
  margin-bottom: 8rpx;
}

/* ========== 状态标签 ========== */
.tag {
  display: inline-block;
  padding: 6rpx 20rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  font-weight: 500;
}

.tag-forming {
  background: var(--color-gold-light);
  color: #8C6B25;
}

.tag-active {
  background: var(--color-primary-light);
  color: var(--color-primary);
}

.tag-ended {
  background: #EFEDE6;
  color: var(--color-text-secondary);
}

.tag-cancelled {
  background: var(--color-cta-light);
  color: var(--color-error);
}

.tag-pending {
  background: var(--color-warning-light);
  color: #B25E14;
}

.tag-accepted {
  background: var(--color-success-light);
  color: var(--color-success);
}

/* ========== 底部操作栏（固定） ========== */
.footer-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 20rpx 32rpx calc(env(safe-area-inset-bottom) + 20rpx);
  background: rgba(251, 249, 245, 0.95);
  backdrop-filter: blur(12px);
  border-top: 1rpx solid var(--color-border);
  z-index: 50;
}

/* ========== 底部安全区 ========== */
.safe-bottom {
  padding-bottom: env(safe-area-inset-bottom);
}
