/* app.wxss — 雀记全局设计系统 */

/* ========== 设计变量 ========== */
page {
  --color-primary: #2B2B2B;
  --color-primary-light: #5C5C5C;
  --color-accent: #D4A24C;
  --color-accent-light: #E8C894;
  --color-success: #3D6B3D;
  --color-error: #B33A3A;
  --color-info: #3B5998;
  --color-bg: #F2F2F7;
  --color-card: #FFFFFF;
  --color-text: #1A1A1A;
  --color-text-secondary: #8E8E93;
  --color-text-tertiary: #C4C4C6;
  --color-border: #E5E5EA;
  --color-divider: #F0F0F2;

  --radius-sm: 8rpx;
  --radius-md: 16rpx;
  --radius-lg: 24rpx;
  --radius-xl: 32rpx;
  --shadow-sm: 0 1rpx 4rpx rgba(0,0,0,0.04);
  --shadow-md: 0 2rpx 16rpx rgba(0,0,0,0.06);

  background: var(--color-bg);
  color: var(--color-text);
  font-family: -apple-system, "PingFang SC", "Helvetica Neue", sans-serif;
  font-size: 28rpx;
  line-height: 1.5;
}

/* ========== 通用容器 ========== */
.container {
  padding: 24rpx 24rpx 120rpx;
}

/* ========== 卡片 ========== */
.card {
  background: var(--color-card);
  border-radius: var(--radius-lg);
  padding: 32rpx;
  margin-bottom: 20rpx;
  box-shadow: var(--shadow-sm);
}

/* ========== 按钮 ========== */
.btn-primary {
  background: var(--color-primary);
  color: #FFFFFF;
  border: none;
  border-radius: var(--radius-md);
  padding: 24rpx 0;
  font-size: 30rpx;
  font-weight: 500;
  text-align: center;
  width: 100%;
  box-sizing: border-box;
  line-height: 1.4;
}

.btn-primary::after { border: none; }
.btn-primary[disabled] { opacity: 0.4; }

.btn-accent {
  background: var(--color-accent);
  color: #FFFFFF;
  border: none;
  border-radius: var(--radius-md);
  padding: 24rpx 0;
  font-size: 30rpx;
  font-weight: 500;
  text-align: center;
  width: 100%;
  box-sizing: border-box;
}

.btn-accent::after { border: none; }

.btn-secondary {
  background: var(--color-card);
  color: var(--color-text);
  border: 2rpx solid var(--color-border);
  border-radius: var(--radius-md);
  padding: 22rpx 0;
  font-size: 30rpx;
  text-align: center;
  width: 100%;
  box-sizing: border-box;
}

.btn-secondary::after { border: none; }

.btn-danger {
  background: transparent;
  color: var(--color-error);
  border: 2rpx solid var(--color-error);
  border-radius: var(--radius-md);
  padding: 22rpx 0;
  font-size: 30rpx;
  text-align: center;
  width: 100%;
  box-sizing: border-box;
}

.btn-danger::after { border: none; }

/* ========== 文字 ========== */
.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text);
  margin-bottom: 20rpx;
  letter-spacing: 1rpx;
}

.text-secondary {
  color: var(--color-text-secondary);
  font-size: 24rpx;
}

.text-tertiary {
  color: var(--color-text-tertiary);
  font-size: 24rpx;
}

.text-success { color: var(--color-success); font-weight: 600; }
.text-error { color: var(--color-error); font-weight: 600; }
.text-positive { color: var(--color-success); font-weight: 700; }
.text-negative { color: var(--color-error); font-weight: 700; }

.text-lg { font-size: 36rpx; font-weight: 700; }
.text-xl { font-size: 44rpx; font-weight: 700; }
.text-xxl { font-size: 56rpx; font-weight: 700; }

/* ========== 状态标签 ========== */
.tag {
  display: inline-block;
  padding: 4rpx 16rpx;
  border-radius: 100rpx;
  font-size: 22rpx;
  font-weight: 500;
}

.tag-forming { background: #E8F0FE; color: #3B5998; }
.tag-active { background: #FFF4E6; color: #B8772E; }
.tag-ended { background: #F0F0F0; color: #8E8E93; }
.tag-cancelled { background: #FCE4E4; color: #B33A3A; }
.tag-expired { background: #F0F0F0; color: #8E8E93; }
.tag-pending { background: #FFF9E6; color: #B8772E; }
.tag-accepted { background: #E8F5E9; color: #3D6B3D; }

/* ========== 输入框 ========== */
.input {
  width: 100%;
  border: 2rpx solid var(--color-border);
  border-radius: var(--radius-md);
  padding: 24rpx;
  font-size: 30rpx;
  background: var(--color-card);
  box-sizing: border-box;
}

.input-placeholder {
  color: var(--color-text-tertiary);
}

/* ========== 空状态 ========== */
.empty-state {
  text-align: center;
  padding: 120rpx 40rpx;
  color: var(--color-text-secondary);
}

.empty-state .empty-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
}

/* ========== 加载 ========== */
.loading-text {
  text-align: center;
  color: var(--color-text-secondary);
  font-size: 24rpx;
  padding: 40rpx 0;
}

/* ========== 操作栏 ========== */
.action-bar {
  padding: 24rpx 0;
}

.action-bar button {
  margin-bottom: 16rpx;
}

.action-bar button:last-child {
  margin-bottom: 0;
}

/* ========== 头像 ========== */
.avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  overflow: hidden;
  background: var(--color-divider);
  flex-shrink: 0;
}

.avatar image {
  width: 100%;
  height: 100%;
}

.avatar-text {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 600;
  color: #FFFFFF;
  background: var(--color-accent);
  flex-shrink: 0;
}

/* ========== 列表项 ========== */
.list-item {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--color-divider);
}

.list-item:last-child {
  border-bottom: none;
}
